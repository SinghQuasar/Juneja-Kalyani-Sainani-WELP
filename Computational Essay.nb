187d43832927"]
}, Open  ]],

Cell[CellGroupData[{

Cell["metabolizeAgents[model_, params_]", "Subsection",
 CellChangeTimes->{{3.982257971877247*^9, 
  3.982257978697054*^9}},ExpressionUUID->"5ca63144-aefd-dc4f-ae1c-\
cf0afd259b0e"],

Cell["\<\
Forces all agents to lose a set amount of energy due to metabolism at each \
timestep.\
\>", "Text",
 CellChangeTimes->{{3.9822587640609226`*^9, 
  3.9822588228827114`*^9}},ExpressionUUID->"8fa45dce-c982-5d47-b26c-\
f3c44013ddf7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["ageAgents[model_, params_]", "Subsection",
 CellChangeTimes->{
  3.982258003969328*^9},ExpressionUUID->"dcd15a4a-268c-414b-aaf2-\
b354c6bf2d2f"],

Cell["\<\
Increases the age of each agent, which is important for controlling life \
cycles and removal from the simulation.\
\>", "Text",
 CellChangeTimes->{{3.982258838574049*^9, 
  3.982258889054884*^9}},ExpressionUUID->"81564369-58e8-be4f-891d-\
2e3df5e6d04b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["randomActionWalk[agent_, foods_, params_]", "Subsection",
