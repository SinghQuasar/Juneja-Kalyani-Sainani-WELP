Cell[TextData[{
 "For clarity, we added a legend to the top left of the grid to explain \
labels for the agents, energy bars, and food. It also shows the current time, \
remaining food count, and number of agents in the model. To ensure that the \
legend stays consistent for varying bounds, we anchored it relative to ",
 StyleBox["squareBounds",
  FontWeight->"Bold"],
 ". Additionally,  "
}], "Text",
 CellChangeTimes->{{3.985889297299816*^9, 3.9858892991251163`*^9}, {
  3.9858893523000927`*^9, 3.9858895907872105`*^9}, {3.9858901552914524`*^9, 
  3.985890155545559*^9}},ExpressionUUID->"82f0f6ed-c7ef-e749-91f9-\
6ddfb1967a36"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{"legendX", " ", "=", " ", 
     RowBox[{"min", " ", "+", " ", "hudPad"}]}], ";"}], "\n", "  ", 
   RowBox[{
    RowBox[{"legendY", " ", "=", " ", 
     RowBox[{"max", " ", "-", " ", "hudPad"}]}], ";"}], "\n", "\n", "  ", 
   RowBox[{
    RowBox[{"infoX", " ", "=", " ", 
     RowBox[{"max", " ", "-", " ", "hudPad"}]}], ";"}], "\n", "  ", 
   RowBox[{
    RowBox[{"infoY", " ", "=", " ", 
     RowBox[{"max", " ", "-", " ", "hudPad"}]}], ";"}], "\n", "\n", "  ", 
   RowBox[{
    RowBox[{"legend", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Text", "[", 
        RowBox[{
         RowBox[{"Style", "[", 
          
          RowBox[{"\"\<Legend\>\"", ",", " ", "11", ",", " ", "White", ",", 
           " ", "Bold"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"legendX", ",", " ", "legendY"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "]"}], ",", "\n", 
       "  ", 
       RowBox[{"EdgeForm", "[", 
        RowBox[{"Directive", "[", 
         RowBox[{"White", ",", " ", 
          RowBox[{"Thickness", "[", "0.0015", "]"}]}], "]"}], "]"}], ",", 
       RowBox[{"ageColor", "[", 
        RowBox[{"0.2", " ", 
         RowBox[{"params", "[", "\"\<lifespan\>\"", "]"}]}], "]"}], ",", 
       RowBox[{"Disk", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"legendX", " ", "+", " ", 
            RowBox[{"0.020", " ", "span"}]}], ",", " ", 
           RowBox[{"legendY", " ", "-", " ", 
            RowBox[{"0.050", " ", "span"}]}]}], "}"}], ",", " ", 
         RowBox[{
          RowBox[{"params", "[", "\"\<foodSize\>\"", "]"}], "*", "span", "*", 
          "1.3"}]}], "]"}], ",", 
       RowBox[{"Text", "[", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<Agent\>\"", ",", " ", "9", ",", " ", "White"}], "]"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"legendX", " ", "+", " ", 
            RowBox[{"0.042", " ", "span"}]}], ",", " ", 
           RowBox[{"legendY", " ", "-", " ", 
            RowBox[{"0.050", " ", "span"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", " ", "0"}], "}"}]}], "]"}], ",", "\n", 
       "\n", "    ", 
       RowBox[{"If", "[", 
        RowBox[{"showEnergyBars", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"EdgeForm", "[", 
            RowBox[{"Directive", "[", 
             RowBox[{"White", ",", " ", 
              RowBox[{"Thickness", "[", "0.0012", "]"}]}], "]"}], "]"}], ",", 
           RowBox[{"Darker", "[", 
            RowBox[{"Gray", ",", " ", "0.75"}], "]"}], ",", 
           RowBox[{"Rectangle", "[", 
            RowBox[{
             RowBox[{"{", 
