                RowBox[{"0.085", " ", "span"}]}], ",", " ", 
               RowBox[{"legendY", " ", "-", " ", 
                RowBox[{"0.0835", " ", "span"}]}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", " ", "0"}], "}"}]}], "]"}]}], "}"}], ",",
          "Nothing"}], "]"}], ",", "White", ",", 
       RowBox[{"Disk", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"legendX", " ", "+", " ", 
            RowBox[{"0.020", " ", "span"}]}], ",", " ", 
