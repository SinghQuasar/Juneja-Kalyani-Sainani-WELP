               RowBox[{"legendY", " ", "-", " ", 
                RowBox[{"0.077", " ", "span"}]}]}], "}"}]}], "]"}], ",", 
           RowBox[{"energyColor", "[", "0.75", "]"}], ",", 
           RowBox[{"Rectangle", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"legendX", ",", " ", 
               RowBox[{"legendY", " ", "-", " ", 
                RowBox[{"0.090", " ", "span"}]}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"legendX", " ", "+", " ", 
                RowBox[{"0.0525", " ", "span"}]}], ",", " ", 
               RowBox[{"legendY", " ", "-", " ", 
                RowBox[{"0.077", " ", "span"}]}]}], "}"}]}], "]"}], ",", "\n",
            "        ", 
           RowBox[{"Text", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"\"\<Energy\>\"", ",", " ", "9", ",", " ", "White"}], 
              "]"}], ",", 
