     "\"Reproduction Energy Cost (E) vs Carrying Capacity\"", 16, Bold, 
      StripOnInput -> False], TraditionalForm],
   PlotRange->{{0.9375000000000024, 4.}, {0, 93.40262945239981}},
   PlotRangeClipping->True,
