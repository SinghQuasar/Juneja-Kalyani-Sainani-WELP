 CellLabel->"In[56]:=",ExpressionUUID->"3b16fdfa-7a5e-8b4b-b775-b08865c71ab4"],

Cell[BoxData[
 TemplateBox[{
  "Blend", "argl", 
   "\"\\!\\(\\*RowBox[{\\\"Clip\\\", \\\"[\\\", \
RowBox[{FractionBox[RowBox[{\\\"3.3333333333333335`\\\", \\\" \\\", \
RowBox[{\\\"agent\\\", \\\"[\\\", \\\"\\\\\\\"age\\\\\\\"\\\", \\\"]\\\"}]}], \
RowBox[{\\\"params\\\", \\\"[\\\", \\\"\\\\\\\"lifespan\\\\\\\"\\\", \
\\\"]\\\"}]], \\\",\\\", RowBox[{\\\"{\\\", RowBox[{\\\"0\\\", \\\",\\\", \
\\\"1\\\"}], \\\"}\\\"}]}], \\\"]\\\"}]\\) should be a real number or a list \
of non-negative numbers, which has the same length as \
\\!\\(\\*RowBox[{\\\"{\\\", \
RowBox[{TemplateBox[Association[Rule[\\\"color\\\", RGBColor[0, 1, 0]]], \
\\\"RGBColorSwatchTemplate\\\"], \\\",\\\", \
