Cell["\<\
One of the most difficult yet important aspects for our project was choosing \
the correct energy bar placement. We created a function that tests possible \
positions around the agent and chooses the location that is farthest from \
other agents while staying inside the simulation bounds.\
\>", "Text",
 CellChangeTimes->{{3.988568726813635*^9, 
  3.988568790996788*^9}},ExpressionUUID->"e7e5605a-9b15-8344-a9b5-\
0946ed64605e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"barCenter", " ", "=", " ", 
        RowBox[{"chooseBarCenter", "[", 
         RowBox[{"pos", ",", " ", 
          RowBox[{"otherAgentPositions", "[", "pos", "]"}]}], "]"}]}], ";"}], 
      "\n", 
      RowBox[{
       RowBox[{"barLeft", " ", "=", " ", 
        RowBox[{
         RowBox[{"barCenter", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
         RowBox[{"barW", "/", "2"}]}]}], ";"}], "\n", 
      RowBox[{
       RowBox[{"barBottom", " ", "=", " ", 
        RowBox[{
         RowBox[{"barCenter", "[", 
          RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
         RowBox[{"barH", "/", "2"}]}]}], ";"}], "\n", "\n", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"EdgeForm", "[", 
         RowBox[{"Directive", "[", 
          RowBox[{"White", ",", " ", 
           RowBox[{"Thickness", "[", "0.0015", "]"}]}], "]"}], "]"}], ",", 
        "fillColor", ",", 
        RowBox[{"Disk", "[", 
         RowBox[{"pos", ",", " ", "agentR"}], "]"}], ",", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"ToString", "[", 
             RowBox[{"Round", "[", "age", "]"}], "]"}], ",", 
            RowBox[{"Max", "[", 
             RowBox[{"7", ",", " ", 
              RowBox[{"Round", "[", 
               RowBox[{"0.018", " ", 
                RowBox[{"params", "[", "\"\<imageSize\>\"", "]"}]}], "]"}]}], 
             "]"}], ",", "txtColor", ",", "Bold"}], "]"}], ",", "pos"}], 
         "]"}], ",", "\n", " ", 
        RowBox[{"If", "[", 
         RowBox[{"showEnergyBars", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"EdgeForm", "[", 
             RowBox[{"Directive", "[", 
              RowBox[{"White", ",", " ", 
               RowBox[{"Thickness", "[", "0.0012", "]"}]}], "]"}], "]"}], ",", 
            RowBox[{"Darker", "[", 
             RowBox[{"Gray", ",", " ", "0.75"}], "]"}], ",", 
            RowBox[{"Rectangle", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"barLeft", ",", " ", "barBottom"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"barLeft", " ", "+", " ", "barW"}], ",", " ", 
                RowBox[{"barBottom", " ", "+", " ", "barH"}]}], "}"}]}], 
             "]"}], ",", 
            RowBox[{"energyColor", "[", "frac", "]"}], ",", "\n", " ", 
            RowBox[{"Rectangle", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"barLeft", ",", " ", "barBottom"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"barLeft", " ", "+", " ", 
                 RowBox[{"barW", " ", "frac"}]}], ",", " ", 
                RowBox[{"barBottom", " ", "+", " ", "barH"}]}], "}"}]}], 
             "]"}], ",", " ", 
            RowBox[{"Text", "[", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"ToString", "[", "percent", "]"}], ",", 
                RowBox[{"Max", "[", 
                 RowBox[{"6", ",", " ", 
                  RowBox[{"Round", "[", 
                   RowBox[{"0.014", " ", 
                    RowBox[{"params", "[", "\"\<imageSize\>\"", "]"}]}], 
                   "]"}]}], "]"}], ",", "Magenta"}], "]"}], ",", 
              "barCenter"}], "]"}]}], "}"}], ",", "Nothing"}], "]"}]}], 
       "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"agent", ",", " ", "agents"}], "}"}]}], "]"}], ";"}]], "Code",
 CellChangeTimes->{{3.988568461395941*^9, 3.9885684630946255`*^9}, {
  3.988568580946764*^9, 3.9885685821871815`*^9}, {3.988568637945059*^9, 
  3.988568654365078*^9}},
 CellLabel->"In[58]:=",ExpressionUUID->"c1fd6f2b-fe3f-6b43-bf45-ee9c305d6479"],

