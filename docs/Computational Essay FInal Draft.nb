Cell[CellGroupData[{

Cell["Model Parameters", "Section",
 CellChangeTimes->{{3.9861346944682255`*^9, 3.986134699014679*^9}, {
  3.9861347846181145`*^9, 3.9861347951362133`*^9}, {3.9861366439729843`*^9, 
  3.9861366489353695`*^9}, {3.9866530520267925`*^9, 3.9866530526883984`*^9}},
 CellTags->
  "modelParams",ExpressionUUID->"7dc9621c-5827-ef4a-8786-41ddeeebf367"],

Cell[TextData[{
 "These are model parameters stored as an association that set the rules for \
a simulation, and a user may freely tweak them to model certain environmental \
scenarios or use these as independent variables to run empirical experiments. \
Most functions of the model take in this parameters ",
 StyleBox["association",
  FontWeight->"Bold"],
 " to understand how they should work and to what extent their functions \
should affect model/agent state. Comments following each parameter outlines \
its purpose. Parameters, and thus the model, is defined in ",
 StyleBox["nondimensionalized",
  FontWeight->"Bold"],
 " arbitrary units: arbitrary distance units denoted (",
 StyleBox["D",
  FontWeight->"Bold"],
 "), arbitrary time units denoted (",
 StyleBox["T",
  FontWeight->"Bold"],
 "), and arbitrary energy units denoted (",
 StyleBox["E",
  FontWeight->"Bold"],
 ") throughout."
}], "Text",
 CellChangeTimes->{
  3.986134702431364*^9, {3.9861349670242786`*^9, 3.9861350151841335`*^9}, {
   3.9866530586789455`*^9, 3.9866530630536213`*^9}, {3.9866539617015514`*^9, 
   3.9866539901637287`*^9}, {3.9866542471128273`*^9, 3.986654249513815*^9}, {
   3.9866543327970047`*^9, 3.986654545327215*^9}, {3.986654578512396*^9, 
   3.986654579597225*^9}, {3.9866546113092575`*^9, 3.9866546690151215`*^9}, {
   3.9866547079760723`*^9, 3.9866547221788425`*^9}, {3.986654994727091*^9, 
   3.986655051410116*^9}, {3.988668795851225*^9, 3.9886688178396187`*^9}, {
   3.9886690538873158`*^9, 3.988669055448925*^9}, 
   3.988753620866991*^9},ExpressionUUID->"8ff26a7a-b98b-fb49-a9f6-\
7615dc0ce169"],

Cell[BoxData[
 RowBox[{
  RowBox[{"parameters", " ", "=", " ", 
   RowBox[{"<|", "\n", "  ", 
    RowBox[{
     RowBox[{"\"\<proximityRadius\>\"", " ", "->", " ", "0.5"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{"How", " ", "close", " ", "two", " ", "things", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"agent", "/", "food"}], ",", " ", 
         RowBox[{"agent", "/", "agent"}]}], ")"}], " ", "need", " ", "to", " ",
        "be", " ", "to", " ", "interact", " ", 
       RowBox[{"(", 
        RowBox[{"eat", ",", " ", "reproduce", ",", " ", 
         RowBox[{"etc", "."}]}], ")"}]}], "*)"}], "\n", "  ", 
     RowBox[{"\"\<sensingDistance\>\"", " ", "->", " ", "4"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "How", " ", "far", " ", "away", " ", "agents", " ", "can", " ", 
        "sense", " ", "in", " ", 
        StyleBox["D",
         FontWeight->"Bold"], " ", "units"}], ",", " ", 
       RowBox[{
       "and", " ", "by", " ", "consequence", " ", "intentionally", " ", 
        "travel", " ", "to"}], ",", " ", 
       RowBox[{
       "pieces", " ", "of", " ", "food", " ", "or", " ", "other", " ", 
        "agents", " ", "like", " ", "mating", " ", "partners"}]}], "*)"}], 
     "\n", "  ", 
     RowBox[{"\"\<metabolism\>\"", " ", "->", " ", "0.05"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{"How", " ", "much", " ", "energy", " ", "in", " ", 
       StyleBox["E",
        FontWeight->"Bold"], " ", "untis", " ", "is", " ", "expended", " ", 
       "each", " ", "timestep", " ", "by", " ", "an", " ", "agent"}], "*)"}], 
     "\n", "  ", 
     RowBox[{"\"\<dt\>\"", " ", "->", " ", "0.1"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"The", " ", "timestep", " ", "in", " ", "arbitrary", " ", 
        StyleBox["T",
         FontWeight->"Bold"], " ", "units", " ", "used", " ", "in", " ", 
        "the", " ", "time"}], "-", 
       RowBox[{"discretization", " ", "of", " ", "the", " ", "simulation"}]}],
       "*)"}], "\n", "  ", 
     RowBox[{"\"\<foodEnergy\>\"", " ", "->", " ", "5.0"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
      "How", " ", "much", " ", "energy", " ", "is", " ", "gained", " ", 
       "from", " ", "one", " ", "piece", " ", "of", " ", "food", " ", "for", " ",
        "an", " ", "agent"}], "*)"}], "\n", "  ", 
     RowBox[{"\"\<foodSpawnCooldown\>\"", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{"The", " ", "cooldown", " ", "in", " ", 
       StyleBox["T",
        FontWeight->"Bold"], " ", "of", " ", "food", " ", "spawning"}], 
      "*)"}], "\n", "  ", 
     RowBox[{"\"\<nFoodSpawn\>\"", " ", "->", " ", "5"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
      "The", " ", "number", " ", "of", " ", "pieces", " ", "of", " ", "food", 
       " ", "spawned", " ", "at", " ", "random", " ", "locations", " ", 
       "every", " ", "time", " ", 
       StyleBox[Cell[
        "foodSpawnCooldown",ExpressionUUID->
         "202b5060-c689-a54f-97b2-4274e4d9bdf6"],
        FontSlant->"Italic"], " ", "passes"}], "*)"}], "\n", "  ", 
     RowBox[{"\"\<nStartingAgents\>\"", " ", "->", " ", "4"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
      "The", " ", "number", " ", "of", " ", "agents", " ", "the", " ", 
