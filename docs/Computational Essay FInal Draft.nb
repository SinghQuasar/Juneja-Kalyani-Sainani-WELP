                 RowBox[{"Max", "[", 
                  RowBox[{"6", ",", " ", 
                   RowBox[{"Round", "[", 
                    RowBox[{"0.014", " ", 
                    RowBox[{"params", "[", "\"\<imageSize\>\"", "]"}]}], 
                    "]"}]}], "]"}], ",", "\n", "            ", "Magenta"}], 
                "\n", "          ", "]"}], ",", "\n", "          ", 
               "barCenter"}], "\n", "        ", "]"}]}], "\n", "      ", 
            "}"}], ",", "\n", "      ", "Nothing"}], " ", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
             RowBox[{"if", " ", "n"}], ">", "6"}], ",", " ", 
            RowBox[{
             RowBox[{"don", "'"}], "t", " ", "create", " ", "the", " ", 
             "bars"}]}], "*)"}], "\n", "    ", "]"}]}], "\n", "  ", "}"}]}]}],
      "\n", "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", " ", "displayGrid"}], " ", "renders", " ", "the", " ", 
     "full", " ", "simulation", " ", 
     RowBox[{"(", 
      RowBox[{
      "food", ",", " ", "agents", ",", " ", "legend", ",", " ", "time", ",", 
       " ", 
       RowBox[{"agent", " ", "count"}], ",", " ", 
       RowBox[{"etc", "."}]}], ")"}]}], "\n", "  ", "-", " ", 
    RowBox[{
    "each", " ", "agent", " ", "is", " ", "drawn", " ", "by", " ", "the", " ",
      "drawAgentGraphic", " ", "method"}]}], "\n", "*)"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"displayGrid", "[", 
   RowBox[{"model_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", " ", 
   RowBox[{"(*", 
    RowBox[{
    "we", " ", "should", " ", "use", " ", "conversion", " ", "functions", " ",
      "instead", " ", "of", " ", "span", " ", 
     RowBox[{"imo", "."}]}], "*)"}], "\n", "  ", 
   RowBox[{
    RowBox[{"{", "\n", "    ", 
     RowBox[{
     "agents", ",", " ", "foods", ",", " ", "min", ",", " ", "max", ",", " ", 
      "span", ",", " ", "nAgents", ",", "\n", "    ", "hudPad", ",", " ", 
      "agentR", ",", " ", "foodR", ",", " ", "barW", ",", " ", "barH", ",", 
      " ", "barGap", ",", "\n", "    ", "showEnergyBars", ",", " ", "legendX",
       ",", " ", "legendY", ",", " ", "infoX", ",", " ", "infoY", ",", "\n", 
      "    ", "agentGraphics", ",", " ", "foodGraphics", ",", " ", "legend", ",",
       " ", "infoText"}], "\n", "  ", "}"}], ",", "\n", "\n", "  ", 
    RowBox[{
     RowBox[{"agents", " ", "=", " ", 
      RowBox[{"model", "[", "\"\<agents\>\"", "]"}]}], ";", "\n", "  ", 
     RowBox[{"foods", " ", "=", " ", 
      RowBox[{"model", "[", "\"\<foods\>\"", "]"}]}], ";", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"min", ",", " ", "max"}], "}"}], " ", "=", " ", 
      RowBox[{"params", "[", "\"\<squareBounds\>\"", "]"}]}], ";", "\n", "  ", 
     RowBox[{"span", " ", "=", " ", 
      RowBox[{"max", " ", "-", " ", "min"}]}], ";", "\n", "  ", 
     RowBox[{"nAgents", " ", "=", " ", 
      RowBox[{"Length", "[", "agents", "]"}]}], ";", "\n", "\n", "  ", 
     RowBox[{"agentR", " ", "=", " ", 
      RowBox[{"lUnitsToPixels", "[", 
       RowBox[{
        RowBox[{"params", "[", "\"\<agentSize\>\"", "]"}], ",", " ", 
        "params"}], "]"}]}], ";", "\n", "  ", 
     RowBox[{"foodR", " ", "=", " ", 
      RowBox[{"lUnitsToPixels", "[", 
       RowBox[{
        RowBox[{"params", "[", "\"\<foodSize\>\"", "]"}], ",", " ", 
        "params"}], "]"}]}], ";", "\n", "\n", "  ", 
     RowBox[{"barW", " ", "=", " ", 
      RowBox[{"0.10", " ", "span"}]}], ";", "\n", "  ", 
     RowBox[{"barH", " ", "=", " ", 
      RowBox[{"0.015", " ", "span"}]}], ";", "\n", "  ", 
     RowBox[{"barGap", " ", "=", " ", 
      RowBox[{"0.040", " ", "span"}]}], ";", "\n", "\n", "  ", 
     RowBox[{"hudPad", " ", "=", " ", 
      RowBox[{"0.001", " ", "span"}]}], ";", "\n", "\n", "  ", 
     RowBox[{"showEnergyBars", " ", "=", " ", 
      RowBox[{"nAgents", " ", "<", " ", "6"}]}], ";", "\n", "\n", "  ", 
     RowBox[{"agentGraphics", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"drawAgentGraphic", "[", 
         RowBox[{
         "#", ",", "agents", ",", "params", ",", "min", ",", "max", ",", 
          "span", ",", "agentR", ",", "barW", ",", "barH", ",", "barGap", ",",
           "showEnergyBars"}], "]"}], " ", "&"}], " ", "/@", " ", 
       "agents"}]}], ";", "\n", "\n", "  ", 
     RowBox[{"foodGraphics", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"White", ",", 
          RowBox[{"Disk", "[", 
           RowBox[{"f", ",", " ", "foodR"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"f", ",", " ", "foods"}], "}"}]}], "]"}]}], ";", "\n", "\n", 
     "  ", 
     RowBox[{"legendX", " ", "=", " ", 
      RowBox[{"min", " ", "+", " ", "hudPad"}]}], ";", "\n", "  ", 
     RowBox[{"legendY", " ", "=", " ", 
      RowBox[{"max", " ", "-", " ", "hudPad"}]}], ";", "\n", "\n", "  ", 
     RowBox[{"infoX", " ", "=", " ", 
      RowBox[{"max", " ", "-", " ", "hudPad"}]}], ";", "\n", "  ", 
     RowBox[{"infoY", " ", "=", " ", 
      RowBox[{"max", " ", "-", " ", "hudPad"}]}], ";", "\n", "\n", "  ", 
     RowBox[{"legend", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           
           RowBox[{"\"\<Legend\>\"", ",", " ", "11", ",", " ", "White", ",", 
            " ", "Bold"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"legendX", ",", " ", "legendY"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}], "]"}], ",", "\n", 
        "  ", 
        RowBox[{"EdgeForm", "[", 
         RowBox[{"Directive", "[", 
          RowBox[{"White", ",", " ", 
           RowBox[{"Thickness", "[", "0.0015", "]"}]}], "]"}], "]"}], ",", 
        RowBox[{"ageColor", "[", 
         RowBox[{
          RowBox[{"0.2", " ", 
           RowBox[{"params", "[", "\"\<lifespan\>\"", "]"}]}], ",", " ", 
          "params"}], "]"}], ",", 
        RowBox[{"Disk", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"legendX", " ", "+", " ", 
             RowBox[{"0.020", " ", "span"}]}], ",", " ", 
            RowBox[{"legendY", " ", "-", " ", 
             RowBox[{"0.050", " ", "span"}]}]}], "}"}], ",", " ", 
          RowBox[{
           RowBox[{"params", "[", "\"\<foodSize\>\"", "]"}], "*", "span", "*",
            "1.3"}]}], "]"}], ",", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<Agent\>\"", ",", " ", "9", ",", " ", "White"}], "]"}],
           ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"legendX", " ", "+", " ", 
             RowBox[{"0.042", " ", "span"}]}], ",", " ", 
            RowBox[{"legendY", " ", "-", " ", 
             RowBox[{"0.050", " ", "span"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", " ", "0"}], "}"}]}], "]"}], ",", "\n", 
        "\n", "    ", 
        RowBox[{"If", "[", 
         RowBox[{"showEnergyBars", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"EdgeForm", "[", 
             RowBox[{"Directive", "[", 
              RowBox[{"White", ",", " ", 
               RowBox[{"Thickness", "[", "0.0012", "]"}]}], "]"}], "]"}], ",", 
            RowBox[{"Darker", "[", 
             RowBox[{"Gray", ",", " ", "0.75"}], "]"}], ",", 
            RowBox[{"Rectangle", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"legendX", ",", " ", 
                RowBox[{"legendY", " ", "-", " ", 
                 RowBox[{"0.090", " ", "span"}]}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"legendX", " ", "+", " ", 
                 RowBox[{"0.070", " ", "span"}]}], ",", " ", 
                RowBox[{"legendY", " ", "-", " ", 
                 RowBox[{"0.077", " ", "span"}]}]}], "}"}]}], "]"}], ",", 
            RowBox[{"energyColor", "[", "0.75", "]"}], ",", 
            RowBox[{"Rectangle", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"legendX", ",", " ", 
                RowBox[{"legendY", " ", "-", " ", 
                 RowBox[{"0.090", " ", "span"}]}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"legendX", " ", "+", " ", 
                 RowBox[{"0.0525", " ", "span"}]}], ",", " ", 
                RowBox[{"legendY", " ", "-", " ", 
                 RowBox[{"0.077", " ", "span"}]}]}], "}"}]}], "]"}], ",", 
            "\n", "        ", 
            RowBox[{"Text", "[", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{"\"\<Energy\>\"", ",", " ", "9", ",", " ", "White"}], 
               "]"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"legendX", " ", "+", " ", 
                 RowBox[{"0.085", " ", "span"}]}], ",", " ", 
                RowBox[{"legendY", " ", "-", " ", 
                 RowBox[{"0.0835", " ", "span"}]}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "1"}], ",", " ", "0"}], "}"}]}], "]"}]}], "}"}], 
          ",", "Nothing"}], "]"}], ",", "White", ",", 
        RowBox[{"Disk", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"legendX", " ", "+", " ", 
             RowBox[{"0.020", " ", "span"}]}], ",", " ", 
            RowBox[{"legendY", " ", "-", " ", 
             RowBox[{"0.130", " ", "span"}]}]}], "}"}], ",", " ", 
          RowBox[{
           RowBox[{"params", "[", "\"\<foodSize\>\"", "]"}], "*", "span"}]}], 
         "]"}], ",", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<Food\>\"", ",", " ", "9", ",", " ", "White"}], "]"}], 
          ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"legendX", " ", "+", " ", 
             RowBox[{"0.042", " ", "span"}]}], ",", " ", 
            RowBox[{"legendY", " ", "-", " ", 
             RowBox[{"0.130", " ", "span"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", " ", "0"}], "}"}]}], "]"}]}], "}"}]}], ";",
      "\n", "\n", "  ", 
     RowBox[{"infoText", " ", "=", " ", 
      RowBox[{"Text", "[", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"Column", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\"\<Time: \>\"", " ", "<>", " ", 
               RowBox[{"ToString", " ", "@", " ", 
                RowBox[{"NumberForm", "[", 
                 RowBox[{
                  RowBox[{"model", "[", "\"\<time\>\"", "]"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"4", ",", " ", "2"}], "}"}]}], "]"}]}]}], ",", 
              RowBox[{"\"\<Food Count: \>\"", " ", "<>", " ", 
               RowBox[{"ToString", " ", "@", " ", 
                RowBox[{"Length", "[", "foods", "]"}]}]}], ",", 
              RowBox[{"\"\<Agents: \>\"", " ", "<>", " ", 
               RowBox[{"ToString", " ", "@", " ", "nAgents"}]}]}], "}"}], ",",
             "\n", "        ", 
            RowBox[{"Alignment", " ", "->", " ", "Right"}]}], "]"}], ",", 
          "11", ",", "White"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"infoX", ",", " ", "infoY"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "1"}], "}"}]}], "]"}]}], ";", "\n", "\n", 
     "  ", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "foodGraphics", ",", "agentGraphics", ",", "legend", ",", 
         "infoText"}], "}"}], ",", "\n", "    ", 
       RowBox[{"Background", " ", "->", " ", "Black"}], ",", "\n", "    ", 
       RowBox[{"PlotRange", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"min", ",", " ", "max"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"min", ",", " ", "max"}], "}"}]}], "}"}]}], ",", "\n", 
       "    ", 
       RowBox[{"PlotRangePadding", " ", "->", " ", 
        RowBox[{"Scaled", "[", "0.01", "]"}]}], ",", "\n", "    ", 
       RowBox[{"ImagePadding", " ", "->", " ", "10"}], ",", "\n", "    ", 
       RowBox[{"ImageSize", " ", "->", " ", 
        RowBox[{"params", "[", "\"\<imageSize\>\"", "]"}]}]}], "\n", "  ", 
      "]"}]}]}], "\n", "]"}], " "}]}], "Code",
 CellChangeTimes->{3.98876057346146*^9},
 CellLabel->"In[65]:=",ExpressionUUID->"d01f2fed-37ef-0849-83c2-b3433129a9d9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Visualizing the Simulation", "Section",
 CellChangeTimes->{{3.9887601997197323`*^9, 
  3.9887602034526825`*^9}},ExpressionUUID->"f1eaacb7-530f-bb49-8f15-\
76b837f515ff"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  RowBox[{"renderSimulation", "[", "]"}]], "InlineCode",ExpressionUUID->
  "b380bb3b-8284-6942-ba38-6c85c1504260"],
 " generates a list of frames using the above ",
 Cell[BoxData[
  RowBox[{"displayGrid", "[", "]"}]], "InlineCode",ExpressionUUID->
  "1baa9329-ce2f-9843-a512-721e76e26d62"],
 "function to generate each frame. The ",
 Cell[BoxData[
  RowBox[{"renderSimulation", "[", "]"}]], "InlineCode",ExpressionUUID->
  "9081a1f3-857b-474c-98e3-ac0f948e8f9e"],
 "takes in the simulation object, which itself is a list of model states, and \
applies that frame generation on each model state to produce the \
visualization."
}], "Text",
 CellChangeTimes->{{3.9887606206982327`*^9, 
  3.988760746315546*^9}},ExpressionUUID->"120439d2-21be-b54f-82d1-\
cf49c2b69313"],

Cell[BoxData[
 RowBox[{
  RowBox[{"renderSimulation", "[", 
   RowBox[{"states_List", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"displayGrid", "[", 
     RowBox[{"#", ",", " ", "params"}], "]"}], " ", "&"}], " ", "/@", " ", 
   "states"}]}]], "Code",
 CellChangeTimes->{3.988760758682295*^9},
 CellLabel->"In[72]:=",ExpressionUUID->"46b2792a-99b0-2746-b8c1-a8f8a2750dd7"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"simVisualize", "[", "]"}]], "InlineCode",ExpressionUUID->
  "805fc920-2052-724e-b5ee-587b2f60ad6b"],
 "is the main function that a user of the toolbox will use to view specific \
timesteps of the simulation. It uses Wolfram\[CloseCurlyQuote]s ",
 Cell[BoxData[
 "Manipulate"], "InlineCode",ExpressionUUID->
  "addeea38-be31-bb41-93a3-896a5aa11c46"],
 " to create a video-like interface for viewing the frames. Slowing down the \
playing of the manipulate object will allow the visualization to be viewed \
more clearly."
}], "Text",
 CellChangeTimes->{{3.9887607673363914`*^9, 3.988760801181036*^9}, {
  3.9887608580958157`*^9, 
  3.988760915200178*^9}},ExpressionUUID->"e8cf59a0-68cf-e04d-b43c-\
15fd3762f227"],

Cell[BoxData[
 RowBox[{
  RowBox[{"simVisualize", "[", 
   RowBox[{"simulation_", ",", " ", "params_", ",", " ", 
    RowBox[{"timestepStart_", ":", "1"}], ",", " ", 
    RowBox[{"timestepEnd_", ":", 
     RowBox[{"Length", "@", "simulation_"}]}]}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "simulationGraphics", "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"simulationGraphics", " ", "=", " ", 
      RowBox[{"renderSimulation", "[", 
       RowBox[{
        RowBox[{"simulation", "[", 
         RowBox[{"[", 
          RowBox[{"timestepStart", ";;", "timestepEnd"}], "]"}], "]"}], ",", 
        " ", "params"}], "]"}]}], ";", "\n", "\t", 
     RowBox[{"Manipulate", "[", 
      RowBox[{
       RowBox[{"simulationGraphics", "[", 
        RowBox[{"[", "visualizeTimestep", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"visualizeTimestep", ",", " ", "1", ",", " ", 
         RowBox[{"Length", "@", "simulationGraphics"}], ",", " ", "1", ",", 
         " ", 
         RowBox[{"Appearance", "->", "Labeled"}]}], "}"}]}], "]"}]}]}], "\n", 
   "]"}]}]], "Code",
 CellChangeTimes->{3.9887609271274414`*^9},
 CellLabel->"In[73]:=",ExpressionUUID->"17926c59-1807-bc4d-b463-b8540d8f7fda"],

Cell[TextData[{
 "Frame generation is one of the more computationally intensive processes in \
our toolbox, which is why it\[CloseCurlyQuote]s done separately from \
simulation generation. It\[CloseCurlyQuote]s still a necessary tool to see \
what\[CloseCurlyQuote]s going on with the artificial organisms and how they \
interact with each other and their environment. Let\[CloseCurlyQuote]s call ",
 Cell[BoxData[
  RowBox[{"simVisualize", "[", "]"}]], "InlineCode",ExpressionUUID->
  "8bf8a85f-e1f5-2b46-90c5-0973ef95220d"],
 "on our simulation stored in the ",
 Cell[BoxData[
 "Simulation1000"], "InlineCode",ExpressionUUID->
  "0c862d7e-d618-6a49-b623-76e6288c1026"],
 " symbol. Specifically, let\[CloseCurlyQuote]s visualize timesteps 1 - 400 \
to see what the population looks like in its rapid growth stages, and \
timesteps 700 - 900 to see what it looks like when it\[CloseCurlyQuote]s \
reached its equilibrium carrying capacity. "
}], "Text",
 CellChangeTimes->{{3.9887609393783913`*^9, 
  3.988761271464857*^9}},ExpressionUUID->"0a0c6a8f-cefe-9b40-bcdb-\
176a7828ce55"],

