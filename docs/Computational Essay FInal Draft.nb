Cell[TextData[{
 "The ",
 Cell[BoxData[
  RowBox[{"logisticStats", "[", "]"}]], "InlineCode",ExpressionUUID->
  "e4df256c-db28-f645-8c2e-36c02a395660"],
 "function allows for extraction of ",
 StyleBox["K",
  FontSlant->"Italic"],
 ", ",
 StyleBox["A",
  FontSlant->"Italic"],
 ", and ",
 StyleBox["r",
  FontSlant->"Italic"],
 ". It is as below, and calling it on our simulation gives us the carrying \
capacity ",
 StyleBox["K",
  FontSlant->"Italic"],
 " and intrinsic growth rate ",
 StyleBox["r",
  FontSlant->"Italic"],
 " of the artificial colony in the environment modeled under the ",
 Cell[BoxData[
 "parameters"], "InlineCode",ExpressionUUID->
  "27cc721d-b369-6446-9560-2085953659b0"],
 " of this essay undergoing 1000 timesteps of forward simulation."
}], "Text",
 CellChangeTimes->{{3.988759586275406*^9, 
  3.988759678291237*^9}},ExpressionUUID->"fed2b0f1-db10-b045-8864-\
3cdf31b5ee43"],

Cell[BoxData[
 RowBox[{
  RowBox[{"logisticStats", "[", "simulation_", "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "agentCounts", ",", " ", "times", ",", " ", "series", ",", " ", "fit"}], 
     "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"agentCounts", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "@", 
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "&"}], " ", "/@", " ", 
       "simulation"}]}], ";", "\n", "\t", 
     RowBox[{"times", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "4", "]"}], "]"}], "&"}], " ", "/@", " ", 
       "simulation"}]}], ";", "\n", "\t", 
     RowBox[{"series", " ", "=", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"times", ",", " ", "agentCounts"}], "}"}], "]"}]}], ";", "\n",
      "\t", "\n", "\t", 
     RowBox[{"fit", " ", "=", " ", 
      RowBox[{"NonlinearModelFit", "[", "\n", "\t    ", 
       RowBox[{"series", ",", "\n", "\t    ", 
        RowBox[{"K", "/", 
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", 
           RowBox[{"A", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "r"}], " ", "t"}], "]"}]}]}], ")"}]}], ",", "\n", 
        "\t    ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"K", ",", " ", "35"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"A", ",", " ", "10"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "1"}], "}"}]}], "}"}], ",", "\n", "\t    ", 
        "t"}], "]"}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"Association", "@", 
      RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}]}]}]}], "\n", 
   "]"}]}]], "Code",
 CellChangeTimes->{3.9887596950603695`*^9},
 CellLabel->"In[31]:=",ExpressionUUID->"9d55fdef-30db-fe4c-acc2-1e0a4e13fb67"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"logisticStats", "[", "Simulation1000", "]"}]], "Code",
 CellChangeTimes->{{3.9887597057122135`*^9, 3.9887597110189495`*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"105ccf62-180b-cd44-abbe-74602c12481c"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"K", "\[Rule]", "47.81344076428018`"}], ",", 
   RowBox[{"A", "\[Rule]", "40.88258159408743`"}], ",", 
   RowBox[{"r", "\[Rule]", "0.19364014058156492`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.9887597147676105`*^9, 3.9887638652866344`*^9},
 CellLabel->"Out[32]=",ExpressionUUID->"a15cfee0-01be-974b-b585-4d24d75aaa8b"]
}, Open  ]],

Cell[TextData[{
 "Another type of analysis our toolbox allows one to do is look at population \
demographic distributions like the agents by their age at first reproduction, \
which is very useful to see how quickly agents are able to find mates once \
they reach reproductive maturity (set by the parameter ",
 Cell[BoxData[
  StyleBox["minReproductionAge",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "f98a803d-331c-4848-b100-2bf623dcc928"],
 "), which is essential for species survival. This can be influenced \
negatively by sparsity of agents or competition when the population is near \
carrying capacity. Below is an example of such analysis on a simulation run \
with the exact same ",
 Cell[BoxData[
 "parameters"], "InlineCode",ExpressionUUID->
  "6d5ecaaa-9b80-624f-b8f1-27fa2d351c7f"],
 " as here over 2000 timesteps."
}], "Text",
 CellChangeTimes->{{3.988759926767746*^9, 3.988760060415642*^9}, {
  3.9887601725165577`*^9, 
  3.98876017589085*^9}},ExpressionUUID->"c44e1e99-f307-b643-897e-\
8d5979a3035c"],

