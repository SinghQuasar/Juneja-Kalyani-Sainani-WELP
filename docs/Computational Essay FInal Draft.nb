Cell[CellGroupData[{

Cell["Data Structures", "Subsection",
 CellChangeTimes->{{3.9866593264565487`*^9, 3.9866593293098545`*^9}},
 CellTags->
  "dataStructures",ExpressionUUID->"5037cdbf-fa39-404f-a28d-e7ae96a5edb6"],

Cell[TextData[{
 "Before the rest of the toolbox was built, the core aspects of the model \
like agents that moved and consumed food were built first. The food in a \
model at any time is represented by a ",
 StyleBox["list",
  FontWeight->"Bold"],
 " of positions of pieces of food. For the data structure of the model as a \
whole, see ",
 StyleBox[ButtonBox["Model Initialization",
  BaseStyle->"Hyperlink",
  ButtonData->"modelInitialization"],
  FontColor->RGBColor[
   0.792156862745098, 0.3176470588235294, 0.09803921568627451]],
 ".\n\n",
 Cell[BoxData[
  RowBox[{"createAgent", "[", "]"}]], "InlineCode",ExpressionUUID->
  "9bec44cb-c7ce-8d46-917e-f47b1f34c406"],
 "is used to initialize agent associations. The data structure for agents was \
chosen to be an association so that specific attributes of agents that \
describe their state can be accessed through keys. Each agent attribute is \
commented with a description of its nature"
}], "Text",
 CellChangeTimes->{
  3.986656472112711*^9, {3.9866568045186176`*^9, 3.98665681395512*^9}, {
   3.986657530107088*^9, 3.9866575455782146`*^9}, {3.9866590179394264`*^9, 
   3.98665902418865*^9}, {3.9866591163259716`*^9, 3.9866591324223576`*^9}, {
   3.9866593123730545`*^9, 3.9866593166233063`*^9}, {3.986659369824898*^9, 
   3.9866593993556957`*^9}, {3.988669909998169*^9, 3.9886699729959183`*^9}, {
   3.988670009865801*^9, 3.9886700902819977`*^9}, {3.9886701323339214`*^9, 
   3.9886701398959846`*^9}, 3.9887509212400036`*^9},
 CellTags->
  "createAgent[]",ExpressionUUID->"10a084c6-a688-6540-a79c-10fafe41d5fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"createAgent", "[", 
   RowBox[{
   "pos_", ",", " ", "energy_", ",", " ", "age_", ",", " ", "id_", ",", " ", 
    "currentDirection_", ",", " ", 
    RowBox[{"parents_", ":", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"-", "1"}]}], "}"}]}], ",", " ", "reproductionCooldown_"}], 
   "]"}], " ", ":=", " ", 
  RowBox[{"<|", "\n", "    ", 
   RowBox[{
    RowBox[{"\"\<pos\>\"", " ", "->", " ", "pos"}], ",", " ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
      "The", " ", "current", " ", "position", " ", "of", " ", "an", " ", 
       "agent", " ", "in", " ", "the", " ", "environment"}], ",", " ", 
      RowBox[{"length", " ", "2", " ", "array"}]}], "*)"}], "\n", "    ", 
    RowBox[{"\"\<energy\>\"", " ", "->", " ", "energy"}], ",", " ", 
    RowBox[{"(*", 
     RowBox[{
     "The", " ", "current", " ", "energy", " ", "of", " ", "an", " ", 
      "agent"}], "*)"}], "\n", "    ", 
    RowBox[{"\"\<age\>\"", " ", "->", " ", "age"}], ",", " ", 
    RowBox[{"(*", 
     RowBox[{
     "The", " ", "current", " ", "age", " ", "of", " ", "an", " ", "agent"}], 
     "*)"}], "\n", "\t", 
    RowBox[{"\"\<id\>\"", " ", "->", " ", "id"}], ",", " ", 
    RowBox[{"(*", 
     RowBox[{
     "A", " ", "unique", " ", "identifer", " ", "given", " ", "to", " ", 
      "each", " ", "agent", " ", "created", " ", "throughout", " ", "the", " ",
       "history", " ", "of", " ", "the", " ", "simulation", " ", "instance"}],
      "*)"}], "\n", "\t", 
    RowBox[{"\"\<currentDirection\>\"", " ", "->", " ", "currentDirection"}], 
    ",", " ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{
       "The", " ", "current", " ", "direction", " ", "the", " ", "agent", " ",
         "is", " ", "exploring", " ", "in", " ", "or", " ", "seeking", " ", 
        RowBox[{"food", "/", "mates"}], " ", "in"}], ";", " ", 
       RowBox[{"value", " ", 
        RowBox[{"from", " ", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"2", "pi"}]}]}]}]}], ")"}], "*)"}], "\n", "\t", 
    RowBox[{"\"\<parents\>\"", " ", "->", " ", "parents"}], ",", " ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"The", " ", "ids", " ", "of", " ", "the", " ", 
       RowBox[{"agent", "'"}], "s", " ", "parents", " ", "in", " ", "a", " ", 
       "length", " ", "2", " ", 
       RowBox[{"array", ".", " ", "If"}], " ", "the", " ", "agent", " ", "is",
        " ", "one", " ", "of", " ", "the", " ", "primordial", " ", "starting",
        " ", "agents"}], ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], " ", "is", " ", "given", " ", "to", " ",
        "this", " ", 
       RowBox[{"value", ".", "\n", "\t", "used"}], " ", "to", " ", 
       "determine", " ", "familial", " ", "relations", " ", "for", " ", "the",
        " ", "purpose", " ", "of", " ", "incest", " ", 
       RowBox[{"prevention", "--"}], "a", " ", "parent", " ", "will", " ", 
       "naturally", " ", "not", " ", "reproduce", " ", "with", " ", "their", " ",
        "child", " ", "throughout", " ", "almost", " ", "all", " ", 
       "species"}]}], "*)"}], "\n", "    ", 
    RowBox[{"\"\<reproductionCooldown\>\"", " ", "->", " ", 
     "reproductionCooldown"}]}], "\n", "|>"}]}]], "Code",
 CellChangeTimes->{
  3.986656699328575*^9, {3.9866568535934486`*^9, 3.9866569508927803`*^9}, {
   3.9866570394348106`*^9, 3.9866570581597443`*^9}, {3.9886701758241463`*^9, 
   3.9886702754201374`*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"142145c4-95bc-4c4d-b9f0-ab021346b21d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Core Functions", "Subsection",
 CellChangeTimes->{{3.98665934884626*^9, 3.9866593542909927`*^9}},
 CellTags->
  "coreFunctions",ExpressionUUID->"eba76386-d2a1-ca45-b667-e9cf93b946a3"],

Cell["\<\
These functions are the basic operations needed for core model functionality.\
\>", "Text",
 CellChangeTimes->{{3.986659374898609*^9, 
  3.986659389762089*^9}},ExpressionUUID->"668d9dab-c40a-fe4c-af9b-\
84ddd727ec21"],

Cell[TextData[{
 "For any interactions to occur, an object must be within another\
\[CloseCurlyQuote]s ",
 Cell[BoxData[
  StyleBox["proximityRadius",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "4c35badf-89b7-4b40-8235-afce86df8b1f"],
 ".  This goes for an agent and a piece of food, an agent and another agent \
for reproduction."
}], "Text",
 CellChangeTimes->{{3.986133935459646*^9, 3.986134001026058*^9}, {
   3.986134128371048*^9, 3.9861341682006283`*^9}, {3.9861342216344566`*^9, 
   3.986134225347433*^9}, {3.9861354205280743`*^9, 3.986135502323677*^9}, {
   3.9861355479464245`*^9, 3.9861355974950294`*^9}, {3.9866530312050304`*^9, 
   3.9866530321828423`*^9}, {3.986653282381628*^9, 3.9866532827050743`*^9}, {
   3.9866533505385036`*^9, 3.986653351202915*^9}, {3.986654009608753*^9, 
   3.986654026521841*^9}, {3.9866562304426804`*^9, 3.9866562592874737`*^9}, {
   3.9866564609462414`*^9, 3.9866564678113003`*^9}, 3.9866565595560265`*^9, {
   3.988670288114067*^9, 
   3.9886702882436695`*^9}},ExpressionUUID->"43f7f145-fa31-224c-a685-\
bceff4b4876e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"checkWithinRadius", "[", 
    RowBox[{"p1_", ",", " ", "p2_", ",", " ", "r_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"EuclideanDistance", "[", 
     RowBox[{"p1", ",", " ", "p2"}], "]"}], " ", "<=", " ", "r"}]}], 
  ";"}]], "Code",
 CellChangeTimes->{3.986135602936306*^9},
 CellLabel->"In[3]:=",ExpressionUUID->"f149d8ae-5cdf-7148-be2a-169ee1c31973"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"EuclidianDistance", "[", "]"}]], "InlineCode",ExpressionUUID->
  "2e435b62-7914-a948-a308-871259042531"],
 " is used in the ",
 Cell[BoxData[
  RowBox[{"checkWithinRadius", "[", "]"}]], "InlineCode",ExpressionUUID->
  "8ad64ce0-b9c4-7f48-b3fa-a4913eba8e38"],
 " function to verify the interaction condition of ",
 Cell[BoxData[
  StyleBox["proximityRadius",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "41c5c3c1-b01d-6a4f-b9b5-ad4c2bd0b441"],
 " throughout simulation."
}], "CodeText",
 CellChangeTimes->{{3.9866533764217987`*^9, 3.986653378633711*^9}, {
  3.986653458920767*^9, 3.986653458991089*^9}, {3.9866540988145695`*^9, 
  3.986654101054394*^9}, {3.986656200421219*^9, 3.9866562061620903`*^9}, {
  3.9866565670399513`*^9, 3.9866565803603783`*^9}, {3.9866567216833496`*^9, 
  3.9866567386902485`*^9}, {3.9866591896920757`*^9, 3.9866591931780586`*^9}, {
  3.9886702943350105`*^9, 
  3.988670296926489*^9}},ExpressionUUID->"7de17ded-2970-d14b-ba66-\
538e4eceb407"],

Cell[TextData[{
 "A function called ",
 Cell[BoxData[
  RowBox[{"findNearestSensableFoodInfo", "[", "]"}]], "InlineCode",
  ExpressionUUID->"c26d71fb-578d-c343-93fd-7b06faa7d216"],
 " is used to find the nearest sensable (within ",
 Cell[BoxData[
  StyleBox["sensingDistance",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "acb4512a-f37a-f045-8ca7-fed83c9bc9ab"],
 ") food to an agent so agents can seek and eat food. It returns this nearest \
sensable food\[CloseCurlyQuote]s distance, index in the food list, and \
position."
}], "Text",
 CellChangeTimes->{{3.986656981652298*^9, 3.9866569925472775`*^9}, {
  3.9866570832146893`*^9, 3.9866571921746902`*^9}, {3.9866609992974873`*^9, 
  3.986661000226021*^9}, {3.9866660723018055`*^9, 3.9866661001094913`*^9}, {
  3.9886703093240376`*^9, 
  3.988670365683964*^9}},ExpressionUUID->"6c4fc9dc-af10-314e-8f11-\
3220d91f0c2b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"findNearestSensableFoodInfo", "[", 
   RowBox[{"agent_", ",", " ", "foodPositions_List", ",", " ", "params_"}], 
   "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "agentPos", ",", " ", "foodPosAndI", ",", " ", 
      "foodsWithinRadiusPosAndI", ",", " ", "dists"}], "}"}], ",", "\n", 
    "    ", 
    RowBox[{
     RowBox[{"agentPos", " ", "=", " ", 
      RowBox[{"agent", "[", "\"\<pos\>\"", "]"}]}], ";", "\n", "    ", 
     RowBox[{"foodPosAndI", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"foodPositions", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", " ", "i"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", 
          RowBox[{"Length", "[", "foodPositions", "]"}]}], "}"}]}], "]"}]}], ";",
      "\n", "    ", 
     RowBox[{"foodsWithinRadiusPosAndI", " ", "=", " ", 
      RowBox[{"Select", "[", 
       RowBox[{"foodPosAndI", ",", " ", 
        RowBox[{
         RowBox[{"checkWithinRadius", "[", 
          RowBox[{"agentPos", ",", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
           RowBox[{"params", "[", "\"\<sensingDistance\>\"", "]"}]}], "]"}], 
         "&"}]}], "]"}]}], ";", "\n", "    ", 
     RowBox[{"If", "[", "\n", "        ", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "foodsWithinRadiusPosAndI", "]"}], " ", "==", 
        " ", "0"}], ",", "\n", "        ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], ",", " ", 
       RowBox[{"(*", 
        RowBox[{"no", " ", "food"}], "*)"}], "\n", "        ", 
       RowBox[{
        RowBox[{"dists", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"EuclideanDistance", "[", 
              RowBox[{"agentPos", ",", " ", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", " ", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "}"}], "&"}], " ", "/@", " ", 
          "foodsWithinRadiusPosAndI"}]}], ";", "\n", "        ", 
        RowBox[{"First", "@", 
         RowBox[{"MinimalBy", "[", 
          RowBox[{"dists", ",", " ", "First"}], "]"}]}]}]}], "\n", "    ", 
      "]"}]}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{3.9866572058419514`*^9, 3.988670306133047*^9},
 CellTags->"findNearestSensableFoodInfo",
 CellLabel->"In[4]:=",ExpressionUUID->"9b0353ea-2fcd-e94e-ac8f-ae6f1b0f96a2"],

Cell["\<\
The function first compiles the food positions and indexes, and then isolates \
the ones that are within sensing distance of the agent. If no pieces of food \
make it into that isolation, then there are none within sensing distance and \
{-1, -1, -1} is returned. Else, the closest food\[CloseCurlyQuote]s \
{distance, index in the food list, position in the environment} is returned.\
\>", "CodeText",
 CellChangeTimes->{{3.986657227761652*^9, 3.9866573235387726`*^9}, {
   3.986658968132265*^9, 3.986658969049103*^9}, {3.988670374549324*^9, 
   3.9886704044954014`*^9}, 
   3.988749489049614*^9},ExpressionUUID->"59887e7b-4161-cb4b-8ec4-\
ed0b0cc93345"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"spawnFoods", "[", "]"}]], "InlineCode",ExpressionUUID->
  "5b8f6ce0-a803-c64e-8e7f-6a47894e66da"],
 "takes in a food list and adds new foods with the amount corresponding to \
the ",
 Cell[BoxData[
  StyleBox["nFoodSpawn",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "290b8198-2f19-1744-9535-dc8eccfddd6c"],
 " parameter. Rounding is used to prevent excess precision which increases \
the memory needed to save a simulation to a file (17.988838327 takes up more \
space then 17.989 in a .csv file)."
}], "Text",
 CellChangeTimes->{{3.986657355570282*^9, 3.9866573918809643`*^9}, {
   3.986657471074499*^9, 3.986657524449877*^9}, {3.986658977664772*^9, 
   3.986658996021229*^9}, {3.9866591637581673`*^9, 3.9866591714669056`*^9}, 
   3.986660102583685*^9, {3.9886706233143883`*^9, 3.9886706358847504`*^9}, {
   3.9886713478899517`*^9, 
   3.988671348707386*^9}},ExpressionUUID->"89540473-02b0-2a40-a141-\
d55c082daf0c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"spawnFoods", "[", 
   RowBox[{"foods_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Join", "[", 
   RowBox[{"foods", ",", " ", 
    RowBox[{"Round", "[", 
     RowBox[{
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"params", "[", "\"\<squareBounds\>\"", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"params", "[", "\"\<nFoodSpawn\>\"", "]"}], ",", " ", "2"}],
          "}"}]}], "]"}], ",", " ", 
      RowBox[{"params", "[", "\"\<rnd\>\"", "]"}]}], "]"}]}], "]"}]}]], "Code",
 CellChangeTimes->{3.9866592357492294`*^9, 3.9886704170456715`*^9},
 CellLabel->"In[5]:=",ExpressionUUID->"8327f009-68e5-7d40-82c1-d38081b5b327"],

Cell[TextData[{
 "To spawn food at the appropriate time, ",
 Cell[BoxData[
  RowBox[{"spawnFoodCheck", "[", "]"}]], "InlineCode",ExpressionUUID->
  "a2dd5c23-6d7d-ef49-81f6-5b54a14c253f"],
 " updates the model\[CloseCurlyQuote]s food list with a ",
 Cell[BoxData[
  RowBox[{"spawnFoods", "[", "]"}]], "InlineCode",ExpressionUUID->
  "8538a2ff-c2d6-e04c-b20b-1b84159e432b"],
 "operation when appropriate according to the ",
 Cell[BoxData[
  StyleBox["foodSpawnCooldown",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "02fd4138-df10-424d-86e7-4e860da4398e"],
 " parameter. "
}], "Text",
 CellChangeTimes->{{3.986659291647358*^9, 3.9866593004645767`*^9}, {
  3.986659464851038*^9, 3.9866594941026287`*^9}, {3.986659527640812*^9, 
  3.9866595341682415`*^9}, {3.986659564969391*^9, 3.986659583143572*^9}, {
  3.9886704355120163`*^9, 3.9886704457369537`*^9}, {3.9886705306597958`*^9, 
  3.988670621603668*^9}},ExpressionUUID->"42b7b78c-0cea-2148-9274-\
24f62c0d8a1f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"spawnFoodCheck", "[", 
   RowBox[{"model_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"model2", " ", "=", " ", "model"}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"model2", "[", "\"\<foods\>\"", "]"}], " ", "=", " ", 
      RowBox[{"If", "[", "\n", "        ", 
       RowBox[{
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"model", "[", "\"\<time\>\"", "]"}], ",", " ", 
           RowBox[{"params", "[", "\"\<foodSpawnCooldown\>\"", "]"}]}], "]"}],
          " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}]}]}], ",", "\n", "        ", 
        RowBox[{"spawnFoods", "[", 
         RowBox[{
          RowBox[{"model", "[", "\"\<foods\>\"", "]"}], ",", " ", "params"}], 
         "]"}], ",", "\n", "        ", 
        RowBox[{"model", "[", "\"\<foods\>\"", "]"}]}], "\n", "    ", "]"}]}],
      ";", "\n", "\t", "model2"}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{3.986659605352833*^9, 3.9886706460345*^9},
 CellLabel->"In[6]:=",ExpressionUUID->"fe82a479-5b2e-cf4e-94dc-56936b503ac1"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"<", " ", 
   RowBox[{"10", "^", 
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}]}]}]], "InlineCode",ExpressionUUID->
  "18ec7a0a-b2c0-1b48-90e7-95b986b2013f"],
 " is used instead of ",
 Cell[BoxData[
  RowBox[{"==", " ", "0"}]], "InlineCode",ExpressionUUID->
  "12b03e82-4262-ab49-8fa1-7d149eafbef7"],
 " to not have to worry about integer vs. float mismatch issues. 0 should \
work in theory but did not. This solution is sloppy and is bad programming \
practice; it should be considered a temporary band-aid."
}], "CodeText",
 CellChangeTimes->{{3.9866596208732586`*^9, 3.9866596853484936`*^9}, 
   3.9866600985061626`*^9, {3.9886706518130455`*^9, 
   3.988670701880499*^9}},ExpressionUUID->"3a200fe4-e467-2447-87a1-\
f2fc971c2b61"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"randomizeAndKill", "[", "]"}]], "InlineCode",ExpressionUUID->
  "31427485-1ca6-dd4d-8c18-41a90b08620e"],
 " is a simulation management function that kills agents if they\
\[CloseCurlyQuote]ve reached any death conditions and randomizes their order \
by virtue of shuffling the agent list so that no agents are consistently \
prioritized over others during iteration in case two or more agents are near \
the same piece of food or both trying to reproduce with the same agent--the \
operation will be done on whichever comes first, but it is truly random so \
long as the order gets randomized during every timestep."
}], "Text",
 CellChangeTimes->{{3.986659691210705*^9, 
  3.9866598164837513`*^9}},ExpressionUUID->"cae9aa88-1b00-fa4f-b037-\
c556e6d8088e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"randomizeAndKill", "[", 
   RowBox[{"model_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"agents", " ", "=", " ", 
       RowBox[{"model", "[", "\"\<agents\>\"", "]"}]}], ",", " ", 
      RowBox[{"model2", "=", "model"}]}], "}"}], ",", "\t", "\n", "\t", 
    RowBox[{
     RowBox[{"agents", " ", "=", " ", 
      RowBox[{"RandomSample", "[", "agents", "]"}]}], ";", "\n", "\t", 
     RowBox[{
      RowBox[{"model2", "[", "\"\<agents\>\"", "]"}], " ", "=", " ", 
      RowBox[{"Select", "[", 
       RowBox[{"agents", ",", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", "\"\<age\>\"", "]"}], " ", "<", " ", 
            RowBox[{"params", "[", "\"\<lifespan\>\"", "]"}]}], " ", "&&", 
           " ", 
           RowBox[{
            RowBox[{"#", "[", "\"\<energy\>\"", "]"}], " ", ">", " ", "0"}]}],
           ")"}], "&"}]}], "]"}]}], ";", "\n", "\t", "model2"}]}], "\n", 
   "]"}]}]], "Code",
 CellChangeTimes->{3.986659840460924*^9},
 CellLabel->"In[7]:=",ExpressionUUID->"2d2f1246-f031-9b44-9473-ef6457a1fe3e"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"metabolizeAgents", "[", "]"}]], "InlineCode",ExpressionUUID->
  "cf25b4cd-aa31-e747-a44c-a51af2c40f48"],
 "applies the metabolism operation to all agents for a timestep."
}], "Text",
 CellChangeTimes->{{3.9866599745356274`*^9, 3.9866600084836063`*^9}, 
   3.9866600958456745`*^9},ExpressionUUID->"518f1f10-c2df-4c45-837c-\
e2fea5fdd8e8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"metabolizeAgents", "[", 
   RowBox[{"model_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"agents", " ", "=", " ", 
       RowBox[{"model", "[", "\"\<agents\>\"", "]"}]}], ",", " ", 
      RowBox[{"model2", "=", "model"}]}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"agents", " ", "=", " ", 
      RowBox[{"MapAt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", " ", "-", " ", 
           RowBox[{"params", "[", "\"\<metabolism\>\"", "]"}]}], ")"}], "&"}],
         ",", " ", "agents", ",", " ", 
        RowBox[{"{", 
         RowBox[{"All", ",", " ", "\"\<energy\>\""}], "}"}]}], "]"}]}], ";", 
     "\n", "\t", 
     RowBox[{
      RowBox[{"model2", "[", "\"\<agents\>\"", "]"}], " ", "=", " ", 
      "agents"}], ";", "\n", "\t", "model2"}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{3.9866600228204327`*^9},
 CellLabel->"In[8]:=",ExpressionUUID->"0ff1e7bd-ec35-f246-a77a-484b3c84cae8"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"ageAgents", "[", "]"}]], "InlineCode",ExpressionUUID->
  "105e81d3-ee85-c94e-b96e-b63c5c1e12da"],
 "ages agents by one timestep ",
 Cell[BoxData[
  StyleBox["dt",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "bf8ecfb2-f05a-2b41-82d5-9e6727bb7127"],
 " during a timestep."
}], "Text",
 CellChangeTimes->{{3.986660071177496*^9, 
  3.9866600914102154`*^9}},ExpressionUUID->"4cf886e9-e753-b54e-81a7-\
ec23aee80a2a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ageAgents", "[", 
   RowBox[{"model_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"agents", " ", "=", " ", 
       RowBox[{"model", "[", "\"\<agents\>\"", "]"}]}], ",", " ", 
      RowBox[{"model2", "=", "model"}]}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"agents", " ", "=", " ", 
      RowBox[{"MapAt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", " ", "+", " ", 
           RowBox[{"params", "[", "\"\<dt\>\"", "]"}]}], ")"}], "&"}], ",", 
        " ", "agents", ",", " ", 
        RowBox[{"{", 
         RowBox[{"All", ",", " ", "\"\<age\>\""}], "}"}]}], "]"}]}], ";", 
     "\n", "\t", 
     RowBox[{
      RowBox[{"model2", "[", "\"\<agents\>\"", "]"}], " ", "=", " ", 
      "agents"}], ";", "\n", "\t", "model2"}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{3.986660122873667*^9},
 CellLabel->"In[9]:=",ExpressionUUID->"3b84131d-3e5b-334b-a411-0b23e9990342"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"explorationOrIntentionalWalk", "[", "]"}]], "InlineCode",
  ExpressionUUID->"72a28794-f1ce-1247-a82a-676235d0ceb4"],
 " is the function that makes an agent walk in the current direction it\
\[CloseCurlyQuote]s moving in. This current direction depends on the sensory \
input an agent receives from its environment, and this heading is determined \
in the ",
 Cell[BoxData[
  ButtonBox[
   RowBox[{"agentActions", "[", "]"}],
   BaseStyle->"Hyperlink",
   ButtonData->"agentActions[]"]], "InlineCode",ExpressionUUID->
  "024c85ce-b6d4-9e4b-a3a4-e88ad74168e2"],
 "function in ",
 StyleBox[ButtonBox["Agent Rules and Behavior",
  BaseStyle->"Hyperlink",
  ButtonData->"agentRulesandBehavior"],
  FontColor->RGBColor[
   0.792156862745098, 0.3176470588235294, 0.09803921568627451]],
 "."
}], "Text",
 CellChangeTimes->{{3.9866601406207695`*^9, 3.986660196467783*^9}, {
  3.9886714391601086`*^9, 3.9886715175715218`*^9}, {3.9886716441806107`*^9, 
  3.9886717247194557`*^9}, {3.9887486294007587`*^9, 3.988748634939972*^9}, {
  3.98874868358395*^9, 
  3.98874868358395*^9}},ExpressionUUID->"825ae4ac-38c3-8b46-8157-\
9a769de85987"],

Cell[BoxData[
 RowBox[{
  RowBox[{"explorationOrIntentionalWalk", "[", 
   RowBox[{"agent_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"direction", " ", "is", " ", "set", " ", "in", " ", 
      RowBox[{"agentActions", "[", "]"}]}], ",", " ", 
     RowBox[{
     "depending", " ", "on", " ", "exploration", " ", "or", " ", 
      "intentional"}]}], "*)"}], "\n", "\t", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"agent2", " ", "=", " ", "agent"}], ",", " ", 
      RowBox[{"currentDir", " ", "=", " ", 
       RowBox[{"agent", "[", "\"\<currentDirection\>\"", "]"}]}], ",", " ", 
      "newPos", ",", " ", "min", ",", " ", "max"}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"min", ",", " ", "max"}], "}"}], " ", "=", " ", 
      RowBox[{"params", "[", "\"\<squareBounds\>\"", "]"}]}], ";", "\n", "\t", 
     RowBox[{"newPos", " ", "=", " ", 
      RowBox[{
       RowBox[{"agent2", "[", "\"\<pos\>\"", "]"}], " ", "+", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"params", "[", "\"\<stepLength\>\"", "]"}], " ", "*", " ", 
          RowBox[{"currentDir", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
         RowBox[{
          RowBox[{"params", "[", "\"\<stepLength\>\"", "]"}], " ", "*", " ", 
          RowBox[{"currentDir", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}]}], ";", "\n", "\t", 
     RowBox[{
      RowBox[{"agent2", "[", "\"\<pos\>\"", "]"}], " ", "=", " ", 
      RowBox[{"Clip", "[", 
       RowBox[{"newPos", ",", " ", 
        RowBox[{"{", 
         RowBox[{"min", ",", " ", "max"}], "}"}]}], "]"}]}], ";", "\n", "\t", 
     "agent2"}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{
  3.9886713400564175`*^9, {3.9886714283229294`*^9, 3.9886714284477577`*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"7edebfa1-10d4-af4e-ab5e-ed089515946e"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"agentEat", "[", "]"}]], "InlineCode",ExpressionUUID->
  "ca102650-6402-7749-bdc9-77e0aacd5618"],
 "is used to update agents\[CloseCurlyQuote] energy when they eat a piece of \
food according to the ",
 Cell[BoxData[
  StyleBox["foodEnergy",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "da945908-d151-7346-b5e8-f8d65f26518f"],
 " parameter. The specific food that is being eaten is removed concurrently \
when this function is called from the model\[CloseCurlyQuote]s food list in \
the ",
 Cell[BoxData[
  ButtonBox[
   RowBox[{"agentActions", "[", "]"}],
   BaseStyle->"Hyperlink",
   ButtonData->"agentActions[]"]], "InlineCode",ExpressionUUID->
  "aef5315e-14e6-e145-b81e-1526bb7d1645"],
 "function in ",
 StyleBox[ButtonBox["Agent Rules and Behavior",
  BaseStyle->"Hyperlink",
  ButtonData->"agentRulesandBehavior"],
  FontColor->RGBColor[
   0.792156862745098, 0.3176470588235294, 0.09803921568627451]],
 "."
}], "Text",
 CellChangeTimes->{{3.986660208063463*^9, 3.9866602236412525`*^9}, {
  3.9866602835315895`*^9, 3.9866603097685356`*^9}, {3.986660574870407*^9, 
  3.98666058938035*^9}, {3.9886712596500454`*^9, 3.988671294020706*^9}, {
  3.9887487335044136`*^9, 
  3.9887487476299515`*^9}},ExpressionUUID->"a94ed3d5-78c9-4a4d-9d85-\
c0e13657ff40"],

Cell[BoxData[
 RowBox[{
  RowBox[{"agentEat", "[", 
   RowBox[{"agent_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"agent2", " ", "=", " ", "agent"}], ",", " ", "newE"}], "}"}], ",",
     "\n", "\t", 
    RowBox[{
     RowBox[{"newE", " ", "=", " ", 
      RowBox[{
       RowBox[{"agent2", "[", "\"\<energy\>\"", "]"}], " ", "+", " ", 
       RowBox[{"params", "[", "\"\<foodEnergy\>\"", "]"}]}]}], ";", "\n", 
     "\t", 
     RowBox[{
      RowBox[{"agent2", "[", "\"\<energy\>\"", "]"}], " ", "=", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"newE", " ", ">", " ", 
         RowBox[{"params", "[", "\"\<maxEnergy\>\"", "]"}]}], ",", " ", 
        RowBox[{"params", "[", "\"\<maxEnergy\>\"", "]"}], ",", " ", "newE"}],
        "]"}]}], ";", "\n", "\t", "agent2"}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{3.9866603267786865`*^9},
 CellLabel->"In[11]:=",ExpressionUUID->"1d8de386-2365-ee41-894d-4da0592f83ac"],

Cell[TextData[{
 "Through the ",
 Cell[BoxData[
  RowBox[{"If", "[", "]"}]], "InlineCode",ExpressionUUID->
  "813995c0-dd6e-6542-a0ad-a0834b77531b"],
 "statement in the function, ",
 Cell[BoxData[
  RowBox[{"agentEat", "[", "]"}]], "InlineCode",ExpressionUUID->
  "71c2fd24-3b74-6343-a3a4-1a82289c404c"],
 " ensures that the energy does not exceed the ",
 Cell[BoxData[
  StyleBox["maxEnergy",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "26fd48f5-7a05-a34a-999f-53d5f1ebbd0f"]
}], "CodeText",
 CellChangeTimes->{{3.9866603578862877`*^9, 3.9866603857281055`*^9}, {
  3.9886712408184166`*^9, 
  3.9886712465809574`*^9}},ExpressionUUID->"f0edc91d-1c43-e045-a489-\
7d79373f6072"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Reproduction", "Section",
 CellChangeTimes->{{3.98286926438072*^9, 3.982869269632347*^9}, {
  3.9828693236442394`*^9, 3.9828693436310635`*^9}, {3.9829495713867683`*^9, 
  3.982949574711521*^9}, {3.9861296033929863`*^9, 3.9861296035975056`*^9}, {
  3.986132698468153*^9, 3.9861326988221054`*^9}, {3.9887499716468124`*^9, 
  3.9887499834478207`*^9}, {3.988751030880451*^9, 3.988751031009922*^9}},
 CellTags->
  "Reproduction",ExpressionUUID->"a671984d-8b17-ce47-8fa1-7e377fdc9c60"],

Cell[TextData[{
 "Introducing reproduction is crucial to simulate real animal behaviors. When \
two agents meet, they produce an offspring that inherits a position between \
them and a fresh slice of energy. Our functionality has four main parts \
working together: a way to give every agent an identity, rules for deciding \
who is allowed to mate with whom, and the reproduction step itself.\
\[LineSeparator]\nEvery agent has a unique integer id, assigned when the \
agent is created. Every agent also has the ids of both their parents. The \
founding agents, the first agents in the simulation, have no parents and are \
simply marked with {-1, -1}. These are all part of the agent association (see \
",
 Cell[BoxData[
  ButtonBox[
   RowBox[{"createAgent", "[", "]"}],
   BaseStyle->"Hyperlink",
   ButtonData->"createAgent[]"]], "InlineCode",ExpressionUUID->
  "d4068c4b-5285-5049-932c-71bb8d057902"],
 "in ",
 StyleBox[ButtonBox["Data Structures",
  BaseStyle->"Hyperlink",
  ButtonData->"dataStructures"],
  FontColor->RGBColor[
   0.7803921568627451, 0.4235294117647059, 0.1607843137254902]],
 ")."
}], "Text",
 CellChangeTimes->{{3.9884032968466434`*^9, 3.9884032983016624`*^9}, 
   3.9884033373173676`*^9, {3.9887495420199165`*^9, 3.9887496177100677`*^9}, {
   3.9887496599896507`*^9, 3.988749661571848*^9}, {3.9887497329399357`*^9, 
   3.9887497329399357`*^9}, {3.9887499467808304`*^9, 3.988749947449602*^9}, {
   3.988749988233612*^9, 
   3.988750009642954*^9}},ExpressionUUID->"157b7664-173a-8649-8bf9-\
90eeaba52789"],

Cell[TextData[{
 "The nextAgentId is created in ",
 Cell[BoxData[
  ButtonBox[
   RowBox[{"initializeModel", "[", "]"}],
   BaseStyle->"Hyperlink",
   ButtonData->"initializeModel[]"]], "InlineCode",ExpressionUUID->
  "5216e0cf-e975-9340-a61a-7065e85f387d"],
 "(see ",
 StyleBox[ButtonBox["Model Initialization",
  BaseStyle->"Hyperlink",
  ButtonData->"modelInitialization"],
  FontColor->RGBColor[
   0.792156862745098, 0.3176470588235294, 0.09803921568627451]],
 ")",
 StyleBox[" ",
  FontSlant->"Italic"],
 "to one more than the founding population, so the first agent created is \
given the next unused id: \n\n",
 Cell[BoxData[
  RowBox[{"\"\<nextAgentID\>\"", " ", "->", " ", 
   RowBox[{"nStartingAgents", " ", "+", " ", "1"}]}]], "InlineCode",
  ExpressionUUID->"96e3154d-bcb7-f949-b42c-4f13c8d4678b"]
}], "Text",
 CellChangeTimes->{{3.9884033802017555`*^9, 3.9884034042443085`*^9}, 
   3.988403791985716*^9, {3.988749744150036*^9, 3.988749751141981*^9}, {
   3.9887497862580853`*^9, 3.98874982339592*^9}, {3.988749856809868*^9, 
   3.988749858467661*^9}, {3.9887498906202793`*^9, 3.9887498906202793`*^9}, 
   3.988750077106737*^9},
 CellTags->
  "nextAgentIDDescription",ExpressionUUID->"f42d0a1a-adae-af44-85d9-\
de91315bc30f"],

Cell[CellGroupData[{

Cell["Helper Functions", "Subsection",
 CellChangeTimes->{{3.988750019143709*^9, 3.9887500202218437`*^9}, {
  3.9887500658576603`*^9, 3.9887500677618713`*^9}, {3.988750146909664*^9, 
  3.988750146962385*^9}},ExpressionUUID->"1e0a9830-37d4-2c41-bc51-\
7d2d0080edb1"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"areRelated", "[", 
   RowBox[{"ai", ",", " ", "aj"}], "]"}]], "InlineCode",ExpressionUUID->
  "5a95029f-a4f2-3f4a-b0c2-ca73e27cba17"],
 " returns True if two agents share a close family tie, and is used to \
prevent incestuous pairings. It checks three conditions joined by an ",
 Cell[BoxData[
  RowBox[{"Or", "[", "]"}]], "InlineCode",ExpressionUUID->
  "413d0f3e-46df-7041-87aa-6ab85910d777"],
 " statement: whether ",
 Cell[BoxData[
 "aj"], "InlineCode",ExpressionUUID->"1d745387-a1ee-1c4f-a3f3-c728310d2dfb"],
 "\[CloseCurlyQuote]s id appears in ",
 Cell[BoxData[
 "ai"], "InlineCode",ExpressionUUID->"3130b937-69ee-8c48-9b41-809742c2d632"],
 "\[CloseCurlyQuote]s parent list (",
 Cell[BoxData[
 "aj"], "InlineCode",ExpressionUUID->"d6e9fdc6-331f-4944-a661-9d7f74eba473"],
 " is a parent of ",
 Cell[BoxData[
 "ai"], "InlineCode",ExpressionUUID->"d0a232ed-2dd0-f846-b13d-39ef15828f0f"],
 "), whether ",
 Cell[BoxData[
 "ai"], "InlineCode",ExpressionUUID->"42d108d2-e333-e445-bef7-12dff491e44a"],
 " is a parent of ",
 Cell[BoxData[
 "aj"], "InlineCode",ExpressionUUID->"0005c241-9493-5040-bddb-dabd411af3cc"],
 ", or whether the two agents have the identical set of parents (making them \
siblings). The sibling check ",
 StyleBox["sorts",
  FontWeight->"Bold"],
 " both parent lists before comparing so that parent order does not matter, \
and it explicitly excludes the founding agents, whose parents are {-1, -1}, \
so that the original population is not treated as one large sibling group."
}], "Text",
 CellChangeTimes->{
  3.9884034303123913`*^9, 3.988403737658062*^9, {3.9884037736917915`*^9, 
   3.9884037862281284`*^9}, {3.9887510495800533`*^9, 
   3.9887510954898624`*^9}},ExpressionUUID->"2d7a60d4-6db9-e14e-9f0c-\
cc61579a438d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"areRelated", "[", 
   RowBox[{"ai_", ",", " ", "aj_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Or", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"MemberQ", "[", 
     RowBox[{
      RowBox[{"ai", "[", "\"\<parents\>\"", "]"}], ",", " ", 
      RowBox[{"aj", "[", "\"\<id\>\"", "]"}]}], "]"}], ",", "   ", "\n", 
    "    ", 
    RowBox[{"MemberQ", "[", 
     RowBox[{
      RowBox[{"aj", "[", "\"\<parents\>\"", "]"}], ",", " ", 
      RowBox[{"ai", "[", "\"\<id\>\"", "]"}]}], "]"}], ",", " ", "\n", "    ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"ai", "[", "\"\<parents\>\"", "]"}], " ", "=!=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{"-", "1"}]}], "}"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"ai", "[", "\"\<parents\>\"", "]"}], "]"}], " ", "===", " ", 
       RowBox[{"Sort", "[", 
        RowBox[{"aj", "[", "\"\<parents\>\"", "]"}], "]"}]}]}], ")"}]}], "  ", 
   RowBox[{"(*", " ", 
    RowBox[{"siblings", ":", " ", 
     RowBox[{"same", " ", "parent", " ", "pair"}]}], " ", "*)"}], "\n", 
   "]"}]}]], "Code",
 CellChangeTimes->{3.9887580502500744`*^9},
 CellLabel->"In[12]:=",ExpressionUUID->"6b270d2a-809c-fd4a-b5e3-b3428f981898"],

Cell[TextData[{
 "A reproduction cooldown is needed because, without one, any qualifying pair \
would reproduce on every single timestep they remained close and energetic, \
producing unrealistic runaway population growth. This is also necessary to \
reflect biology as most organisms cannot reproduce many times in one period \
and instead require some recovery or storage of energy before reproducing \
again. The cooldown imposes a refractory period: after reproducing, an agent\
\[CloseCurlyQuote]s ",
 Cell[BoxData[
  StyleBox["reproductionCooldown",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "c59c62f7-6d8c-fd43-9f09-e365f6b8961c"],
 " is set to a positive value and it cannot mate again until that value \
returns to 0. ",
 Cell[BoxData[
  RowBox[{"decrementReproductionCooldowns", "[", "]"}]], "InlineCode",
  ExpressionUUID->"e0ec8d99-7d8d-c346-83c7-c2cb5e3b2dc4"],
 " is what counts it down - each timestep it reduces every agent\
\[CloseCurlyQuote]s ",
 Cell[BoxData[
  StyleBox["reproductionCooldown",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "af299185-92a7-4849-8848-b3969ec7c2ba"],
 " by the model\[CloseCurlyQuote]s timestep ",
 Cell[BoxData[
  StyleBox["dt",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "d809c787-2308-c94e-98aa-926018dddbfc"],
 ", using ",
 Cell[BoxData[
  RowBox[{"Max", "[", 
   RowBox[{
    RowBox[{"#", " ", "-", " ", 
     StyleBox["dt",
      FontSlant->"Italic"]}], ",", " ", "0"}], "]"}]], "InlineCode",
  ExpressionUUID->"f90cfac2-a1e7-cd4d-afd7-7819e29e4ea2"],
 " so the value never drops below zero, at which point the agent becomes \
eligible to reproduce again."
}], "Text",
 CellChangeTimes->{{3.9884036569133625`*^9, 3.9884036766408463`*^9}, 
   3.9884041030159416`*^9, {3.988751120586035*^9, 
   3.9887512273742313`*^9}},ExpressionUUID->"bc46c2dc-47d2-a344-b903-\
051d83815ba2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"decrementReproductionCooldowns", "[", 
   RowBox[{"model_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"agents", " ", "=", " ", 
       RowBox[{"model", "[", "\"\<agents\>\"", "]"}]}], ",", " ", 
      RowBox[{"model2", " ", "=", " ", "model"}]}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"agents", " ", "=", " ", 
      RowBox[{"MapAt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{"#", " ", "-", " ", 
            RowBox[{"params", "[", "\"\<dt\>\"", "]"}]}], ",", " ", "0"}], 
          "]"}], "&"}], ",", " ", "agents", ",", " ", 
        RowBox[{"{", 
         RowBox[{"All", ",", " ", "\"\<reproductionCooldown\>\""}], "}"}]}], 
       "]"}]}], ";", "\n", "\t", 
     RowBox[{
      RowBox[{"model2", "[", "\"\<agents\>\"", "]"}], " ", "=", " ", 
      "agents"}], ";", "\n", "\t", "model2"}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{3.988403674819174*^9},
 CellLabel->"In[13]:=",ExpressionUUID->"511eeec0-82fb-c346-bffd-44c3a38a25c9"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"findClosestAgentI", "[", "]"}]], "InlineCode",ExpressionUUID->
  "6adaef1a-a2ad-6045-b43b-6a18c4de5d64"],
 " returns the index of the closest agent to an agent in question in the \
model\[CloseCurlyQuote]s ",
 StyleBox["agents list",
  FontWeight->"Bold"],
 ". It is necessary for the ",
 StyleBox[ButtonBox["Main Reproduction Function",
  BaseStyle->"Hyperlink",
  ButtonData->"mainReproductionFunction"],
  FontColor->RGBColor[
   0.8274509803921568, 0.4235294117647059, 0.1607843137254902]],
 " below."
}], "Text",
 CellChangeTimes->{{3.9887506527858067`*^9, 3.9887507318848934`*^9}, {
  3.9887508307786236`*^9, 3.9887508307786236`*^9}, {3.988750864819868*^9, 
  3.988750897829588*^9}, {3.9887509697260017`*^9, 
  3.9887510055597763`*^9}},ExpressionUUID->"792b85e8-b152-e042-adba-\
0241bced7578"],

Cell[BoxData[
 RowBox[{
  RowBox[{"findClosestAgentI", "[", 
   RowBox[{"agentI_Integer", ",", " ", "agents_List"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pos", ",", " ", "dists"}], "}"}], ",", "\n", "    ", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "agents", "]"}], " ", "<", " ", "2"}], ",", 
       " ", 
       RowBox[{"Return", "[", 
        RowBox[{"-", "1"}], "]"}]}], "]"}], ";", "\n", "    ", 
     RowBox[{"pos", " ", "=", " ", 
      RowBox[{
       RowBox[{"agents", "[", 
        RowBox[{"[", "agentI", "]"}], "]"}], "[", "\"\<pos\>\"", "]"}]}], ";",
      "\n", "    ", 
     RowBox[{"dists", " ", "=", " ", 
      RowBox[{"Table", "[", "\n", "        ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"i", " ", "==", " ", "agentI"}], ",", " ", "Infinity", ",", 
          " ", 
          RowBox[{"EuclideanDistance", "[", 
           RowBox[{"pos", ",", " ", 
            RowBox[{
             RowBox[{"agents", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<pos\>\"", "]"}]}], 
           "]"}]}], "]"}], ",", "\n", "        ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", 
          RowBox[{"Length", "[", "agents", "]"}]}], "}"}]}], "\n", "    ", 
       "]"}]}], ";", "\n", "    ", 
     RowBox[{"First", "@", 
      RowBox[{"Ordering", "[", 
       RowBox[{"dists", ",", " ", "1"}], "]"}]}]}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{3.9887508497697487`*^9},
 CellTags->"findClosestAgentI",
 CellLabel->"In[14]:=",ExpressionUUID->"5196b543-4750-fc4c-b936-28020ede4538"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  RowBox[{"Ordering", "[", "]"}]], "InlineCode",ExpressionUUID->
  "db517f1f-ccbc-e041-95dc-e73974af33b9"],
 "function is the main sorting workhorse of ",
 Cell[BoxData[
  RowBox[{"findClosestAgentI", "[", "]"}]], "InlineCode",ExpressionUUID->
  "f712838f-8323-1946-a5ef-a28a9eac9495"],
 ". The ",
 Cell[BoxData[
 "If"], "InlineCode",ExpressionUUID->"7bdfa24d-02e8-594a-909d-f0b1d3ea7b31"],
 " statement avoids conflating oneself for the nearest agent through use of ",
 Cell[BoxData[
 "Infinity"], "InlineCode",ExpressionUUID->
  "7a02e75c-4b07-9d42-a821-81e3087e90f5"],
 "."
}], "CodeText",
 CellChangeTimes->{
  3.9887510123697853`*^9},ExpressionUUID->"564cf370-91c9-ca4c-8211-\
fb7c68ab3006"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Main Reproduction Function", "Subsection",
 CellChangeTimes->{{3.9887500578482704`*^9, 3.988750062038082*^9}},
 CellTags->
  "mainReproductionFunction",ExpressionUUID->"0e37b13f-f8d6-3f40-8a74-\
e47d70ee5bdd"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"reproduceAgents", "[", "]"}]], "InlineCode",ExpressionUUID->
  "269c0cdb-5865-fa4a-a94d-416b2f634e77"],
 " carries out the actual reproduction step for a timestep. It iterates over \
every agent and finds its closest candidate partner, then re-checks the full \
mating predicate inline (the same distance, energy, age, cooldown, and \
relatedness conditions). When a pair qualifies and neither partner has \
already reproduced this timestep, both parents pay their parametric ",
 Cell[BoxData[
  StyleBox["reproductionEnergyCost",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "e62efce1-6cec-ae44-a1e7-aa1b52a2c528"],
 " and have their cooldown reset, and a new agent is created at the midpoint \
between the parents with half of the model\[CloseCurlyQuote]s preset ",
 Cell[BoxData[
  StyleBox["startingEnergy",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "05dd6803-8fab-b642-ab59-e3f9458997a9"],
 " parameter for an agent, age 0, the ",
 StyleBox["next",
  FontWeight->"Bold"],
 " unused id, a random heading (see ",
 StyleBox[ButtonBox["Agent Rules and Behavior",
  BaseStyle->"Hyperlink",
  ButtonData->"agentRulesandBehavior"],
  FontColor->RGBColor[
   0.792156862745098, 0.3176470588235294, 0.09803921568627451]],
 "), and both parents\[CloseCurlyQuote] ids recorded. The new id counter \
advances, both partners are flagged as having reproduced so each mates at \
most once per step, and at the end the newborns are appended to the \
population and nextAgentID is saved back into the model."
}], "Text",
 CellChangeTimes->{{3.988403600251686*^9, 3.988403600607559*^9}, 
   3.98840380157959*^9, {3.988404240199049*^9, 3.9884042641655807`*^9}, {
   3.9887512527147446`*^9, 3.9887513358118057`*^9}, {3.988751448119776*^9, 
   3.988751448119776*^9}, {3.988751550369772*^9, 3.9887515556600857`*^9}, {
   3.9887515994400463`*^9, 
   3.9887515996360817`*^9}},ExpressionUUID->"a8559f96-207b-174d-ba19-\
f7355ad39b1b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"reproduceAgents", "[", 
   RowBox[{"model_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", "\n", "        ", 
     RowBox[{
      RowBox[{"agents", " ", "=", " ", 
       RowBox[{"model", "[", "\"\<agents\>\"", "]"}]}], ",", " ", 
      RowBox[{"model2", " ", "=", " ", "model"}], ",", " ", 
      RowBox[{"newAgents", " ", "=", " ", 
       RowBox[{"{", "}"}]}], ",", "\n", "        ", "reproduced", ",", " ", 
      "nextID", ",", " ", "j", ",", " ", "ai", ",", " ", "aj", ",", " ", 
      "dist", ",", " ", "midPos", ",", " ", "newAgent", ",", " ", "newDir"}], 
     "\n", "    ", "}"}], ",", "\n", "\n", "  ", 
    RowBox[{
     RowBox[{"nextID", " ", "=", " ", 
      RowBox[{"model", "[", "\"\<nextAgentID\>\"", "]"}]}], ";", "\n", "  ", 
     RowBox[{"reproduced", " ", "=", " ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"False", ",", " ", 
        RowBox[{"Length", "[", "agents", "]"}]}], "]"}]}], ";", "\n", "\n", 
     "  ", 
     RowBox[{"Do", "[", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"reproduced", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
          RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "    ", 
        RowBox[{"j", " ", "=", " ", 
         RowBox[{"findClosestAgentI", "[", 
          RowBox[{"i", ",", " ", "agents"}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"j", " ", "==", " ", 
            RowBox[{"-", "1"}]}], " ", "||", " ", 
           RowBox[{"reproduced", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], ",", " ", 
          RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "\n", "    ", 
        RowBox[{"ai", " ", "=", " ", 
         RowBox[{"agents", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"aj", " ", "=", " ", 
         RowBox[{"agents", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"dist", " ", "=", " ", 
         RowBox[{"EuclideanDistance", "[", 
          RowBox[{
           RowBox[{"ai", "[", "\"\<pos\>\"", "]"}], ",", " ", 
           RowBox[{"aj", "[", "\"\<pos\>\"", "]"}]}], "]"}]}], ";", "\n", 
        "\n", "    ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"dist", " ", "<=", " ", 
            RowBox[{"params", "[", "\"\<reproductionRadius\>\"", "]"}]}], " ",
            "&&", "\n", "       ", 
           RowBox[{
            RowBox[{"ai", "[", "\"\<energy\>\"", "]"}], " ", ">=", " ", 
            RowBox[{"params", "[", "\"\<minReproductionEnergy\>\"", "]"}]}], 
           " ", "&&", "\n", "       ", 
           RowBox[{
            RowBox[{"aj", "[", "\"\<energy\>\"", "]"}], " ", ">=", " ", 
            RowBox[{"params", "[", "\"\<minReproductionEnergy\>\"", "]"}]}], 
           " ", "&&", "\n", "       ", 
           RowBox[{
            RowBox[{"ai", "[", "\"\<age\>\"", "]"}], " ", ">=", " ", 
            RowBox[{"params", "[", "\"\<minReproductionAge\>\"", "]"}]}], " ",
            "&&", "\n", "       ", 
           RowBox[{
            RowBox[{"aj", "[", "\"\<age\>\"", "]"}], " ", ">=", " ", 
            RowBox[{"params", "[", "\"\<minReproductionAge\>\"", "]"}]}], " ",
            "&&", "\n", "        ", 
           RowBox[{
            RowBox[{"ai", "[", "\"\<reproductionCooldown\>\"", "]"}], " ", "<=",
             " ", "0"}], " ", "&&", "\n", "        ", 
           RowBox[{
            RowBox[{"aj", "[", "\"\<reproductionCooldown\>\"", "]"}], " ", "<=",
             " ", "0"}], " ", "&&", "\n", "       ", 
           RowBox[{"!", 
            RowBox[{"areRelated", "[", 
             RowBox[{"ai", ",", " ", "aj"}], "]"}]}]}], ",", "\n", "\n", 
          "      ", 
          RowBox[{"(*", " ", 
           RowBox[{
           "both", " ", "parents", " ", "pay", " ", "energy", " ", "cost"}], 
           " ", "*)"}], "\n", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"agents", "[", 
             RowBox[{"[", "i", "]"}], "]"}], " ", "=", " ", 
            RowBox[{"<|", 
             RowBox[{"ai", ",", "\n", "      ", 
              RowBox[{"\"\<energy\>\"", " ", "->", " ", 
               RowBox[{
                RowBox[{"ai", "[", "\"\<energy\>\"", "]"}], " ", "-", " ", 
                RowBox[{
                "params", "[", "\"\<reproductionEnergyCost\>\"", "]"}]}]}], ",",
               "\n", "      ", 
              RowBox[{"\"\<reproductionCooldown\>\"", " ", "->", " ", 
               RowBox[{
               "params", "[", "\"\<reproductionCooldown\>\"", "]"}]}]}], 
             "|>"}]}], ";", "\n", "      ", 
           RowBox[{
            RowBox[{"agents", "[", 
             RowBox[{"[", "j", "]"}], "]"}], " ", "=", " ", 
            RowBox[{"<|", 
             RowBox[{"aj", ",", "\n", "      ", 
              RowBox[{"\"\<energy\>\"", " ", "->", " ", 
               RowBox[{
                RowBox[{"aj", "[", "\"\<energy\>\"", "]"}], " ", "-", " ", 
                RowBox[{
                "params", "[", "\"\<reproductionEnergyCost\>\"", "]"}]}]}], ",",
               "\n", "      ", 
              RowBox[{"\"\<reproductionCooldown\>\"", " ", "->", " ", 
               RowBox[{
               "params", "[", "\"\<reproductionCooldown\>\"", "]"}]}]}], 
             "|>"}]}], ";", "\n", "\n", "      ", 
           RowBox[{"midPos", " ", "=", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"ai", "[", "\"\<pos\>\"", "]"}], " ", "+", " ", 
               RowBox[{"aj", "[", "\"\<pos\>\"", "]"}]}], ")"}], " ", "/", 
             " ", "2"}]}], ";", "\n", "      ", 
           RowBox[{"newDir", " ", "=", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Cos", "[", "#", "]"}], ",", " ", 
                RowBox[{"Sin", "[", "#", "]"}]}], "}"}], " ", "&"}], "[", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", 
                RowBox[{"2", " ", "Pi"}]}], "}"}], "]"}], "]"}]}], ";", "\n", 
           "      ", 
           RowBox[{"newAgent", " ", "=", " ", 
            RowBox[{"createAgent", "[", 
             RowBox[{"midPos", ",", " ", 
              RowBox[{
               RowBox[{"params", "[", "\"\<startingEnergy\>\"", "]"}], "/", 
               "2"}], ",", " ", "0.0", ",", " ", "nextID", ",", " ", "newDir",
               ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"ai", "[", "\"\<id\>\"", "]"}], ",", " ", 
                RowBox[{"aj", "[", "\"\<id\>\"", "]"}]}], "}"}], ",", " ", 
              RowBox[{"params", "[", "\"\<reproductionCooldown\>\"", "]"}]}], 
             "]"}]}], ";", "\n", "      ", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"newAgents", ",", " ", "newAgent"}], "]"}], ";", "\n", 
           "      ", 
           RowBox[{"nextID", "++"}], ";", "\n", "\n", "      ", 
           RowBox[{
            RowBox[{"reproduced", "[", 
             RowBox[{"[", "i", "]"}], "]"}], " ", "=", " ", "True"}], ";", 
           "\n", "      ", 
           RowBox[{
            RowBox[{"reproduced", "[", 
             RowBox[{"[", "j", "]"}], "]"}], " ", "=", " ", "True"}], ";"}]}],
          "\n", "\n", "    ", "]"}], ";"}], "\n", "  ", ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"Length", "[", "agents", "]"}]}], "}"}]}], "]"}], ";", "\n", 
     "\n", "  ", 
     RowBox[{
      RowBox[{"model2", "[", "\"\<agents\>\"", "]"}], " ", "=", " ", 
      RowBox[{"Join", "[", 
       RowBox[{"agents", ",", " ", "newAgents"}], "]"}]}], ";", "\n", "  ", 
     RowBox[{
      RowBox[{"model2", "[", "\"\<nextAgentID\>\"", "]"}], " ", "=", " ", 
      "nextID"}], ";", "\n", "  ", "model2"}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{3.988403608658081*^9, 3.9884036482968445`*^9},
 CellLabel->"In[15]:=",ExpressionUUID->"44e73ec1-4d1c-2241-9850-d892222763bf"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Agent Rules and Behavior", "Section",
 CellChangeTimes->{{3.9886611466029205`*^9, 3.9886611588724213`*^9}},
 CellTags->
  "agentRulesandBehavior",ExpressionUUID->"0d6a2109-7b35-bb46-914d-\
cd252ba5175d"],

Cell[CellGroupData[{

Cell["Helper Functions", "Subsection",
 CellChangeTimes->{{3.988751913305853*^9, 
  3.988751915211693*^9}},ExpressionUUID->"08b6d7ea-33ca-fb49-9fcd-\
910533886ca2"],

Cell[TextData[{
 "An array of helper functions create the functionality for agents to \
navigate and interact with their surroundings according to pre-established \
biological rules. Agent decision making is not probabilistic and instead \
follows the principles of bioenergetics (see",
 StyleBox[" ",
  FontColor->RGBColor[
   0.792156862745098, 0.3176470588235294, 0.09803921568627451]],
 StyleBox[ButtonBox["Main Agent Decision Logic",
  BaseStyle->"Hyperlink",
  ButtonData->"mainAgentDecisionLogic"],
  FontColor->RGBColor[
   0.792156862745098, 0.3176470588235294, 0.09803921568627451]],
 " below).\n\nThe first such helper function is ",
 Cell[BoxData[
  RowBox[{"findClosestMateI", "[", "]"}]], "InlineCode",ExpressionUUID->
  "e2469514-38f3-af4e-8f97-b118a20294a5"],
 ". This function is identical to ",
 Cell[BoxData[
  ButtonBox[
   RowBox[{"findClosestAgentI", "[", "]"}],
   BaseStyle->"Hyperlink",
   ButtonData->"findClosestAgentI"]], "InlineCode",ExpressionUUID->
  "d681c38f-a525-a44f-a1de-f6c77e9d8678"],
 "above in ",
 StyleBox[ButtonBox["Reproduction",
  BaseStyle->"Hyperlink",
  ButtonData->"Reproduction"],
  FontColor->RGBColor[
   0.792156862745098, 0.3176470588235294, 0.09803921568627451]],
 " except for the fact that ",
 Cell[BoxData[
  RowBox[{"areRelated", "[", "]"}]], "InlineCode",ExpressionUUID->
  "9aada57f-2d3f-4149-bc94-906e5da19afd"],
 "is used to exclude parental or sibling relations. This is still done in the \
",
 StyleBox[ButtonBox["Main Reproduction Function",
  BaseStyle->"Hyperlink",
  ButtonData->"mainReproductionFunction"],
  FontColor->RGBColor[
   0.792156862745098, 0.3176470588235294, 0.09803921568627451]],
 " when ",
 Cell[BoxData[
  RowBox[{"findClosestAgentI", "[", "]"}]], "InlineCode",ExpressionUUID->
  "81e28525-6c52-d84a-b1b6-2f1051b2d612"],
 " is used, making this a minor redundancy in the package."
}], "Text",
 CellChangeTimes->{{3.9887519247899876`*^9, 3.9887519942198143`*^9}, {
  3.9887520445099564`*^9, 3.988752174351778*^9}, {3.9887522242298813`*^9, 
  3.988752238209999*^9}, {3.988752308423847*^9, 
  3.988752328479883*^9}},ExpressionUUID->"36248f43-eb71-9d41-a8e7-\
8bce1e940eb0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"findClosestMateI", "[", 
   RowBox[{"agentI_Integer", ",", " ", "agents_List"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pos", ",", " ", "dists", ",", " ", "agent"}], "}"}], ",", "\n", 
    "    ", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "agents", "]"}], " ", "<", " ", "2"}], ",", 
       " ", 
       RowBox[{"Return", "[", 
        RowBox[{"-", "1"}], "]"}]}], "]"}], ";", "\n", "    ", 
     RowBox[{"pos", " ", "=", " ", 
      RowBox[{
       RowBox[{"agents", "[", 
        RowBox[{"[", "agentI", "]"}], "]"}], "[", "\"\<pos\>\"", "]"}]}], ";",
      "\n", "    ", 
     RowBox[{"agent", " ", "=", " ", 
      RowBox[{"agents", "[", 
       RowBox[{"[", "agentI", "]"}], "]"}]}], ";", "\n", "    ", 
     RowBox[{"dists", " ", "=", " ", 
      RowBox[{"Table", "[", "\n", "        ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"i", " ", "==", " ", "agentI"}], " ", "||", " ", 
           RowBox[{"areRelated", "[", 
            RowBox[{"agent", ",", " ", 
             RowBox[{"agents", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ",", " ", "Infinity",
           ",", " ", 
          RowBox[{"EuclideanDistance", "[", 
           RowBox[{"pos", ",", " ", 
            RowBox[{
             RowBox[{"agents", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<pos\>\"", "]"}]}], 
           "]"}]}], "]"}], ",", "\n", "        ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", 
          RowBox[{"Length", "[", "agents", "]"}]}], "}"}]}], "\n", "    ", 
       "]"}]}], ";", "\n", "    ", 
     RowBox[{"First", "@", 
      RowBox[{"Ordering", "[", 
       RowBox[{"dists", ",", " ", "1"}], "]"}]}]}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{3.988752342789091*^9},
 CellLabel->"In[16]:=",ExpressionUUID->"97983dea-0c62-b145-a094-3e6f44648318"],

Cell[TextData[{
 "The next such helper function, ",
 Cell[BoxData[
  RowBox[{"findNearestSensableMateInfo", "[", "]"}]], "InlineCode",
  ExpressionUUID->"9ac47011-23cc-3942-9f26-3529be89d5aa"],
 "is similar in function and process to ",
 Cell[BoxData[
  ButtonBox[
   RowBox[{"findNearestSensableFoodInfo", "[", "]"}],
   BaseStyle->"Hyperlink",
   ButtonData->"findNearestSensableFoodInfo"]], "InlineCode",ExpressionUUID->
  "93a53b39-1b3e-f247-b582-128f5062752d"],
 "in the",
 StyleBox[" ",
  FontColor->RGBColor[
   0.792156862745098, 0.3176470588235294, 0.09803921568627451]],
 StyleBox[ButtonBox["Core Functions",
  BaseStyle->"Hyperlink",
  ButtonData->"coreFunctions"],
  FontColor->RGBColor[
   0.792156862745098, 0.3176470588235294, 0.09803921568627451]],
 " of the model. It employs ",
 Cell[BoxData[
  RowBox[{"findClosestMateI", "[", "]"}]], "InlineCode",ExpressionUUID->
  "f83683c1-2d2f-c642-af9b-eb9abe4e3716"],
 "from above for the majority of its work and returns {-1, -1, -1} in the \
case that no mate nearby is sensable similar to ",
 Cell[BoxData[
  RowBox[{"findNearestSensableFoodInfo", "[", "]"}]], "InlineCode",
  ExpressionUUID->"338c65a0-6119-2849-8174-2336f61c5c21"],
 ". Otherwise, just like that function, it returns the closest sensable mate\
\[CloseCurlyQuote]s {distance, index in the agents list, and position} of \
course."
}], "Text",
 CellChangeTimes->{{3.9887523519200153`*^9, 3.9887524107048473`*^9}, {
  3.9887524610417175`*^9, 3.9887524610417175`*^9}, {3.988752507829912*^9, 
  3.9887526011467056`*^9}, {3.9887526337700024`*^9, 
  3.98875272244013*^9}},ExpressionUUID->"f85e6d4b-a6ac-fd41-913b-\
06d1ee85a16b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"findNearestSensableMateInfo", "[", 
   RowBox[{"agentI_Integer", ",", " ", "agents_List", ",", " ", "params_"}], 
   "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "\t", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "agent", ",", " ", "nearAgentI", ",", " ", "nearAgent", ",", " ", 
      "nearAgentPos", ",", " ", "nearAgentDist"}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"agent", " ", "=", " ", 
      RowBox[{"agents", "[", 
       RowBox[{"[", "agentI", "]"}], "]"}]}], ";", "\n", "\t", 
     RowBox[{"nearAgentI", " ", "=", " ", 
      RowBox[{"findClosestMateI", "[", 
       RowBox[{"agentI", ",", " ", "agents"}], "]"}]}], ";", "\n", "\t", 
     RowBox[{"nearAgent", " ", "=", " ", 
      RowBox[{"agents", "[", 
       RowBox[{"[", "nearAgentI", "]"}], "]"}]}], ";", "\n", "\t", 
     RowBox[{"nearAgentPos", " ", "=", " ", 
      RowBox[{"nearAgent", "[", "\"\<pos\>\"", "]"}]}], ";", "\n", "\t", 
     RowBox[{"nearAgentDist", " ", "=", " ", 
      RowBox[{"EuclideanDistance", "[", 
       RowBox[{
        RowBox[{"agent", "[", "\"\<pos\>\"", "]"}], ",", " ", 
        "nearAgentPos"}], "]"}]}], ";", "\n", "\t", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"nearAgentDist", " ", "<", " ", 
        RowBox[{"params", "[", "\"\<sensingDistance\>\"", "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
        "nearAgentDist", ",", " ", "nearAgentI", ",", " ", "nearAgentPos"}], 
        "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{"-", "1"}]}], "}"}]}], "]"}]}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{3.9887525188497753`*^9},
 CellLabel->"In[17]:=",ExpressionUUID->"a96f21a3-986d-f74f-8f06-a6ee6e22dd5a"],

Cell[TextData[{
 "The following two functions ",
 Cell[BoxData[
  RowBox[{"agentSetFoodDir", "[", "]"}]], "InlineCode",ExpressionUUID->
  "04de1f59-efbb-9742-8f23-e0849d556778"],
 " and ",
 Cell[BoxData[
  RowBox[{"agentSetMateDir", "[", "]"}]], "InlineCode",ExpressionUUID->
  "d9c7cb76-e9be-8d4e-b0ec-8e1c7379571e"],
 "are identical in form and different only in name for clarity. These \
functions orient the agent\[CloseCurlyQuote]s ",
 Cell[BoxData[
  StyleBox["currentDirection",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "dcfcdf00-27fe-2a4e-99f1-8a7239c3fd17"],
 " direction vector (list of length 2) towards an agent or piece of food that \
it hopes to travel to, supplied with its index in its respective list (agents \
list or food list). This direction vector is of course calculated through \
vector subtraction and normalization. This is necessary for agents to be able \
to intentionally travel to their goal after sensing their goal in their \
environment. A smoothing parameter in the model ",
 Cell[BoxData[
  StyleBox["epsilon",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "8795b20a-3f83-9f4f-a2b8-a6170b6cff33"],
 " is used to avoid numerical divergences in case agents are very close."
}], "Text",
 CellChangeTimes->{{3.9887527953855953`*^9, 
  3.9887530315600567`*^9}},ExpressionUUID->"ad33c21d-ca5c-fd41-96c4-\
1b28de11b264"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"agentSetFoodDir", "[", 
    RowBox[{"agent_", ",", " ", "foodPos_", ",", " ", "params_"}], "]"}], " ",
    ":=", " ", 
   RowBox[{"Module", "[", "\n", "\t", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"agent2", " ", "=", " ", "agent"}], ",", " ", "dirV"}], "}"}], 
     ",", "\n", "\t", 
     RowBox[{
      RowBox[{"dirV", " ", "=", " ", 
       RowBox[{"foodPos", " ", "-", " ", 
        RowBox[{"agent", "[", "\"\<pos\>\"", "]"}]}]}], ";", "\n", "\t", 
      RowBox[{
       RowBox[{"agent2", "[", "\"\<currentDirection\>\"", "]"}], " ", "=", 
       " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Norm", "[", "dirV", "]"}], "+", 
            RowBox[{"params", "[", "\"\<epsilon\>\"", "]"}]}], ")"}]}], ")"}],
         " ", "*", " ", "dirV"}]}], ";", "\n", "\t", 
      RowBox[{
       RowBox[{"agent2", "[", "\"\<currentDirection\>\"", "]"}], " ", "=", 
       " ", 
       RowBox[{"Round", "[", 
        RowBox[{
         RowBox[{"agent2", "[", "\"\<currentDirection\>\"", "]"}], ",", " ", 
         RowBox[{"params", "[", "\"\<rnd\>\"", "]"}]}], "]"}]}], ";", "\n", 
      "\t", "agent2"}]}], "\n", "]"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"agentSetMateDir", "[", 
   RowBox[{"agent_", ",", " ", "matePos_", ",", " ", "params_"}], "]"}], " ", 
  ":=", " ", 
  RowBox[{"Module", "[", "\n", "\t", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"agent2", " ", "=", " ", "agent"}], ",", " ", "dirV"}], "}"}], ",",
     "\n", "\t", 
    RowBox[{
     RowBox[{"dirV", " ", "=", " ", 
      RowBox[{"matePos", " ", "-", " ", 
       RowBox[{"agent", "[", "\"\<pos\>\"", "]"}]}]}], ";", "\n", "\t", 
     RowBox[{
      RowBox[{"agent2", "[", "\"\<currentDirection\>\"", "]"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Norm", "[", "dirV", "]"}], " ", "+", " ", 
           RowBox[{"params", "[", "\"\<epsilon\>\"", "]"}]}], ")"}]}], ")"}], 
       " ", "*", " ", "dirV"}]}], ";", "\n", "\t", 
     RowBox[{
      RowBox[{"agent2", "[", "\"\<currentDirection\>\"", "]"}], " ", "=", " ", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"agent2", "[", "\"\<currentDirection\>\"", "]"}], ",", " ", 
        RowBox[{"params", "[", "\"\<rnd\>\"", "]"}]}], "]"}]}], ";", "\n", 
     "\t", "agent2"}]}], "\n", "]"}]}]}], "Code",
 CellChangeTimes->{
  3.9887529706698456`*^9, {3.988755624615204*^9, 3.9887556271539116`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"8ac663f2-58a7-0d42-9510-7305f4f282ec"],

Cell[TextData[{
 "Finally, ",
 Cell[BoxData[
  RowBox[{"agentSetExploreDir", "[", "]"}]], "InlineCode",ExpressionUUID->
  "70400428-3a4c-d14f-8487-ab03d9adbfd5"],
 " is the mechanism for agents\[CloseCurlyQuote] foraging behavior. When \
agents are not intentionally traveling towards a mate or piece of food, they \
are exploring for those things. This is in a random direction, which has a \
probability of changing given by the model parameter ",
 Cell[BoxData[
  StyleBox["dirChangeProb",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "a227e82f-be43-5b4b-a592-cb403a93f04c"],
 " every timestep. An agent will definitely change its explore direction \
regardless of this probability if it has encountered a mate or piece of food \
according to the",
 StyleBox[" ",
  FontColor->RGBColor[
   0.792156862745098, 0.3176470588235294, 0.09803921568627451]],
 StyleBox[ButtonBox["Main Agent Decision Logic",
  BaseStyle->"Hyperlink",
  ButtonData->"mainAgentDecisionLogic"],
  FontColor->RGBColor[
   0.792156862745098, 0.3176470588235294, 0.09803921568627451]],
 " below. By considering if agents are nearing the end the environment \
positionally, wall avoidance is implemented in the main ",
 Cell[BoxData[
  RowBox[{"Which", "[", "]"}]], "InlineCode",ExpressionUUID->
  "ef8a47e0-8be2-8248-9a27-d16dbaea29ab"],
 " statement. As per this statement, agents will head in their new \
exploration direction if they reach the random change of ",
 Cell[BoxData[
  StyleBox["dirChangeProb",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "6c689274-db6e-9449-94c6-273289d01849"],
 " or if they are on a collision course with a wall of the environment. If \
neither of those things happen they happily continue on their way."
}], "Text",
 CellChangeTimes->{{3.9887530637604713`*^9, 
  3.988753367453861*^9}},ExpressionUUID->"da414617-3727-5a4e-96b8-\
d666e9c56921"],

Cell[BoxData[
 RowBox[{
  RowBox[{"agentSetExploreDir", "[", 
   RowBox[{"agent_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "\t", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"agent2", " ", "=", " ", "agent"}], ",", " ", "ax", ",", " ", 
      "ay", ",", " ", "sqmin", ",", " ", "sqmax", ",", " ", "proxRad", ",", 
      " ", "randomTheta"}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ax", ",", " ", "ay"}], "}"}], " ", "=", " ", 
      RowBox[{"agent", "[", "\"\<pos\>\"", "]"}]}], ";", "\n", "\t", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sqmin", ",", " ", "sqmax"}], "}"}], " ", "=", " ", 
      RowBox[{"params", "[", "\"\<squareBounds\>\"", "]"}]}], ";", "\n", "\t", 
     RowBox[{"proxRad", " ", "=", " ", 
      RowBox[{
       RowBox[{"params", "[", "\"\<stepLength\>\"", "]"}], "/", "2"}]}], ";", 
     "\n", "\t", 
     RowBox[{
      RowBox[{"agent2", "[", "\"\<currentDirection\>\"", "]"}], " ", "=", " ",
       "\n", "\t", 
      RowBox[{"Which", "[", "\n", "\t\t", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"RandomReal", "[", "]"}], " ", "<", " ", 
          RowBox[{"params", "[", "\"\<dirChangeProb\>\"", "]"}]}], " ", "||", 
         " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"ax", " ", "<", " ", 
            RowBox[{"sqmin", " ", "+", " ", "proxRad"}]}], " ", "||", " ", 
           RowBox[{"ax", " ", ">", " ", 
            RowBox[{"sqmax", " ", "-", " ", "proxRad"}]}], " ", "||", " ", 
           RowBox[{"ay", " ", "<", " ", 
            RowBox[{"sqmin", " ", "+", " ", "proxRad"}]}], " ", "||", " ", 
           RowBox[{"ay", " ", ">", " ", 
            RowBox[{"sqmax", " ", "-", " ", "proxRad"}]}]}], ")"}]}], ",", 
        "\n", "\t\t", 
        RowBox[{
         RowBox[{"randomTheta", " ", "=", " ", 
          RowBox[{"RandomReal", "[", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", 
             RowBox[{"2", " ", "Pi"}]}], "}"}], "]"}]}], ";", " ", 
         RowBox[{"Round", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Cos", "[", "randomTheta", "]"}], ",", " ", 
             RowBox[{"Sin", "[", "randomTheta", "]"}]}], "}"}], ",", " ", 
           RowBox[{"params", "[", "\"\<rnd\>\"", "]"}]}], "]"}]}], ",", " ", 
        "\n", "\t\t", "\n", "\t\t", "True", ",", "\n", "\t\t", 
        RowBox[{"agent2", "[", "\"\<currentDirection\>\"", "]"}]}], "\n", 
       "\t", "]"}]}], ";", "\n", "\t", "agent2"}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{3.988753380479933*^9},
 CellLabel->"In[20]:=",ExpressionUUID->"62333fd8-8cd1-944e-b1a3-820db2b2006b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Main Agent Decision Logic", "Subsection",
 CellChangeTimes->{{3.9887519008697815`*^9, 3.988751905779928*^9}, {
  3.988751999599804*^9, 3.98875200221002*^9}, {3.988754730469982*^9, 
  3.988754730589756*^9}},
 CellTags->
  "mainAgentDecisionLogic",ExpressionUUID->"714b542f-a673-1146-bb6e-\
7e462a3e4d0c"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  RowBox[{"agentActions", "[", "]"}]], "InlineCode",ExpressionUUID->
  "f9738af3-c679-7d48-b0a9-b4d8bb735611"],
 " function is where the bio-energetic decisions and behaviors of agents is \
represented in our simulation. It governs how each agent chooses to use the \
opportunities provided to them in a timestep, depending on the conditions of \
their environment. According to bioenergetics, once an agent is maintained \
and surviving, it allocates its energy towards reproduction, only until after \
then does it focus on accumulating excess energy (Sibly et. al. 2013 [we need \
to figure out how to make references work...]). The agent\[CloseCurlyQuote]s \
main logic follows this."
}], "Text",
 CellChangeTimes->{{3.9866604257842503`*^9, 3.9866605531170216`*^9}, {
   3.986660595513241*^9, 3.986660821477068*^9}, {3.988753407609915*^9, 
   3.9887534260799847`*^9}, {3.9887537793299217`*^9, 3.988753827500107*^9}, {
   3.9887546357399235`*^9, 3.988754694150011*^9}, {3.988754883705036*^9, 
   3.988754886128927*^9}, 3.9887549799790897`*^9, 3.98875514769401*^9, {
   3.9887556321560097`*^9, 3.9887556595481987`*^9}, {3.9887557011418343`*^9, 
   3.988755738810154*^9}},ExpressionUUID->"9293eeb3-3218-c245-bcb9-\
65462f03cf8e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"agentActions", "[", 
   RowBox[{"model_", ",", " ", "params_"}], "]"}], " ", ":=", "  ", 
  RowBox[{"Module", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"model2", " ", "=", " ", "model"}], ",", " ", 
      RowBox[{"agents", " ", "=", " ", 
       RowBox[{"model", "[", "\"\<agents\>\"", "]"}]}], ",", " ", 
      "agentsSnapshot", ",", " ", 
      RowBox[{"foods", " ", "=", " ", 
       RowBox[{"model", "[", "\"\<foods\>\"", "]"}]}], ",", " ", "agent", ",",
       " ", "\n", "    ", "nearFoodDist", ",", " ", "nearFoodI", ",", " ", 
      "nearFoodPos", ",", " ", "nearMateDist", ",", " ", "nearMateI", ",", 
      " ", "nearMatePos"}], "}"}], ",", "\n", "    ", 
    RowBox[{
     RowBox[{"agentsSnapshot", " ", "=", " ", "agents"}], ";", "\n", "\t", 
     RowBox[{"agents", " ", "=", " ", 
      RowBox[{"Table", "[", "\n", "\t\t", 
       RowBox[{
        RowBox[{
         RowBox[{"agent", " ", "=", " ", 
          RowBox[{"agents", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ";", "\n", "\t\t", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "nearFoodDist", ",", " ", "nearFoodI", ",", " ", "nearFoodPos"}], 
           "}"}], " ", "=", " ", 
          RowBox[{"findNearestSensableFoodInfo", "[", 
           RowBox[{"agent", ",", " ", "foods", ",", " ", "params"}], "]"}]}], 
         ";", "\n", "\t\t", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "nearMateDist", ",", " ", "nearMateI", ",", " ", "nearMatePos"}], 
           "}"}], " ", "=", " ", 
          RowBox[{"findNearestSensableMateInfo", "[", 
           RowBox[{"i", ",", " ", "agentsSnapshot", ",", " ", "params"}], 
           "]"}]}], ";", "\n", "\t\t", 
         RowBox[{"Which", "[", "\n", "\t\t\t", 
          RowBox[{
           RowBox[{"And", "[", "\n", "\t\t\t\t", 
            RowBox[{
             RowBox[{
              RowBox[{"agent", "[", "\"\<age\>\"", "]"}], " ", ">", " ", 
              RowBox[{"params", "[", "\"\<minReproductionAge\>\"", "]"}]}], ",",
              "\n", "\t\t\t\t", 
             RowBox[{
              RowBox[{"agent", "[", "\"\<reproductionCooldown\>\"", "]"}], 
              " ", "==", " ", "0"}], ",", "\n", "\t\t\t\t", 
             RowBox[{
              RowBox[{"agent", "[", "\"\<energy\>\"", "]"}], " ", ">", " ", 
              RowBox[{"params", "[", "\"\<minReproductionEnergy\>\"", "]"}]}],
              ",", "\n", "\t\t\t\t", 
             RowBox[{"nearMateI", ">=", "1"}]}], "\n", "\t\t\t", "]"}], ",", 
           "\n", "\t\t\t", 
           RowBox[{
            RowBox[{"agent", " ", "=", " ", 
             RowBox[{"agentSetMateDir", "[", 
              RowBox[{"agent", ",", " ", "nearMatePos", ",", " ", "params"}], 
              "]"}]}], ";", " ", 
            RowBox[{"agent", " ", "=", " ", 
             RowBox[{"explorationOrIntentionalWalk", "[", 
              RowBox[{"agent", ",", " ", "params"}], "]"}]}], ";", " ", 
            "agent"}], ",", "\n", "\t\t\t", "\n", "            ", 
           RowBox[{
            RowBox[{"nearFoodI", ">=", "1"}], " ", "&&", " ", 
            RowBox[{"nearFoodDist", " ", "<", " ", 
             RowBox[{"params", "[", "\"\<proximityRadius\>\"", "]"}]}]}], ",",
            " ", "\n", "\t\t\t", 
           RowBox[{
            RowBox[{"foods", " ", "=", " ", 
             RowBox[{"Delete", "[", 
              RowBox[{"foods", ",", " ", "nearFoodI"}], "]"}]}], ";", " ", 
            RowBox[{"agentEat", "[", 
             RowBox[{"agent", ",", " ", "params"}], "]"}]}], ",", " ", "\n", 
           "\t\t\t", "\n", "\t\t\t", 
           RowBox[{"nearFoodI", ">=", "1"}], ",", "\n", "\t\t\t", 
           RowBox[{
            RowBox[{"agent", " ", "=", " ", 
             RowBox[{"agentSetFoodDir", "[", 
              RowBox[{"agent", ",", " ", "nearFoodPos", ",", " ", "params"}], 
              "]"}]}], ";", " ", 
            RowBox[{"agent", " ", "=", " ", 
             RowBox[{"explorationOrIntentionalWalk", "[", 
              RowBox[{"agent", ",", " ", "params"}], "]"}]}], ";", " ", 
            "agent"}], ",", " ", "\n", "\t\t\t", "\n", "\t\t\t", "True", ",", 
           "\n", "\t\t\t", 
           RowBox[{
            RowBox[{"agent", " ", "=", " ", 
             RowBox[{"agentSetExploreDir", "[", 
              RowBox[{"agent", ",", " ", "params"}], "]"}]}], ";", " ", 
            RowBox[{"agent", " ", "=", " ", 
             RowBox[{"explorationOrIntentionalWalk", "[", 
              RowBox[{"agent", ",", " ", "params"}], "]"}]}], ";", " ", 
            "agent"}]}], "\n", "        ", "]"}]}], ",", "\n", "\t    ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", 
          RowBox[{"Length", "@", "agents"}]}], "}"}]}], "\n", "    ", "]"}]}],
      ";", "\n", "\t", 
     RowBox[{
      RowBox[{"model2", "[", "\"\<foods\>\"", "]"}], " ", "=", " ", "foods"}],
      ";", "\n", "\t", 
     RowBox[{
      RowBox[{"model2", "[", "\"\<agents\>\"", "]"}], " ", "=", " ", 
      "agents"}], ";", "\n", "\t", "model2"}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{
  3.9866608388680496`*^9, 3.9887533960397434`*^9, {3.9887534486697197`*^9, 
   3.988753449019953*^9}},
 CellTags->"agentActions[]",
 CellLabel->"In[21]:=",ExpressionUUID->"eca38961-40b7-7d4a-aa1b-b6045f3bcca4"],

Cell[TextData[{
 "The function iterates through all agents, updating them once they have \
undertaken their actions. First, an agent senses its environment through \
calls to ",
 Cell[BoxData[
  RowBox[{"findNearestSensableFoodInfo", "[", "]"}]], "InlineCode",
  ExpressionUUID->"532ff813-a22e-bb40-bb82-120b132d4c36"],
 " and ",
 Cell[BoxData[
  RowBox[{"findNearestMateInfo", "[", "]"}]], "InlineCode",ExpressionUUID->
  "a82dd470-6177-124d-b2cf-264e481ef2c9"],
 ". Once it has this information, it follows this bioenergetically-informed \
logic: "
}], "Text",
 CellChangeTimes->{{3.988755740937332*^9, 
  3.9887558105118523`*^9}},ExpressionUUID->"3c989aee-9e2e-774d-a5fb-\
4b12337c6431"],

Cell[CellGroupData[{

Cell["\<\
Does an agent meet all the criteria for reproduction with a nearby agent? \
i.e. has it satisfied its needs of maintenance and survival? \
\>", "ItemNumbered",
 CellChangeTimes->{{3.988755831092407*^9, 3.988755959037653*^9}, 
   3.9887560649441433`*^9},ExpressionUUID->"24a96479-a2bd-6c45-9a13-\
c41e2678a64b"],

Cell[TextData[{
 "These criteria are being old enough to reproduce (above the ",
 Cell[BoxData[
  StyleBox["minReproductionAge",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "2cc8a840-2a9f-e44a-85df-20c0914e1718"],
 " parameter), having completed the ",
 Cell[BoxData[
  StyleBox["reproductionCooldown",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "e0ed9426-b83c-e846-b911-0087a28202e3"],
 ", having the ",
 Cell[BoxData[
  StyleBox["minReproductionEnergy",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "da902d78-0f73-c74a-9c19-be769e5ca844"],
 ", and having an agent even near you in the first place. This last one is \
determined from the result of ",
 Cell[BoxData[
  RowBox[{"findNearestMateInfo", "[", "]"}]], "InlineCode",ExpressionUUID->
  "fb5c69bd-1c2b-c24c-8929-5f6fdb30d0a5"],
 ". "
}], "SubitemNumbered",
 CellChangeTimes->{{3.988755831092407*^9, 3.988755863226063*^9}, {
  3.9887559664644203`*^9, 
  3.98875605130694*^9}},ExpressionUUID->"694ae014-e7a4-7d45-b500-\
50daf2e04a03"],

Cell[TextData[{
 "If yes, then ",
 Cell[BoxData[
  RowBox[{"setMateDir", "[", "]"}]], "InlineCode",ExpressionUUID->
  "5454f6fc-97fb-c943-9471-6019eb1ef6d0"],
 "is used to orient the agent towards a mate and ",
 Cell[BoxData[
  RowBox[{"explorationOrIntentionalWalk", "[", "]"}]], "InlineCode",
  ExpressionUUID->"6d850028-1997-bb48-ad70-ce683e8e77c9"],
 "allows it to take one step in the direction of that agent (simply deciding \
which direction to go does not take up a timestep). Reproduction \
automatically happens outside of ",
 Cell[BoxData[
  RowBox[{"agentActions", "[", "]"}]], "InlineCode",ExpressionUUID->
  "ea7088b9-616e-0f4d-aedc-2b6d2134e913"],
 " according to the rules set out in the ",
 StyleBox[ButtonBox["Reproduction",
  BaseStyle->"Hyperlink",
  ButtonData->"Reproduction"],
  FontColor->RGBColor[
   0.8274509803921568, 0.3176470588235294, 0.09803921568627451]],
 " section if agents are near enough, almost like a bonus action."
}], "SubitemNumbered",
 CellChangeTimes->{{3.988755831092407*^9, 3.988755863226063*^9}, {
  3.9887559664644203`*^9, 3.9887560677486897`*^9}, {3.988756223941183*^9, 
  3.988756280166504*^9}, {3.9887565245070133`*^9, 
  3.9887565319397335`*^9}},ExpressionUUID->"d42689d2-6c09-8f4a-a8eb-\
7d85a74a6a4c"],

Cell["If no, then continue", "SubitemNumbered",
 CellChangeTimes->{{3.988755831092407*^9, 3.988755863226063*^9}, {
  3.9887559664644203`*^9, 
  3.988756073997814*^9}},ExpressionUUID->"dc89dc26-8d92-7e4c-afa9-\
4e37cd7a818f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Is the agent near a piece of food and is it close enough to eat it?\
\>", "ItemNumbered",
 CellChangeTimes->{{3.988755831092407*^9, 3.988755863226063*^9}, {
  3.9887559664644203`*^9, 
  3.9887560914459705`*^9}},ExpressionUUID->"d86e3260-3c3c-2c46-9796-\
1447048fdbd7"],

Cell[TextData[{
 "If yes, then eat it, gain some energy, the food is gone. ",
 Cell[BoxData[
  RowBox[{"Delete", "[", "]"}]], "InlineCode",ExpressionUUID->
  "09d34d99-4b42-6e4f-8af2-43bb8478aae8"],
 "is used to delete the food from the ",
 StyleBox["food list ",
  FontWeight->"Bold"],
 "based on the sensory information provided by ",
 Cell[BoxData[
  RowBox[{"findNearestSensableFoodInfo", "[", "]"}]], "InlineCode",
  ExpressionUUID->"0acc26e0-b191-004d-a870-d4ae43c100d2"],
 " (the index along with other information about specific piece of food the \
agent is eating)"
}], "SubitemNumbered",
 CellChangeTimes->{{3.988755831092407*^9, 3.988755863226063*^9}, {
  3.9887559664644203`*^9, 
  3.988756186443386*^9}},ExpressionUUID->"1f239078-f9bf-7e44-ad1d-\
c72231bb50bc"],

Cell["If no, then continue", "SubitemNumbered",
 CellChangeTimes->{{3.988755831092407*^9, 3.988755863226063*^9}, {
  3.9887559664644203`*^9, 
  3.9887561946772575`*^9}},ExpressionUUID->"1c420e02-39d0-1f40-865c-\
6c97e070bb81"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Does the agent even see (sense) any food?", "ItemNumbered",
 CellChangeTimes->{{3.988755831092407*^9, 3.988755863226063*^9}, {
  3.9887559664644203`*^9, 
  3.9887562128412056`*^9}},ExpressionUUID->"45e2a3b0-b1be-3d47-98b7-\
0fccf3bd5bbe"],

Cell[TextData[{
 "If yes, then travel towards it. ",
 Cell[BoxData[
 "agentSetFoodDir"], "InlineCode",ExpressionUUID->
  "736c8918-de9c-d649-8a1c-b4b542621641"],
 " orients the agent towards it, and ",
 Cell[BoxData[
  RowBox[{"explorationOrIntentionalWalk", "[", "]"}]], "InlineCode",
  ExpressionUUID->"08de1b9b-fc42-d44b-a124-e6383e278517"],
 " allows the agent to take one step in that direction (simply deciding which \
direction to go does not take up a timestep)."
}], "SubitemNumbered",
 CellChangeTimes->{{3.988755831092407*^9, 3.988755863226063*^9}, {
  3.9887559664644203`*^9, 3.9887562189748764`*^9}, {3.98875632159219*^9, 
  3.9887563680778694`*^9}},ExpressionUUID->"bf0b7074-60de-ed44-8672-\
8e333992cf3e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Are none of the above true? i.e. does the agent not see any food and does it \
not meet any of the criteria for reproduction?\
\>", "ItemNumbered",
 CellChangeTimes->{{3.988755831092407*^9, 3.988755863226063*^9}, {
  3.9887559664644203`*^9, 3.9887562189748764`*^9}, {3.98875632159219*^9, 
  3.988756399695404*^9}},ExpressionUUID->"69d006a5-a235-fa4a-91f9-\
7973afc26b44"],

Cell[TextData[{
 "The agent will then explore (forage). ",
 Cell[BoxData[
  RowBox[{"agentSetExploreDir", "[", "]"}]], "InlineCode",ExpressionUUID->
  "41cd6072-bde2-3c40-a6e0-4c3c8eb52e2a"],
 " provides the agent with a new random exploration direction if it reaches \
the random probability for direction change, otherwise it will have it \
continue in its current exploration direction. ",
 Cell[BoxData[
  RowBox[{"explorationOrIntentionalWalk", "[", "]"}]], "InlineCode",
  ExpressionUUID->"6111bdbe-2dc0-8748-bd68-6e2d6aaadad6"],
 " allows the agent to take one step in that exploration direction."
}], "SubitemNumbered",
 CellChangeTimes->{{3.988755831092407*^9, 3.988755863226063*^9}, {
  3.9887559664644203`*^9, 3.9887562189748764`*^9}, {3.98875632159219*^9, 
  3.988756434322855*^9}, {3.9887564695110683`*^9, 
  3.9887565453198185`*^9}},ExpressionUUID->"8a3c5944-2742-1b4d-b6cb-\
df0d1629d1b7"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Model Initialization", "Section",
 CellChangeTimes->{{3.9866594107534523`*^9, 3.986659413274023*^9}, {
   3.9887501771415386`*^9, 3.988750181152691*^9}, 3.98875658686977*^9},
 CellTags->
  "modelInitialization",ExpressionUUID->"b82d0072-7288-764d-9bc5-\
0e4a2ba20d41"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  RowBox[{"initializeModel", "[", "]"}]], "InlineCode",ExpressionUUID->
  "a9b064bf-4763-0645-a46e-9ee53e66e8e7"],
 " function returns an initialized model initialized according to the model \
parameters. The data structure for the model is an association that contains \
all the important information about the state of the model. The model has an \
agents list which is a list of all the agent associations in the current \
state of the model, the food list which is that for the food, the current \
bounds of the model, the time at which the model is currently at, and the ",
 StyleBox["nextAgentID",
  FontSlant->"Italic"],
 " identification stored, which operates as described in the ",
 StyleBox[ButtonBox["Reproduction",
  BaseStyle->"Hyperlink",
  ButtonData->"nextAgentIDDescription"],
  FontColor->RGBColor[
   0.8274509803921568, 0.3176470588235294, 0.09803921568627451]],
 " section."
}], "Text",
 CellChangeTimes->{{3.986661089799444*^9, 3.9866611365671673`*^9}, {
  3.986661257236969*^9, 3.986661291288233*^9}, {3.988756588569805*^9, 
  3.9887567288799*^9}, {3.9887573753962097`*^9, 
  3.988757389089926*^9}},ExpressionUUID->"9b006328-d5c7-7443-8349-\
8e06d4e74ae8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"initializeModel", "[", "params_", "]"}], " ", ":=", "\n", "\n", 
  "  ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "agents", ",", " ", "foods", ",", " ", "nStartingAgents", ",", " ", 
      "nStartingFood", ",", " ", "startingEnergy", ",", " ", "min", ",", " ", 
      "max", ",", " ", "randomDir"}], "}"}], ",", "  ", "\n", "\n", "    ", 
    RowBox[{
     RowBox[{"nStartingAgents", " ", "=", " ", 
      RowBox[{"params", "[", "\"\<nStartingAgents\>\"", "]"}]}], ";", " ", 
     RowBox[{"(*", 
      RowBox[{
      "parameter", " ", "for", " ", "number", " ", "of", " ", "agents"}], 
      "*)"}], "\n", "    ", 
     RowBox[{"nStartingFood", " ", "=", " ", 
      RowBox[{"params", "[", "\"\<nStartingFood\>\"", "]"}]}], ";", " ", 
     RowBox[{"(*", 
      RowBox[{
      "parameter", " ", "for", " ", "number", " ", "of", " ", "food", " ", 
       "items"}], "*)"}], "\n", "    ", 
     RowBox[{"startingEnergy", " ", "=", " ", 
      RowBox[{"params", "[", "\"\<startingEnergy\>\"", "]"}]}], ";", "\n", 
     "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"min", ",", " ", "max"}], "}"}], " ", "=", " ", 
      RowBox[{"params", "[", "\"\<squareBounds\>\"", "]"}]}], ";", "\n", "\n",
      "    ", 
     RowBox[{"agents", " ", "=", "\n", "    ", 
      RowBox[{"Table", "[", "\n", "      ", 
       RowBox[{
        RowBox[{
         RowBox[{"randomDir", " ", "=", " ", 
          RowBox[{"RandomReal", "[", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", 
             RowBox[{"2", " ", "Pi"}]}], "}"}], "]"}]}], ";", "\n", "      ", 
         RowBox[{"createAgent", "[", 
          RowBox[{
           RowBox[{"Round", "[", 
            RowBox[{
             RowBox[{"RandomReal", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"min", ",", " ", "max"}], "}"}], ",", " ", "2"}], 
              "]"}], ",", " ", 
             RowBox[{"params", "[", "\"\<rnd\>\"", "]"}]}], "]"}], ",", " ", 
           "startingEnergy", ",", " ", "0.0", ",", " ", "i", ",", " ", 
           RowBox[{"Round", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Cos", "[", "randomDir", "]"}], ",", " ", 
               RowBox[{"Sin", "[", "randomDir", "]"}]}], "}"}], ",", " ", 
             RowBox[{"params", "[", "\"\<rnd\>\"", "]"}]}], "]"}], ",", " ", 
           RowBox[{"params", "[", "\"\<reproductionCooldown\>\"", "]"}]}], 
          "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "nStartingAgents"}], "}"}]}], "\n", "    ", 
       "]"}]}], ";", "\n", "\n", "    ", 
     RowBox[{"foods", " ", "=", " ", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"RandomReal", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"min", ",", " ", "max"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"nStartingFood", ",", " ", "2"}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"params", "[", "\"\<rnd\>\"", "]"}]}], "]"}]}], ";", "\n", 
     "\t", "\n", "    ", 
     RowBox[{"<|", " ", "\n", "      ", 
      RowBox[{
       RowBox[{"\"\<agents\>\"", " ", "->", " ", "agents"}], ",", " ", 
       RowBox[{"(*", 
        RowBox[{"list", " ", "of", " ", "agent", " ", "associations"}], 
        "*)"}], "\n", "      ", 
       RowBox[{"\"\<foods\>\"", " ", "->", " ", "foods"}], ",", " ", 
       RowBox[{"(*", 
        RowBox[{"list", " ", "of", " ", "food", " ", "coordinates"}], "*)"}], 
       "\n", "      ", 
       RowBox[{"\"\<bounds\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"min", ",", " ", "max"}], "}"}]}], ",", "\n", "      ", 
       RowBox[{"\"\<time\>\"", " ", "->", " ", "0"}], ",", "\n", "      ", 
       RowBox[{"\"\<nextAgentID\>\"", " ", "->", " ", 
        RowBox[{"nStartingAgents", " ", "+", " ", "1"}]}]}], "\n", "    ", 
      "|>"}]}]}], "\n", " ", "]"}]}]], "Code",
 CellChangeTimes->{3.9866613044917526`*^9, 3.988758859485359*^9},
 CellTags->"initializeModel[]",
 CellLabel->"In[22]:=",ExpressionUUID->"a619ae0a-10c1-f34d-8a31-d34f470115a2"],

Cell["\<\
The association returned is the model with the association data structure as \
described above.\
\>", "CodeText",
 CellChangeTimes->{{3.986661316472624*^9, 3.9866614107791843`*^9}, {
  3.9887501876497593`*^9, 3.9887501956000023`*^9}, {3.988756576600004*^9, 
  3.988756581959297*^9}},ExpressionUUID->"e6de19c0-d810-bd4c-a628-\
cd7dcf3cb3fa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Model Propagation", "Section",
 CellChangeTimes->{{3.9821922407373047`*^9, 3.9821922594191017`*^9}, 
   3.982869223867647*^9, 3.982947604009659*^9, {3.9861326932163754`*^9, 
   3.9861326935201855`*^9}},ExpressionUUID->"da42a107-5a94-c44b-88f7-\
cc5b76916bdb"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  RowBox[{"propagateModelStep", "[", "]"}]], "InlineCode",ExpressionUUID->
  "87ba9a72-d34e-4b48-b731-598e1a3c9278"],
 " function propagates the model by one timestep, doing the operations that \
occur during a timestep sequentially: spawning food if it\[CloseCurlyQuote]s \
the appropriate time,  removing agents that are dead and randomizing their \
order of priority for competition between similar mates and pieces of food, \
doing the main agent action decision logic, decrementing reproduction ",
 StyleBox["cooldowns",
  IgnoreSpellCheck->True],
 ", performing the reproduction bonus action, subtracting energy for \
metabolism, aging agents, and finally advancing the stored time in the \
simulation."
}], "Text",
 CellChangeTimes->{{3.9866615011262493`*^9, 3.9866616696780376`*^9}, {
  3.986661714886631*^9, 3.9866617192814503`*^9}, {3.986662215385935*^9, 
  3.986662218980051*^9}, {3.9887567709597836`*^9, 
  3.988756830212118*^9}},ExpressionUUID->"4e7e6690-c989-5f45-b5d6-\
389356334b1a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"propagateModelStep", "[", 
    RowBox[{"params_", ",", " ", "model_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"model2", "=", "model"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"model2", " ", "=", " ", 
       RowBox[{"spawnFoodCheck", "[", 
        RowBox[{"model2", ",", " ", "params"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"model2", " ", "=", " ", 
       RowBox[{"randomizeAndKill", "[", 
        RowBox[{"model2", ",", " ", "params"}], "]"}]}], ";", " ", 
      RowBox[{"(*", "randomization", "*)"}], "\n", "  ", 
      RowBox[{"model2", " ", "=", " ", 
       RowBox[{"agentActions", "[", 
        RowBox[{"model2", ",", " ", "params"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"model2", " ", "=", " ", 
       RowBox[{"decrementReproductionCooldowns", "[", 
        RowBox[{"model2", ",", " ", "params"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"model2", " ", "=", " ", 
       RowBox[{"reproduceAgents", "[", 
        RowBox[{"model2", ",", " ", "params"}], "]"}]}], ";", " ", "\n", "  ", 
      RowBox[{"model2", " ", "=", " ", 
       RowBox[{"metabolizeAgents", "[", 
        RowBox[{"model2", ",", " ", "params"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"model2", " ", "=", " ", 
       RowBox[{"ageAgents", "[", 
        RowBox[{"model2", ",", " ", "params"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{
       RowBox[{"model2", "[", "\"\<time\>\"", "]"}], " ", "=", " ", 
       RowBox[{
        RowBox[{"model2", "[", "\"\<time\>\"", "]"}], " ", "+", " ", 
        RowBox[{"params", "[", "\"\<dt\>\"", "]"}]}]}], ";", "\n", "  ", 
      "model2"}]}], "\n", " ", "]"}]}], ";"}]], "Code",
 CellChangeTimes->{{3.98666169419738*^9, 3.9866617043452415`*^9}, 
   3.9887567511097736`*^9},
 CellLabel->"In[23]:=",ExpressionUUID->"a3547cd4-b0d8-4743-8d84-3a1332c06cbe"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"genSimulationStates", "[", "]"}]], "InlineCode",ExpressionUUID->
  "3b93a624-4bea-c548-946b-0601aad955a5"],
 " is used to generate the entire simulation, which becomes a list of model \
states, with each index in the list being being a model object representing \
the state of the simulation after an amount of time steps that is that index."
}], "Text",
 CellChangeTimes->{{3.9866621870938053`*^9, 3.9866621969749737`*^9}, {
  3.986662247370226*^9, 3.986662332443018*^9}, {3.9887568807699623`*^9, 
  3.988756880805071*^9}},ExpressionUUID->"93a67f07-9618-2348-b20e-\
5fb56b717616"],

Cell[BoxData[
 RowBox[{
  RowBox[{"genSimulationStates", "[", 
   RowBox[{"params_", ",", " ", "model_", ",", " ", "timesteps_"}], "]"}], 
  " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"model2", " ", "=", " ", "model"}], "}"}], ",", " ", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", "model", "}"}], ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"model2", " ", "=", " ", 
          RowBox[{"propagateModelStep", "[", 
           RowBox[{"params", ",", " ", "model2"}], "]"}]}], ";", "model2"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", " ", "timesteps"}], "}"}]}], "]"}]}], "]"}]}], 
   "]"}]}]], "Code",
 CellChangeTimes->{3.9866623448382454`*^9},
 CellLabel->"In[24]:=",ExpressionUUID->"0682c969-ad9b-6d4c-baf3-ecbb16dba00c"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"genSimulationStates", "[", "]"}]], "InlineCode",ExpressionUUID->
  "ad4cbd31-4d71-4544-8759-431f52a3981c"],
 " performs its operations on a supplied ",
 StyleBox["model ",
  FontWeight->"Bold"],
 "object. As such, ",
 Cell[BoxData[
  RowBox[{"initializeModel", "[", "]"}]], "InlineCode",ExpressionUUID->
  "09d729fe-21a8-3c4f-b398-6c72c2950d2c"],
 "must be called to initialize such a model if one does not already exist \
(first starting a simulation). ",
 Cell[BoxData[
  RowBox[{"genSimulation", "[", "]"}]], "InlineCode",ExpressionUUID->
  "4a25765b-73d4-7843-874a-d78f9f5298ae"],
 " is a function that just does this as well for ease of use."
}], "Text",
 CellChangeTimes->{{3.9887568750300484`*^9, 
  3.9887569678201656`*^9}},ExpressionUUID->"b700a754-bd84-1147-9492-\
1e164b7ea6a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"genSimulation", "[", 
   RowBox[{"params_", ",", " ", "tsteps_"}], "]"}], " ", ":=", " ", 
  RowBox[{"genSimulationStates", "[", 
   RowBox[{"params", ",", " ", 
    RowBox[{"initializeModel", "[", "params", "]"}], ",", " ", "tsteps"}], 
   "]"}]}]], "Code",
 CellChangeTimes->{3.9887569823298874`*^9},
 CellLabel->"In[25]:=",ExpressionUUID->"cbe154f8-b81b-b947-89b7-d4de49b9a0a2"],

Cell[TextData[{
 "These are then rendered frame by frame, for visualization purposes, or this \
simulation data is exported for data analysis. For experiments and exporting \
simulations, we use the .wdx format because it is significantly more \
compressed than .csv files and created two custom import functions for our \
simulation data based off of Wolfram\[CloseCurlyQuote]s native ",
 Cell[BoxData[
  RowBox[{"Import", "[", "]"}]], "InlineCode",ExpressionUUID->
  "8638113b-aa3a-9e49-af81-fe1b007f9450"],
 " and ",
 Cell[BoxData[
  RowBox[{"Export", "[", "]"}]], "InlineCode",ExpressionUUID->
  "4aa46821-07e5-7f4b-a965-4da9a6746a71"],
 " functions. Those are not discussed here but can be seen in the project \
Github repository [make sure to link that somewhere]."
}], "Text",
 CellChangeTimes->{{3.9866623512721634`*^9, 3.9866623786389427`*^9}, {
  3.9887570095490723`*^9, 3.988757090816078*^9}, {3.9887574479797783`*^9, 
  3.9887574750729313`*^9}},ExpressionUUID->"40108999-01c4-bb42-8eec-\
be348df6bb88"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Producing the Simulation Object", "Section",
 CellChangeTimes->{{3.988757499170105*^9, 3.98875751015971*^9}, {
  3.988757833567087*^9, 
  3.988757839651209*^9}},ExpressionUUID->"e2bbbe8e-424d-dd40-a432-\
4c5d67077d8b"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"genSimulation", "[", "]"}]], "InlineCode",ExpressionUUID->
  "6a8732ab-8feb-f245-b687-8e3485c2b03e"],
 " is ran with the desired amount of timesteps as a parameter to produce the \
simulation object, stored in a variable. For example, here it is stored in \
the variable ",
 Cell[BoxData[
 "Simulation1"], "InlineCode",ExpressionUUID->
  "36942e55-9624-2641-9f89-c0fee928bb89"],
 " and ran for 1000 timesteps, a relatively small amount in comparison to the \
potential of the toolbox (please give it a maximum of 1 minute to run). \
Evidently, the parameters used here were those defined at the top of this \
essay in ",
 StyleBox[ButtonBox["Model Parameters",
  BaseStyle->"Hyperlink",
  ButtonData->"modelParams"],
  FontColor->RGBColor[
   0.792156862745098, 0.3176470588235294, 0.09803921568627451]],
 "."
}], "Text",
 CellChangeTimes->{{3.9887575366400948`*^9, 3.9887575386201706`*^9}, {
  3.9887577852901*^9, 3.9887579181399174`*^9}, {3.988757956719881*^9, 
  3.9887579605302105`*^9}, {3.988758148147169*^9, 3.988758155510153*^9}, {
  3.9887582265603256`*^9, 3.988758237654085*^9}, {3.988758316839945*^9, 
  3.988758316903448*^9}, {3.9887592349747963`*^9, 
  3.9887592384247055`*^9}},ExpressionUUID->"f49b3bf5-3239-e849-8941-\
91316b7d7d0d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Simulation1000", " ", "=", " ", 
   RowBox[{"genSimulation", "[", 
    RowBox[{"parameters", ",", " ", "1000"}], "]"}]}], ";"}]], "Code",
 CellChangeTimes->{{3.9887579332459335`*^9, 3.9887579517628956`*^9}, 
   3.988757988504694*^9, {3.9887581456424503`*^9, 3.9887581463998737`*^9}, {
   3.9887582570702305`*^9, 3.988758280853157*^9}, {3.9887586448557987`*^9, 
   3.9887587021178226`*^9}, {3.988758747439646*^9, 3.988758760283142*^9}, {
   3.988758796057108*^9, 3.9887588740657578`*^9}, {3.9887592179450684`*^9, 
   3.988759219006441*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"318953be-c1be-b846-8429-890f4495b9ef"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Analysis", "Section",
 CellChangeTimes->{{3.9887582966700554`*^9, 
  3.9887582973107834`*^9}},ExpressionUUID->"8ab076ed-93e8-a440-a4ff-\
cd9dd3258c35"],

Cell[TextData[{
 "With our toolbox, there are built in functions for analysis of simulations \
and the potential for many more to be created by the user. The first and \
foremost tool is the ",
 Cell[BoxData[
  RowBox[{"plotPopulationStats", "[", "]"}]], "InlineCode",ExpressionUUID->
  "68cebf14-3a37-1641-a47d-6946311ef8c8"],
 " function which plots the population and food count of a simulation over \
its history."
}], "Text",
 CellChangeTimes->{{3.988758337491148*^9, 3.988758435539812*^9}, {
  3.9887597422887363`*^9, 
  3.9887597432782173`*^9}},ExpressionUUID->"c2a5e3e8-62a9-814f-9b8b-\
9a4cbebbd1ff"],

Cell[BoxData[
 RowBox[{
  RowBox[{"plotPopulationStats", "[", "simulation_List", "]"}], " ", ":=", 
  " ", 
  RowBox[{"Module", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"times", ",", " ", "agentCounts", ",", " ", "foodCounts"}], 
     "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{"times", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", "\"\<time\>\"", "]"}], " ", "&"}], " ", "/@", " ", 
       "simulation"}]}], ";", "\n", "  ", 
     RowBox[{"agentCounts", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"#", "[", "\"\<agents\>\"", "]"}], "]"}], " ", "&"}], " ", "/@",
        " ", "simulation"}]}], ";", "\n", "  ", 
     RowBox[{"foodCounts", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"#", "[", "\"\<foods\>\"", "]"}], "]"}], " ", "&"}], " ", "/@",
        " ", "simulation"}]}], ";", "\n", "\n", "  ", 
     RowBox[{"ListLinePlot", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"agentCounts", ",", " ", "foodCounts"}], "}"}], ",", "\n", 
       "    ", 
       RowBox[{"DataRange", "  ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"First", "[", "times", "]"}], ",", " ", 
          RowBox[{"Last", "[", "times", "]"}]}], "}"}]}], ",", "\n", "    ", 
       RowBox[{"PlotLegends", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Agents\>\"", ",", " ", "\"\<Food\>\""}], "}"}]}], ",", 
       "\n", "    ", 
       RowBox[{"PlotStyle", "  ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"Blue", ",", " ", "Green"}], "}"}]}], ",", "\n", "    ", 
       RowBox[{"AxesLabel", "  ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Time\>\"", ",", " ", "\"\<Count\>\""}], "}"}]}], ",", 
       "\n", "    ", 
       RowBox[{"PlotLabel", "  ", "->", " ", "\"\<Population Over Time\>\""}],
        ",", "\n", "    ", 
       RowBox[{"GridLines", "  ", "->", " ", "Automatic"}], ",", "\n", "    ", 
       RowBox[{"ImageSize", "  ", "->", " ", "500"}]}], "\n", "  ", "]"}]}]}],
    "\n", "]"}]}]], "Code",
 CellChangeTimes->{3.988758447075121*^9, 3.9887585601264153`*^9},
 CellLabel->"In[27]:=",ExpressionUUID->"0f8d5ec5-f137-844f-bdf7-0f24e0f5783b"],

Cell[TextData[{
 "Calling this function on the ",
 Cell[BoxData[
 "Simulation1"], "InlineCode",ExpressionUUID->
  "ebe0c0d5-e29d-794d-ba3b-6992f8a0c76f"],
 " object we generated earlier will allow us to see the outcome of the \
simulation we generated with the ",
 Cell[BoxData[
 "parameters"], "InlineCode",ExpressionUUID->
  "bb1167de-f514-894c-a636-904928b21b8f"],
 " that we used. We can observe the characteristic logistic growth behavior \
in the population with fluctuations around the carrying capacity"
}], "Text",
 CellChangeTimes->{{3.9887585723340874`*^9, 3.9887585945124893`*^9}, {
  3.988758898438383*^9, 
  3.9887589196953106`*^9}},ExpressionUUID->"d9f29e95-03a4-f741-97ca-\
f8adfface1b5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"plotPopulationStats", "[", "Simulation1000", "]"}]], "Code",
 CellChangeTimes->{{3.9887586059466953`*^9, 3.9887586116524315`*^9}, {
  3.9887592477547836`*^9, 3.9887592480172615`*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"0578ae2f-f1b9-054c-9ed7-776c6b9603ed"],

