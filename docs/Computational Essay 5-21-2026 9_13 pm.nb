Cell["Data Structures", "Subsection",
 CellChangeTimes->{{3.9866593264565487`*^9, 
  3.9866593293098545`*^9}},ExpressionUUID->"5037cdbf-fa39-404f-a28d-\
e7ae96a5edb6"],

Cell[TextData[{
 "Before the rest of the toolbox was built, the core aspects of the model \
like agents that moved and consumed food were built first. The food in a \
model at any time is represented by a ",
 StyleBox["list",
  FontWeight->"Bold"],
 " of positions of pieces of food. Forthe data structure of the model as a \
whole, see ",
 StyleBox[ButtonBox["Model Initialization",
  BaseStyle->"Hyperlink",
  ButtonData->"modelInitialization"],
  FontColor->RGBColor[
   0.792156862745098, 0.3176470588235294, 0.09803921568627451]],
 ".\n\n",
 Cell[BoxData[
  RowBox[{"createAgent", "[", "]"}]], "InlineCode",ExpressionUUID->
  "9bec44cb-c7ce-8d46-917e-f47b1f34c406"],
 "is used to initialize agent associations. The data structure for agents was \
chosen to be an association so that specific attributes of agents that \
describe their state can be accessed through keys. Each agent attribute is \
commented with a description of its nature"
}], "Text",
 CellChangeTimes->{
  3.986656472112711*^9, {3.9866568045186176`*^9, 3.98665681395512*^9}, {
   3.986657530107088*^9, 3.9866575455782146`*^9}, {3.9866590179394264`*^9, 
   3.98665902418865*^9}, {3.9866591163259716`*^9, 3.9866591324223576`*^9}, {
   3.9866593123730545`*^9, 3.9866593166233063`*^9}, {3.986659369824898*^9, 
   3.9866593993556957`*^9}, {3.988669909998169*^9, 3.9886699729959183`*^9}, {
   3.988670009865801*^9, 3.9886700902819977`*^9}, {3.9886701323339214`*^9, 
   3.9886701398959846`*^9}},
 CellTags->
  "createAgent[]",ExpressionUUID->"10a084c6-a688-6540-a79c-10fafe41d5fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"createAgent", "[", 
   RowBox[{
   "pos_", ",", " ", "energy_", ",", " ", "age_", ",", " ", "id_", ",", " ", 
    "currentDirection_", ",", " ", 
    RowBox[{"parents_", ":", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"-", "1"}]}], "}"}]}], ",", " ", "reproductionCooldown_"}], 
   "]"}], " ", ":=", " ", 
  RowBox[{"<|", "\n", "    ", 
   RowBox[{
    RowBox[{"\"\<pos\>\"", " ", "->", " ", "pos"}], ",", " ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
      "The", " ", "current", " ", "position", " ", "of", " ", "an", " ", 
       "agent", " ", "in", " ", "the", " ", "environment"}], ",", " ", 
      RowBox[{"length", " ", "2", " ", "array"}]}], "*)"}], "\n", "    ", 
    RowBox[{"\"\<energy\>\"", " ", "->", " ", "energy"}], ",", " ", 
    RowBox[{"(*", 
     RowBox[{
     "The", " ", "current", " ", "energy", " ", "of", " ", "an", " ", 
      "agent"}], "*)"}], "\n", "    ", 
    RowBox[{"\"\<age\>\"", " ", "->", " ", "age"}], ",", " ", 
    RowBox[{"(*", 
     RowBox[{
     "The", " ", "current", " ", "age", " ", "of", " ", "an", " ", "agent"}], 
     "*)"}], "\n", "\t", 
    RowBox[{"\"\<id\>\"", " ", "->", " ", "id"}], ",", " ", 
    RowBox[{"(*", 
     RowBox[{
     "A", " ", "unique", " ", "identifer", " ", "given", " ", "to", " ", 
      "each", " ", "agent", " ", "created", " ", "throughout", " ", "the", " ",
       "history", " ", "of", " ", "the", " ", "simulation", " ", "instance"}],
      "*)"}], "\n", "\t", 
    RowBox[{"\"\<currentDirection\>\"", " ", "->", " ", "currentDirection"}], 
    ",", " ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{
       "The", " ", "current", " ", "direction", " ", "the", " ", "agent", " ",
         "is", " ", "exploring", " ", "in", " ", "or", " ", "seeking", " ", 
        RowBox[{"food", "/", "mates"}], " ", "in"}], ";", " ", 
       RowBox[{"value", " ", 
        RowBox[{"from", " ", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"2", "pi"}]}]}]}]}], ")"}], "*)"}], "\n", "\t", 
    RowBox[{"\"\<parents\>\"", " ", "->", " ", "parents"}], ",", " ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"The", " ", "ids", " ", "of", " ", "the", " ", 
       RowBox[{"agent", "'"}], "s", " ", "parents", " ", "in", " ", "a", " ", 
       "length", " ", "2", " ", 
       RowBox[{"array", ".", " ", "If"}], " ", "the", " ", "agent", " ", "is",
        " ", "one", " ", "of", " ", "the", " ", "primordial", " ", "starting",
        " ", "agents"}], ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], " ", "is", " ", "given", " ", "to", " ",
        "this", " ", 
       RowBox[{"value", ".", "\n", "\t", "used"}], " ", "to", " ", 
       "determine", " ", "familial", " ", "relations", " ", "for", " ", "the",
        " ", "purpose", " ", "of", " ", "incest", " ", 
       RowBox[{"prevention", "--"}], "a", " ", "parent", " ", "will", " ", 
       "naturally", " ", "not", " ", "reproduce", " ", "with", " ", "their", " ",
        "child", " ", "throughout", " ", "almost", " ", "all", " ", 
       "species"}]}], "*)"}], "\n", "    ", 
    RowBox[{"\"\<reproductionCooldown\>\"", " ", "->", " ", 
     "reproductionCooldown"}]}], "\n", "|>"}]}]], "Code",
 CellChangeTimes->{
  3.986656699328575*^9, {3.9866568535934486`*^9, 3.9866569508927803`*^9}, {
   3.9866570394348106`*^9, 3.9866570581597443`*^9}, {3.9886701758241463`*^9, 
   3.9886702754201374`*^9}},ExpressionUUID->"142145c4-95bc-4c4d-b9f0-\
ab021346b21d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Core Functions", "Subsection",
 CellChangeTimes->{{3.98665934884626*^9, 
  3.9866593542909927`*^9}},ExpressionUUID->"eba76386-d2a1-ca45-b667-\
