              RowBox[{"Round", "[", 
               RowBox[{"0.018", " ", 
                RowBox[{"params", "[", "\"\<imageSize\>\"", "]"}]}], "]"}]}], 
             "]"}], ",", "txtColor", ",", "Bold"}], "]"}], ",", "pos"}], 
         "]"}], ",", "\n", " ", 
        RowBox[{"If", "[", 
