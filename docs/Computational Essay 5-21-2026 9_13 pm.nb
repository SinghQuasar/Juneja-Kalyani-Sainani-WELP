Cell["\<\
Finally, we use the following snippet to produce the visualization.\
\>", "Text",
 CellChangeTimes->{{3.9858901575728264`*^9, 3.9858901682850113`*^9}, {
  3.9861341086924744`*^9, 
  3.986134114536669*^9}},ExpressionUUID->"ecb7e4cb-0e94-b941-9065-\
957c7a6707e8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"model", " ", "=", " ", 
   RowBox[{"initializeModel", "[", "parameters", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Simulation", " ", "=", " ", 
   RowBox[{"genSimulationStates", "[", 
    RowBox[{"parameters", ",", " ", "model", ",", " ", "100"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"simulationGraphics", " ", "=", " ", 
    RowBox[{"renderSimulation", "[", 
     RowBox[{"Simulation", ",", " ", "parameters"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Manipulate", "[", 
   RowBox[{
    RowBox[{"simulationGraphics", "[", 
     RowBox[{"[", "j", "]"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"j", ",", " ", "1", ",", " ", 
      RowBox[{"Length", "@", "simulationGraphics"}], ",", " ", "1", ",", " ", 
      RowBox[{"Appearance", "->", "Labeled"}]}], "}"}]}], "]"}], "\n"}], "\n", 
 RowBox[{"plotPopulationStats", "[", "Simulation", "]"}]}], "Code",
 CellChangeTimes->{3.9858898779718285`*^9},
 CellLabel->
  "In[175]:=",ExpressionUUID->"18f90581-64e1-ae40-829f-2895fc932be8"],

