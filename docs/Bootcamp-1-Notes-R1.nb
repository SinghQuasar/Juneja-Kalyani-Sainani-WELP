     RowBox[{"\"\<foodSize\>\"", " ", "->", " ", "0.0075"}], ",", "\n", "   ",
      "\n", "   ", 
     RowBox[{"(*", " ", "Reproduction", " ", "*)"}], "\n", "   ", 
     RowBox[{"\"\<reproductionRadius\>\"", " ", "->", " ", "1.0"}], ",", "\n",
