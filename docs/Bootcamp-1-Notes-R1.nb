Cell[CellGroupData[{
Cell[TextData[StyleBox["Investigating Ecological Energy and Colony Population \
Dynamics with Agent-Based Modeling Systems",
 Background->RGBColor[0, 0.74, 0.74, 0.33]]], "Title",
 CellChangeTimes->{{3.9821898656762505`*^9, 3.9821898716910725`*^9}, {
   3.9821909533992023`*^9, 3.9821909930457573`*^9}, {3.9886678056455383`*^9, 
   3.988667806978819*^9}, 3.9899605608574295`*^9, {3.989962184225155*^9, 
   3.989962189706373*^9}},ExpressionUUID->"02689de0-ed57-420c-a5cc-\
cd98dfbd8a90"],

Cell[TextData[{
 StyleBox["Yash",
  IgnoreSpellCheck->True],
 " Juneja, Om Kalyani, and Shreraj Sainani - WELP 2025-26"
}], "Subtitle",
 CellChangeTimes->{{3.986656627200224*^9, 
  3.9866566778538074`*^9}},ExpressionUUID->"b41e6759-2aea-4b66-b4b9-\
c3d6b5be7683"],

Cell[CellGroupData[{

Cell["Abstract", "Section",
 CellChangeTimes->{{3.9821910469212837`*^9, 3.9821910577482967`*^9}, {
  3.982191106682844*^9, 3.982191126018154*^9}, {3.982191398995737*^9, 
  3.9821914059070625`*^9}},ExpressionUUID->"d842eb1f-5335-4633-84b0-\
b9af8d4cf1c9"],

Cell[TextData[{
 "\tIn this work, we present a custom bioenergetics-informed ecological \
Agent-Based Modeling (ABM) toolbox for colonies of artificial organisms in \
the Wolfram Language.",
 StyleBox[" We investigated ",
  Background->RGBColor[0, 0.74, 0.74, 0.33]],
 " energy and population dynamics with connections to real-world biology \
using this toolbox. Unlike previous Agent-Based Modeling projects done in the \
Wolfram Language, ",
 StyleBox["our",
  Background->RGBColor[0, 0.74, 0.74, 0.33]],
 " interactive toolbox provides the user with the ability to change and \
visualize the effects of ",
 StyleBox["the ",
  Background->RGBColor[0, 0.74, 0.74, 0.33]],
 "parameters ",
 StyleBox["used by the",
  Background->RGBColor[0, 0.74, 0.74, 0.33]],
 " artificial colonies such as resolution of simulation time-discretization, \
sensing and interaction abilities of organisms, metabolic rates, lifespans, \
exploration/foraging behaviors, reproductive frequencies, and bioenergetics \
like digestion and reproduction energies.",
 StyleBox[" ",
  FontVariations->{"StrikeThrough"->True}],
 StyleBox["Our tests ",
  Background->RGBColor[0, 0.74, 0.74, 0.33]],
 "show that ecological models produced by the toolbox mimic population \
dynamics on a macro-level ",
 StyleBox["as ",
  Background->RGBColor[0, 0.74, 0.74, 0.33]],
 "seen in real-world ecology through experimentation on metabolic rates, \
primary production rates, caloric densities and reproductive frequencies with \
a logistic analysis of population growth and collection of other demographic \
data."
}], "Text",
 CellChangeTimes->{{3.9821914125019894`*^9, 3.9821914624889736`*^9}, {
  3.9886678201103325`*^9, 3.9886678217355022`*^9}, {3.989440320680421*^9, 
  3.989440393967486*^9}, {3.989440600540518*^9, 3.98944060090436*^9}, {
  3.989440643266303*^9, 3.989440643844903*^9}, {3.9894406750947866`*^9, 
  3.98944071306076*^9}, {3.989440765961154*^9, 3.98944079422965*^9}, {
  3.989960592538004*^9, 
  3.9899606378792057`*^9}},ExpressionUUID->"e65a0956-bc5e-432a-9650-\
22d3560cd59f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Introduction", "Section",
 CellChangeTimes->{{3.98219114556913*^9, 
  3.9821911516783543`*^9}},ExpressionUUID->"d7283059-85df-42bb-8047-\
b2ad951a8a1d"],

Cell["\<\
\tWe developed an agent-based modeling toolbox to study how simple \
bioenergetic rules shape population-level dynamics. In the model, individual \
agents move through an environment bounded by a square, sense food, interact \
with other agents, consume energy, reproduce, age, and die. Each agent \
follows relatively simple rules, and the population as a whole can show \
certain emergent behaviors that will be discussed in this study, such as \
logistic growth, carrying capacity, variation in reproduction timing, and \
differences in mortality. With this \[OpenCurlyQuote]toolbox,\
\[CloseCurlyQuote] we test how environmental and biological parameters affect \
population outcomes. Specifically, we vary factors such as food availability, \
metabolism, reproduction energy cost, and reproduction age, then record their \
effects on population size, carrying capacity, growth rate, first \
reproduction age, and lifespan. Since our model has limited space that \
introduces competition between agents (if two agents attempt to eat the same \
food it is determined randomly which eats it) and a constrained amount of \
food that is spawned (simulating primary production in an ecosystem), the \
environment has a limited potential for growth, and the populations of our \
colonies naturally trend towards logistic growth. Logistic growth is governed \
by the following differential equation:\
\>", "Text",
 CellChangeTimes->{{3.9861323120985794`*^9, 3.9861323179159927`*^9}, 
   3.9861323561213703`*^9, {3.9861327597572536`*^9, 3.9861328696856537`*^9}, {
   3.986132940158207*^9, 3.9861329886130104`*^9}, {3.986133114661625*^9, 
   3.986133161320118*^9}, {3.9861334921382465`*^9, 3.9861335766738815`*^9}, {
   3.986133761947159*^9, 3.986133790376301*^9}, {3.988667841027857*^9, 
   3.9886679197390842`*^9}, {3.988667974136898*^9, 3.9886679784752083`*^9}, {
   3.9886680190840263`*^9, 3.9886680195578976`*^9}, {3.9887490806700535`*^9, 
   3.988749088959692*^9}, {3.989961295641487*^9, 3.989961463365324*^9}, {
   3.989961573173828*^9, 
   3.9899615904358597`*^9}},ExpressionUUID->"3587290d-bece-46c5-8242-\
9f95891e125e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     FractionBox["dP", "dt"], "=", " ", 
     RowBox[{"rP", "(", 
      RowBox[{"1", "-", 
       FractionBox["P", "K"]}], ")"}]}],
    FontSize->18], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "4eee1864-7805-4d28-92bf-63b31dd2259d"],
 "\t\t(1)"
}], "Text",
 CellChangeTimes->{{3.988667983903784*^9, 3.9886679854296*^9}, {
  3.9886680432898235`*^9, 3.988668062317316*^9}, {3.988668577821993*^9, 
  3.988668583097761*^9}},
 TextAlignment->Center,ExpressionUUID->"350250c6-ff3a-42a4-82c3-88feae1c5cba"],

Cell["\<\
Separating and integrating this differential equation gives the form that we \
use among other curves to fit to our population data among other data for \
analysis\
\>", "Text",
 CellChangeTimes->{{3.9886680218284607`*^9, 3.9886680339560013`*^9}, {
   3.9886680871550217`*^9, 3.9886684035609074`*^9}, {3.9886684564480705`*^9, 
   3.9886684692912884`*^9}, 3.9886687350280476`*^9, {3.98874911295286*^9, 
   3.988749115919861*^9}, 3.9899617638005257`*^9, 
   3.9899618077258244`*^9},ExpressionUUID->"8ad7c49c-4f9d-4a4e-afb9-\
51feb8ad011c"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", "t", ")"}], "=", " ", 
    FractionBox["K", 
     RowBox[{"1", 
      StyleBox[" ",
       FontSlant->"Italic"], "+", 
      StyleBox[" ",
       FontSlant->"Italic"], 
      StyleBox[
       SuperscriptBox["Ae", 
        RowBox[{
         RowBox[{"-", "r"}], " ", "t"}]],
       FontSlant->"Italic"]}]]}], TraditionalForm]],
  FontSize->18,ExpressionUUID->"6cb4674f-ad40-42f2-868e-d5c6b9cc36e0"],
 StyleBox["\t\t",
  FontSize->18],
 StyleBox["(2)",
  FontSize->15]
}], "Text",
 CellChangeTimes->{{3.9886685755629025`*^9, 3.988668600000784*^9}, {
  3.988668638795864*^9, 3.9886686964579735`*^9}},
 TextAlignment->Center,ExpressionUUID->"5bfa2977-ddeb-4f67-861a-3f9c1f26506d"],

Cell["\<\
Where K represents carrying capacity, r represents intrinsic growth rate, and \
A represents the relationship between the initial population and carrying \
capacity. These variables allow us to compare how different parameter values \
affect population-level behavior as a whole.

\tOverall, through these experiments, we show how simple rules can influence \
a population\[CloseCurlyQuote]s dynamics and characteristics, and how our \
Agent-Based Modeling toolbox can be used as a flexible foundation for \
studying further ecological systems and emergent population-level and \
agent-level behaviors not only because it exhibits such behavior like \
logistic growth, but also because of its flexibility from the infinite \
possibilities its large number of customizable parameters provides.\
\>", "Text",
 CellChangeTimes->{{3.988668728888998*^9, 3.9886687455668926`*^9}, {
  3.988668869889372*^9, 3.988668895236967*^9}, {3.988748980369911*^9, 
  3.988749056459652*^9}, {3.9899618187267056`*^9, 
  3.989961884717642*^9}},ExpressionUUID->"f00b6345-0ecf-4722-9f63-\
e9cfa79e35c5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["High-Level Model Development", "Section",
 CellChangeTimes->{{3.9821913146818466`*^9, 3.9821913242147045`*^9}, {
  3.982192215691025*^9, 3.9821922192738476`*^9}, {3.9861321372110233`*^9, 
  3.9861321384283543`*^9}, {3.9861323673518295`*^9, 3.9861323738913193`*^9}, {
  3.986132689062084*^9, 3.9861326893698616`*^9}, {3.9887637607497063`*^9, 
  3.988763762634386*^9}},ExpressionUUID->"3a97bde2-f526-4f1a-accf-\
e10617412bfa"],

Cell["\<\
\tWe designed our Agent-Based model from the ground up to be customizable for \
the user, making it easy to run experiments and test hypotheses. The \
simulation is complete with visuals and animations, showing what\
\[CloseCurlyQuote]s going on behind the raw data. All behavior, except for \
random movement when needed, is deterministic and always based on the \
starting parameters. It is important to note that agents do not \
\[OpenCurlyDoubleQuote]feel\[CloseCurlyDoubleQuote] or are not provided \
\[OpenCurlyDoubleQuote]rewards\[CloseCurlyDoubleQuote] by the simulation. \
Rather, natural selection drives some agents to do better than others, \
causing other agents to die out, showing how certain parameters support life \
better or worse.
\tAgents are organisms with age and energy, must consume resources to \
survive, move, reproduce, and optionally invest energy in offspring. When \
deciding on what action an agent takes every time step, we took inspiration \
from a British Ecological Society paper outlining the general order of \
importance:\
\>", "Text",
 CellChangeTimes->{{3.988763766086323*^9, 
  3.9887637744105415`*^9}},ExpressionUUID->"45ee0957-f92f-4d3e-9ded-\
58a2e5807609"],

Cell["\<\
 \[OpenCurlyDoubleQuote]If there is sufficient energy intake, an animal \
allocates the energy obtained in the order: maintenance, growth, \
reproduction, energy storage, until its energy stores reach an optimal level. \
If there is a shortfall, the priorities for maintenance and \
growth/reproduction remain the same until reserves fall to a critical \
threshold below which all are allocated to maintenance.\
\[CloseCurlyDoubleQuote] - (Cite the paper)\
\>", "Text",
 CellChangeTimes->{{3.9887637804169273`*^9, 3.988763815032461*^9}, {
  3.989441162764399*^9, 3.989441164918106*^9}, {3.9894411957588987`*^9, 
  3.989441202513359*^9}},
 TextAlignment->Center,ExpressionUUID->"efc87982-82f9-43d3-8059-5f6070ba0542"],

Cell["\<\
\tIn our model, agents unavoidably lose energy every time step through \
\[OpenCurlyDoubleQuote]metabolism.\[CloseCurlyDoubleQuote] When deciding to \
take an action, in the agentActions function, we first look at if the agent \
meets all the criteria to reproduce. This includes having enough energy, \
having another non-related agent in the sensing radius, not being on a \
reproduction cooldown, and having existed for long enough. Agents need a \
minimum amount of energy before looking to reproduce because \
growth/sustenance is of a higher priority than reproduction. If there is no \
suitable mate, the agent then looks for food in proximity. If it is close \
enough, it eats it. If not, the agent moves towards the food. And finally, if \
the agent doesn\[CloseCurlyQuote]t see anything in its radius, it picks a \
random exploration direction and walks. The agent has a random chance to \
change directions every time step when exploring, so it is able to more \
effectively explore a single direction before looking elsewhere. If an agent \
tries to leave the bounds, its position is clipped to the bounds, and if it \
is half a step away from the bounds, the direction it is moving in changes. \
The environment supplies food containing energy every timestep to simulate \
primary production (usually plants producing organic matter from sunlight) in \
the ecosystem. Because of this, the organisms we simulate are primary \
consumers.\
\>", "Text",
 CellChangeTimes->{{3.9887637903073177`*^9, 
  3.988763793208187*^9}},ExpressionUUID->"59279a94-cda3-408e-bf7c-\
aec9600ab399"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Model Parameters", "Section",
 CellChangeTimes->{{3.9861346944682255`*^9, 3.986134699014679*^9}, {
  3.9861347846181145`*^9, 3.9861347951362133`*^9}, {3.9861366439729843`*^9, 
  3.9861366489353695`*^9}, {3.9866530520267925`*^9, 3.9866530526883984`*^9}},
 CellTags->
  "modelParams",ExpressionUUID->"6992b3f8-7c11-46d9-9224-bf8117b8a057"],

Cell[TextData[{
 "These are model parameters stored as an association that set the rules for \
a simulation, and a user may freely tweak them to model certain environmental \
scenarios or use these as independent variables to run empirical experiments. \
Most functions of the model take in this parameters ",
 StyleBox["association",
  FontWeight->"Bold"],
 " to understand how they should work and to what extent their functions \
should affect model/agent state. Comments following each parameter outlines \
its purpose. Parameters, and thus the model, is defined in ",
 StyleBox["nondimensionalized",
  FontWeight->"Bold"],
 " arbitrary units: arbitrary distance units denoted (",
 StyleBox["D",
  FontWeight->"Bold"],
 "), arbitrary time units denoted (",
 StyleBox["T",
  FontWeight->"Bold"],
 "), and arbitrary energy units denoted (",
 StyleBox["E",
  FontWeight->"Bold"],
 ") throughout."
}], "Text",
 CellChangeTimes->{
  3.986134702431364*^9, {3.9861349670242786`*^9, 3.9861350151841335`*^9}, {
   3.9866530586789455`*^9, 3.9866530630536213`*^9}, {3.9866539617015514`*^9, 
   3.9866539901637287`*^9}, {3.9866542471128273`*^9, 3.986654249513815*^9}, {
   3.9866543327970047`*^9, 3.986654545327215*^9}, {3.986654578512396*^9, 
   3.986654579597225*^9}, {3.9866546113092575`*^9, 3.9866546690151215`*^9}, {
   3.9866547079760723`*^9, 3.9866547221788425`*^9}, {3.986654994727091*^9, 
   3.986655051410116*^9}, {3.988668795851225*^9, 3.9886688178396187`*^9}, {
   3.9886690538873158`*^9, 3.988669055448925*^9}, 
   3.988753620866991*^9},ExpressionUUID->"5c49e8ae-721e-485a-870a-\
a5f60fd94da8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"parameters", " ", "=", " ", 
   RowBox[{"<|", "\n", "   ", 
    RowBox[{
     RowBox[{"\"\<proximityRadius\>\"", " ", "->", " ", "0.5"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{"How", " ", "close", " ", "two", " ", "things", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"agent", "/", "food"}], ",", " ", 
         RowBox[{"agent", "/", "agent"}]}], ")"}], " ", "need", " ", "to", " ",
        "be", " ", "to", " ", "interact", " ", 
       RowBox[{"(", 
        RowBox[{"eat", ",", " ", "reproduce", ",", " ", 
         RowBox[{"etc", "."}]}], ")"}]}], "*)"}], "\n", "   ", 
     RowBox[{"\"\<sensingDistance\>\"", " ", "->", " ", "4"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
      "How", " ", "far", " ", "agents", " ", "can", " ", "sense", " ", 
       "items"}], "*)"}], "\n", "   ", 
     RowBox[{"\"\<metabolism\>\"", " ", "->", " ", "0.05"}], ",", "\n", "   ", 
     RowBox[{"\"\<dt\>\"", " ", "->", " ", "0.1"}], ",", " ", 
     RowBox[{"(*", "timestep", "*)"}], "\n", "   ", "\n", "   ", 
     RowBox[{"(*", " ", 
      RowBox[{"Food", "/", "environment"}], " ", "*)"}], "\n", "   ", 
     RowBox[{"\"\<foodEnergy\>\"", " ", "->", " ", "5.0"}], ",", "\n", "   ", 
     
     RowBox[{"\"\<foodSpawnCooldown\>\"", " ", "->", " ", "1"}], ",", "\n", 
     "   ", 
     RowBox[{"\"\<nFoodSpawn\>\"", " ", "->", " ", "5"}], ",", "\n", "   ", 
     RowBox[{"\"\<nStartingFood\>\"", " ", "->", " ", "4"}], ",", "\n", "   ",
      "\n", "   ", 
     RowBox[{"(*", " ", 
      RowBox[{"Initial", " ", "population", " ", "and", " ", "movement"}], 
      " ", "*)"}], "\n", "   ", 
     RowBox[{"\"\<nStartingAgents\>\"", " ", "->", " ", "4"}], ",", "\n", 
     "   ", 
     RowBox[{"\"\<squareBounds\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "20"}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"\"\<startingEnergy\>\"", " ", "->", " ", "10"}], ",", "\n", 
     "   ", 
     RowBox[{"\"\<stepLength\>\"", " ", "->", " ", "0.4"}], ",", "\n", "   ", 
     
     RowBox[{"\"\<dirChangeProb\>\"", " ", "->", " ", "0.025"}], ",", "\n", 
     "   ", 
     RowBox[{"\"\<lifespan\>\"", " ", "->", " ", "30"}], ",", "\n", "   ", 
     RowBox[{"\"\<maxEnergy\>\"", " ", "->", " ", "10"}], ",", "\n", "   ", 
     "\n", "   ", 
     RowBox[{"(*", " ", "Visualization", " ", "*)"}], "\n", "   ", 
     RowBox[{"\"\<imageSize\>\"", " ", "->", " ", "500"}], ",", "\n", "   ", 
