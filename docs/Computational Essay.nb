   3.986133808398634*^9}},ExpressionUUID->"c5be0d16-ba53-2546-a6ff-\
79990cc6644d"],

Cell[CellGroupData[{

Cell["Data Structures", "Subsection",
 CellChangeTimes->{{3.9866593264565487`*^9, 
  3.9866593293098545`*^9}},ExpressionUUID->"5037cdbf-fa39-404f-a28d-\
e7ae96a5edb6"],

Cell[TextData[{
 "Before reproductive and parenting functions/strategies were implemented \
into agents, the core aspects of the model like agents that moved and \
consumed food were built first. [move up to data structures ^^] The food in a \
simulation is represented by a list of positions of pieces of food.\n\n",
 Cell[BoxData[
  RowBox[{"createAgent", "[", "]"}]], "InlineCode",ExpressionUUID->
  "9bec44cb-c7ce-8d46-917e-f47b1f34c406"],
 "is used to initialize agent associations. The data structure for agents was \
chosen to be an association so that specific attributes of agents that \
describe their state can be accessed through keys. Each agent attribute is \
commented with a description of its nature"
}], "Text",
 CellChangeTimes->{
  3.986656472112711*^9, {3.9866568045186176`*^9, 3.98665681395512*^9}, {
   3.986657530107088*^9, 3.9866575455782146`*^9}, {3.9866590179394264`*^9, 
   3.98665902418865*^9}, {3.9866591163259716`*^9, 3.9866591324223576`*^9}, {
   3.9866593123730545`*^9, 3.9866593166233063`*^9}, {3.986659369824898*^9, 
   3.9866593993556957`*^9}},ExpressionUUID->"10a084c6-a688-6540-a79c-\
10fafe41d5fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"createAgent", "[", 
   RowBox[{
   "pos_", ",", " ", "energy_", ",", " ", "age_", ",", " ", "id_", ",", " ", 
    "currentDirection_", ",", " ", 
    RowBox[{"parents_", ":", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"-", "1"}]}], "}"}]}], ",", " ", "reporductionCooldown_"}], 
   "]"}], " ", ":=", " ", 
  RowBox[{"<|", "\n", "    ", 
   RowBox[{
    RowBox[{"\"\<pos\>\"", " ", "->", " ", "pos"}], ",", " ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
      "The", " ", "current", " ", "position", " ", "of", " ", "an", " ", 
       "agent"}], ",", " ", 
      RowBox[{"length", " ", "2", " ", "array"}]}], "*)"}], "\n", "    ", 
    RowBox[{"\"\<energy\>\"", " ", "->", " ", "energy"}], ",", " ", 
    RowBox[{"(*", 
     RowBox[{
     "The", " ", "current", " ", "energy", " ", "of", " ", "an", " ", 
      "agent"}], "*)"}], "\n", "    ", 
    RowBox[{"\"\<age\>\"", " ", "->", " ", "age"}], ",", " ", 
    RowBox[{"(*", 
     RowBox[{
     "The", " ", "current", " ", "age", " ", "of", " ", "an", " ", "agent"}], 
     "*)"}], "\n", "\t", 
    RowBox[{"\"\<id\>\"", " ", "->", " ", "id"}], ",", " ", 
    RowBox[{"(*", 
     RowBox[{
     "A", " ", "unique", " ", "identifer", " ", "given", " ", "to", " ", 
      "each", " ", "agent", " ", "created", " ", "throughout", " ", "the", " ",
       "history", " ", "of", " ", "the", " ", "simulation", " ", "instance"}],
      "*)"}], "\n", "\t", 
    RowBox[{"\"\<currentDirection\>\"", " ", "->", " ", "currentDirection"}], 
    ",", " ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{
       "The", " ", "current", " ", "direction", " ", "the", " ", "agent", " ",
         "is", " ", "exploring", " ", "in"}], ";", " ", 
       RowBox[{"value", " ", 
        RowBox[{"from", " ", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"2", "pi"}]}]}]}]}], ")"}], "*)"}], "\n", "\t", 
    RowBox[{"\"\<parents\>\"", " ", "->", " ", "parents"}], ",", " ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"The", " ", "ids", " ", "of", " ", "the", " ", 
       RowBox[{"agent", "'"}], "s", " ", "parents", " ", "in", " ", "a", " ", 
       "length", " ", "2", " ", 
       RowBox[{"array", ".", " ", "If"}], " ", "the", " ", "agent", " ", "is",
        " ", "one", " ", "of", " ", "the", " ", "primordial", " ", "starting",
        " ", "agents"}], ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], " ", "is", " ", "given", " ", "to", " ",
        "this", " ", 
       RowBox[{"value", "."}]}]}], "*)"}], "\n", "    ", 
    RowBox[{"\"\<reproductionCooldown\>\"", " ", "->"}]}], "  ", 
   RowBox[{"(*", 
    RowBox[{
    "Cooldown", " ", "for", " ", "the", " ", "main", " ", "issue", " ", 
     "with", " ", "the"}], " ", "*)"}], "\n", "|>"}]}]], "Code",
 CellChangeTimes->{
  3.986656699328575*^9, {3.9866568535934486`*^9, 3.9866569508927803`*^9}, {
   3.9866570394348106`*^9, 3.9866570581597443`*^9}, {3.9883981386708164`*^9, 
   3.988398190375452*^9}},ExpressionUUID->"142145c4-95bc-4c4d-b9f0-\
ab021346b21d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Core Functions", "Subsection",
 CellChangeTimes->{{3.98665934884626*^9, 
  3.9866593542909927`*^9}},ExpressionUUID->"eba76386-d2a1-ca45-b667-\
e9cf93b946a3"],

Cell["\<\
These functions are the basic operations needed for core model functionality.\
\>", "Text",
 CellChangeTimes->{{3.986659374898609*^9, 
  3.986659389762089*^9}},ExpressionUUID->"668d9dab-c40a-fe4c-af9b-\
84ddd727ec21"],

Cell[TextData[{
 "For any interactions to occur, an object must be within another\
\[CloseCurlyQuote]s ",
 Cell[BoxData[
  StyleBox["proximityRadius",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "4c35badf-89b7-4b40-8235-afce86df8b1f"],
 ".  This goes for an agent and a piece of food, an agent and another agent \
for reproduction, or for a parent and a child."
}], "Text",
 CellChangeTimes->{{3.986133935459646*^9, 3.986134001026058*^9}, {
   3.986134128371048*^9, 3.9861341682006283`*^9}, {3.9861342216344566`*^9, 
   3.986134225347433*^9}, {3.9861354205280743`*^9, 3.986135502323677*^9}, {
   3.9861355479464245`*^9, 3.9861355974950294`*^9}, {3.9866530312050304`*^9, 
   3.9866530321828423`*^9}, {3.986653282381628*^9, 3.9866532827050743`*^9}, {
   3.9866533505385036`*^9, 3.986653351202915*^9}, {3.986654009608753*^9, 
   3.986654026521841*^9}, {3.9866562304426804`*^9, 3.9866562592874737`*^9}, {
   3.9866564609462414`*^9, 3.9866564678113003`*^9}, 
   3.9866565595560265`*^9},ExpressionUUID->"43f7f145-fa31-224c-a685-\
bceff4b4876e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"checkWithinRadius", "[", 
    RowBox[{"p1_", ",", " ", "p2_", ",", " ", "r_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"EuclideanDistance", "[", 
     RowBox[{"p1", ",", " ", "p2"}], "]"}], " ", "<=", " ", "r"}]}], 
  ";"}]], "Code",
 CellChangeTimes->{3.986135602936306*^9},
 CellLabel->"In[2]:=",ExpressionUUID->"f149d8ae-5cdf-7148-be2a-169ee1c31973"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"EuclidianDistance", "[", "]"}]], "InlineCode",ExpressionUUID->
  "2e435b62-7914-a948-a308-871259042531"],
 " is used in the ",
 Cell[BoxData[
  RowBox[{"checkWithinRadius", "[", "]"}]], "InlineCode",ExpressionUUID->
  "8ad64ce0-b9c4-7f48-b3fa-a4913eba8e38"],
 " function to verify the interaction condition of ",
 Cell[BoxData[
  StyleBox["proximityRadius",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "41c5c3c1-b01d-6a4f-b9b5-ad4c2bd0b441"],
 "."
}], "CodeText",
 CellChangeTimes->{{3.9866533764217987`*^9, 3.986653378633711*^9}, {
  3.986653458920767*^9, 3.986653458991089*^9}, {3.9866540988145695`*^9, 
  3.986654101054394*^9}, {3.986656200421219*^9, 3.9866562061620903`*^9}, {
  3.9866565670399513`*^9, 3.9866565803603783`*^9}, {3.9866567216833496`*^9, 
  3.9866567386902485`*^9}, {3.9866591896920757`*^9, 
  3.9866591931780586`*^9}},ExpressionUUID->"7de17ded-2970-d14b-ba66-\
538e4eceb407"],

Cell[TextData[{
 "A function called ",
 Cell[BoxData[
  RowBox[{"findNearestSensableFoodPosAndI", "[", "]"}]], "InlineCode",
  ExpressionUUID->"c26d71fb-578d-c343-93fd-7b06faa7d216"],
 " is used to find the nearest sensable (within ",
 Cell[BoxData[
  StyleBox["sensingDistance",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "acb4512a-f37a-f045-8ca7-fed83c9bc9ab"],
 ") food to an agent and return its position and index given a list of food \
to be considered. [fix this-> it doesn\[CloseCurlyQuote]t return the pos and \
the I, it returns the distance and I]"
}], "Text",
 CellChangeTimes->{{3.986656981652298*^9, 3.9866569925472775`*^9}, {
  3.9866570832146893`*^9, 3.9866571921746902`*^9}, {3.9866609992974873`*^9, 
  3.986661000226021*^9}, {3.9866660723018055`*^9, 
  3.9866661001094913`*^9}},ExpressionUUID->"6c4fc9dc-af10-314e-8f11-\
3220d91f0c2b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"findNearestSensableFoodPosAndI", "[", 
   RowBox[{"agent_", ",", " ", "foodPositions_List", ",", " ", "params_"}], 
   "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "agentPos", ",", " ", "foodPosAndI", ",", " ", 
      "foodsWithinRadiusPosAndI", ",", " ", "dists"}], "}"}], ",", "\n", 
    "    ", 
    RowBox[{
     RowBox[{"agentPos", " ", "=", " ", 
      RowBox[{"agent", "[", "\"\<pos\>\"", "]"}]}], ";", "\n", "    ", 
     RowBox[{"foodPosAndI", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"foodPositions", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", " ", "i"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", 
          RowBox[{"Length", "[", "foodPositions", "]"}]}], "}"}]}], "]"}]}], ";",
      "\n", "    ", 
     RowBox[{"foodsWithinRadiusPosAndI", " ", "=", " ", 
      RowBox[{"Select", "[", 
       RowBox[{"foodPosAndI", ",", " ", 
        RowBox[{
         RowBox[{"checkWithinRadius", "[", 
          RowBox[{"agentPos", ",", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
           RowBox[{"params", "[", "\"\<sensingDistance\>\"", "]"}]}], "]"}], 
         "&"}]}], "]"}]}], ";", "\n", "    ", 
     RowBox[{"If", "[", "\n", "        ", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "foodsWithinRadiusPosAndI", "]"}], " ", "==", 
        " ", "0"}], ",", "\n", "        ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], ",", " ", 
       RowBox[{"(*", 
        RowBox[{"no", " ", "food"}], "*)"}], "\n", "        ", 
       RowBox[{
        RowBox[{"dists", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"EuclideanDistance", "[", 
              RowBox[{"agentPos", ",", " ", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", " ", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], " ", "/@", " ", 
          "foodsWithinRadiusPosAndI"}]}], ";", "\n", "        ", 
        RowBox[{"First", "@", 
         RowBox[{"MinimalBy", "[", 
          RowBox[{"dists", ",", " ", "First"}], "]"}]}]}]}], "\n", "    ", 
      "]"}]}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{
  3.9866572058419514`*^9},ExpressionUUID->"9b0353ea-2fcd-e94e-ac8f-\
ae6f1b0f96a2"],

Cell["\<\
The function first compiles the food positions and indexes, and then isolates \
the ones that are within sensing distance of the agent. If no pieces of food \
make it into that isolation, then there are none within sensing distance and \
{-1, -1} is returned. Else, {closest food\[CloseCurlyQuote]s position, \
closest food\[CloseCurlyQuote]s index in the food list} is returned.\
\>", "CodeText",
 CellChangeTimes->{{3.986657227761652*^9, 3.9866573235387726`*^9}, {
  3.986658968132265*^9, 
  3.986658969049103*^9}},ExpressionUUID->"59887e7b-4161-cb4b-8ec4-\
ed0b0cc93345"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"spawnFoods", "[", "]"}]], "InlineCode",ExpressionUUID->
  "5b8f6ce0-a803-c64e-8e7f-6a47894e66da"],
 "takes in a food list and adds new foods with the amount corresponding to \
the ",
 Cell[BoxData[
  StyleBox["nFoodSpawn",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "290b8198-2f19-1744-9535-dc8eccfddd6c"],
 " parameter."
}], "Text",
 CellChangeTimes->{{3.986657355570282*^9, 3.9866573918809643`*^9}, {
   3.986657471074499*^9, 3.986657524449877*^9}, {3.986658977664772*^9, 
   3.986658996021229*^9}, {3.9866591637581673`*^9, 3.9866591714669056`*^9}, 
   3.986660102583685*^9},ExpressionUUID->"89540473-02b0-2a40-a141-\
d55c082daf0c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"spawnFoods", "[", 
   RowBox[{"foods_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Join", "[", 
   RowBox[{"foods", ",", " ", 
    RowBox[{"RandomReal", "[", 
     RowBox[{
      RowBox[{"params", "[", "\"\<squareBounds\>\"", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"params", "[", "\"\<nFoodSpawn\>\"", "]"}], ",", " ", "2"}], 
       "}"}]}], "]"}]}], "]"}]}]], "Code",
 CellChangeTimes->{
  3.9866592357492294`*^9},ExpressionUUID->"8327f009-68e5-7d40-82c1-\
d38081b5b327"],

Cell[TextData[{
 "To spawn food at the appropriate time, ",
 Cell[BoxData[
  RowBox[{"spawnFoodCheck", "[", "]"}]], "InlineCode",ExpressionUUID->
  "a2dd5c23-6d7d-ef49-81f6-5b54a14c253f"],
 " updates the model\[CloseCurlyQuote]s food list with a ",
 Cell[BoxData[
  RowBox[{"spawnFoods", "[", "]"}]], "InlineCode",ExpressionUUID->
  "8538a2ff-c2d6-e04c-b20b-1b84159e432b"],
 "operation when appropriate according to the ",
 Cell[BoxData[
  StyleBox["foodSpawnCooldown",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "02fd4138-df10-424d-86e7-4e860da4398e"],
 " parameter. "
}], "Text",
 CellChangeTimes->{{3.986659291647358*^9, 3.9866593004645767`*^9}, {
  3.986659464851038*^9, 3.9866594941026287`*^9}, {3.986659527640812*^9, 
  3.9866595341682415`*^9}, {3.986659564969391*^9, 
  3.986659583143572*^9}},ExpressionUUID->"42b7b78c-0cea-2148-9274-\
24f62c0d8a1f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"spawnFoodCheck", "[", 
   RowBox[{"model_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"model2", " ", "=", " ", "model"}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"model2", "[", "\"\<foods\>\"", "]"}], " ", "=", " ", 
      RowBox[{"If", "[", "\n", "        ", 
       RowBox[{
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"model", "[", "\"\<time\>\"", "]"}], ",", " ", 
           RowBox[{"params", "[", "\"\<foodSpawnCooldown\>\"", "]"}]}], "]"}],
          " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}]}]}], ",", "\n", "        ", 
        RowBox[{"spawnFoods", "[", 
         RowBox[{
          RowBox[{"model", "[", "\"\<foods\>\"", "]"}], ",", " ", "params"}], 
         "]"}], ",", "\n", "        ", 
        RowBox[{"model", "[", "\"\<foods\>\"", "]"}]}], "\n", "    ", "]"}]}],
      ";", "\n", "\t", "model2"}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{
  3.986659605352833*^9},ExpressionUUID->"fe82a479-5b2e-cf4e-94dc-\
56936b503ac1"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"<", " ", 
   RowBox[{"10", "^", 
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}]}]}]], "InlineCode",ExpressionUUID->
  "18ec7a0a-b2c0-1b48-90e7-95b986b2013f"],
 " is used instead of ",
 Cell[BoxData[
  RowBox[{"==", " ", "0"}]], "InlineCode",ExpressionUUID->
  "12b03e82-4262-ab49-8fa1-7d149eafbef7"],
 " to not have to worry about integer vs. float mismatch issues."
}], "CodeText",
 CellChangeTimes->{{3.9866596208732586`*^9, 3.9866596853484936`*^9}, 
   3.9866600985061626`*^9},ExpressionUUID->"3a200fe4-e467-2447-87a1-\
f2fc971c2b61"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"randomizeAndKill", "[", "]"}]], "InlineCode",ExpressionUUID->
  "31427485-1ca6-dd4d-8c18-41a90b08620e"],
 " is a simulation management function that kills agents if they\
\[CloseCurlyQuote]ve reached any death conditions and randomizes their order \
by virtue of shuffling the agent list so that no agents are consistently \
prioritized over others during iteration in case two or more agents are near \
the same piece of food or both trying to reproduce with the same agent--the \
operation will be done on whichever comes first, but it is truly random so \
long as the order gets randomized during every timestep."
}], "Text",
 CellChangeTimes->{{3.986659691210705*^9, 
  3.9866598164837513`*^9}},ExpressionUUID->"cae9aa88-1b00-fa4f-b037-\
c556e6d8088e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"randomizeAndKill", "[", 
   RowBox[{"model_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"agents", " ", "=", " ", 
       RowBox[{"model", "[", "\"\<agents\>\"", "]"}]}], ",", " ", 
      RowBox[{"model2", "=", "model"}]}], "}"}], ",", "\t", "\n", "\t", 
    RowBox[{
     RowBox[{"agents", " ", "=", " ", 
      RowBox[{"RandomSample", "[", "agents", "]"}]}], ";", "\n", "\t", 
     RowBox[{
      RowBox[{"model2", "[", "\"\<agents\>\"", "]"}], " ", "=", " ", 
      RowBox[{"Select", "[", 
       RowBox[{"agents", ",", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", "\"\<age\>\"", "]"}], " ", "<", " ", 
            RowBox[{"params", "[", "\"\<lifespan\>\"", "]"}]}], " ", "&&", 
           " ", 
           RowBox[{
            RowBox[{"#", "[", "\"\<energy\>\"", "]"}], " ", ">", " ", "0"}]}],
           ")"}], "&"}]}], "]"}]}], ";", "\n", "\t", "model2"}]}], "\n", 
   "]"}]}]], "Code",
 CellChangeTimes->{
  3.986659840460924*^9},ExpressionUUID->"2d2f1246-f031-9b44-9473-\
ef6457a1fe3e"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"metabolizeAgents", "[", "]"}]], "InlineCode",ExpressionUUID->
  "cf25b4cd-aa31-e747-a44c-a51af2c40f48"],
 "applies the metabolism operation to all agents for a timestep."
}], "Text",
 CellChangeTimes->{{3.9866599745356274`*^9, 3.9866600084836063`*^9}, 
   3.9866600958456745`*^9},ExpressionUUID->"518f1f10-c2df-4c45-837c-\
e2fea5fdd8e8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"metabolizeAgents", "[", 
   RowBox[{"model_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"agents", " ", "=", " ", 
       RowBox[{"model", "[", "\"\<agents\>\"", "]"}]}], ",", " ", 
      RowBox[{"model2", "=", "model"}]}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"agents", " ", "=", " ", 
      RowBox[{"MapAt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", " ", "-", " ", 
           RowBox[{"params", "[", "\"\<metabolism\>\"", "]"}]}], ")"}], "&"}],
         ",", " ", "agents", ",", " ", 
        RowBox[{"{", 
         RowBox[{"All", ",", " ", "\"\<energy\>\""}], "}"}]}], "]"}]}], ";", 
     "\n", "\t", 
     RowBox[{
      RowBox[{"model2", "[", "\"\<agents\>\"", "]"}], " ", "=", " ", 
      "agents"}], ";", "\n", "\t", "model2"}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{
  3.9866600228204327`*^9},ExpressionUUID->"0ff1e7bd-ec35-f246-a77a-\
484b3c84cae8"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"ageAgents", "[", "]"}]], "InlineCode",ExpressionUUID->
  "105e81d3-ee85-c94e-b96e-b63c5c1e12da"],
 "ages agents by one timestep ",
 Cell[BoxData[
  StyleBox["dt",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "bf8ecfb2-f05a-2b41-82d5-9e6727bb7127"],
 " during a timestep."
}], "Text",
 CellChangeTimes->{{3.986660071177496*^9, 
  3.9866600914102154`*^9}},ExpressionUUID->"4cf886e9-e753-b54e-81a7-\
ec23aee80a2a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ageAgents", "[", 
   RowBox[{"model_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"agents", " ", "=", " ", 
       RowBox[{"model", "[", "\"\<agents\>\"", "]"}]}], ",", " ", 
      RowBox[{"model2", "=", "model"}]}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"agents", " ", "=", " ", 
      RowBox[{"MapAt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", " ", "+", " ", 
           RowBox[{"params", "[", "\"\<dt\>\"", "]"}]}], ")"}], "&"}], ",", 
        " ", "agents", ",", " ", 
        RowBox[{"{", 
         RowBox[{"All", ",", " ", "\"\<age\>\""}], "}"}]}], "]"}]}], ";", 
     "\n", "\t", 
     RowBox[{
      RowBox[{"model2", "[", "\"\<agents\>\"", "]"}], " ", "=", " ", 
      "agents"}], ";", "\n", "\t", "model2"}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{
  3.986660122873667*^9},ExpressionUUID->"3b84131d-3e5b-334b-a411-\
0b23e9990342"],

Cell["[explorationWalk[] instead of randomActionWalk[]]", "Text",
 CellChangeTimes->{{3.9866601406207695`*^9, 
  3.986660196467783*^9}},ExpressionUUID->"825ae4ac-38c3-8b46-8157-\
9a769de85987"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"agentEat", "[", "]"}]], "InlineCode",ExpressionUUID->
  "ca102650-6402-7749-bdc9-77e0aacd5618"],
 "is used to update agents\[CloseCurlyQuote] energy when they eat a piece of \
food according to the ",
 Cell[BoxData[
  StyleBox["foodEnergy",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "da945908-d151-7346-b5e8-f8d65f26518f"],
 " parameter. The specific food that is being eaten has to be removed \
concurrently from the model\[CloseCurlyQuote]s food list."
}], "Text",
 CellChangeTimes->{{3.986660208063463*^9, 3.9866602236412525`*^9}, {
  3.9866602835315895`*^9, 3.9866603097685356`*^9}, {3.986660574870407*^9, 
  3.98666058938035*^9}},ExpressionUUID->"a94ed3d5-78c9-4a4d-9d85-\
c0e13657ff40"],

Cell[BoxData[
 RowBox[{
  RowBox[{"agentEat", "[", 
   RowBox[{"agent_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"agent2", " ", "=", " ", "agent"}], ",", " ", "newE"}], "}"}], ",",
     "\n", "\t", 
    RowBox[{
     RowBox[{"newE", " ", "=", " ", 
      RowBox[{
       RowBox[{"agent2", "[", "\"\<energy\>\"", "]"}], " ", "+", " ", 
       RowBox[{"params", "[", "\"\<foodEnergy\>\"", "]"}]}]}], ";", "\n", 
     "\t", 
     RowBox[{
      RowBox[{"agent2", "[", "\"\<energy\>\"", "]"}], " ", "=", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"newE", " ", ">", " ", 
         RowBox[{"params", "[", "\"\<maxEnergy\>\"", "]"}]}], ",", " ", 
        RowBox[{"params", "[", "\"\<maxEnergy\>\"", "]"}], ",", " ", "newE"}],
        "]"}]}], ";", "\n", "\t", "agent2"}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{
  3.9866603267786865`*^9},ExpressionUUID->"1d8de386-2365-ee41-894d-\
4da0592f83ac"],

Cell[TextData[{
 "Through an ",
 Cell[BoxData[
  RowBox[{"If", "[", "]"}]], "InlineCode",ExpressionUUID->
  "d155da3c-d01c-4e49-aeca-ba2e525f5abb"],
 "statement, ",
 Cell[BoxData[
  RowBox[{"agentEat", "[", "]"}]], "InlineCode",ExpressionUUID->
  "776a1033-cc85-2c41-8bf1-d6ee32cdf9ba"],
 " ensures that the energy does not exceed the ",
 Cell[BoxData[
  StyleBox["maxEnergy",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "681c7f22-bb66-3d45-b1e3-9b951ced23d3"]
}], "CodeText",
 CellChangeTimes->{{3.9866603578862877`*^9, 
  3.9866603857281055`*^9}},ExpressionUUID->"f0edc91d-1c43-e045-a489-\
7d79373f6072"],

Cell[TextData[{
 "Excluding reproduction [at the moment, (we need to use the paper to see if \
we should have reproduction in here or outside)], the main agent decision \
logic for a timestep occurs in the function ",
 Cell[BoxData[
 "agentActions"], "InlineCode",ExpressionUUID->
  "e6f93b9e-c7a0-de44-9ba9-7743ccbb4171"],
 ". Agents will consume food if they are within the required ",
 Cell[BoxData[
  StyleBox["proximityRadius",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "ef62b744-a0b4-4e47-a02e-5e1097d5fa40"],
 " to eat it, and otherwise they will move following their movement rules:  \
[if there is a sensable food or instead another agent I can reproduce with \
(if I have enough energy), move towards it, prioritizing reproduction if \
possible. Else, explore in a random direction according to direction agent \
attribute ",
 Cell[BoxData[
  StyleBox["currentDirection",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "71753c8e-19d7-ba4d-8e99-7c519a749384"],
 " I\[CloseCurlyQuote]m currently exploring in. If I\[CloseCurlyQuote]m \
exploring in a random direction, I have a 0.2 chance this timestep that I\
\[CloseCurlyQuote]m going to switch directions]"
}], "Text",
 CellChangeTimes->{{3.9866604257842503`*^9, 3.9866605531170216`*^9}, {
  3.986660595513241*^9, 
  3.986660821477068*^9}},ExpressionUUID->"9293eeb3-3218-c245-bcb9-\
65462f03cf8e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"agentActions", "[", 
   RowBox[{"model_", ",", " ", "params_"}], "]"}], " ", ":=", "  ", 
  RowBox[{"Module", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"model2", " ", "=", " ", "model"}], ",", " ", 
      RowBox[{"agents", " ", "=", " ", 
       RowBox[{"model", "[", "\"\<agents\>\"", "]"}]}], ",", " ", 
      RowBox[{"foods", " ", "=", " ", 
       RowBox[{"model", "[", "\"\<foods\>\"", "]"}]}], ",", " ", "agent", ",",
       " ", "nearFoodI", ",", " ", "nearFoodDist"}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"agents", " ", "=", " ", 
      RowBox[{"Table", "[", "\n", "\t\t", 
       RowBox[{
        RowBox[{
         RowBox[{"agent", " ", "=", " ", 
          RowBox[{"agents", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ";", "\n", "\t\t", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"nearFoodDist", ",", " ", "nearFoodI"}], "}"}], " ", "=", 
          " ", 
          RowBox[{"findNearestSensableFoodPosAndI", "[", 
           RowBox[{"agent", ",", " ", "foods", ",", " ", "params"}], "]"}]}], 
         ";", "\n", "\t\t", 
         RowBox[{"If", "[", "\n", "            ", 
          RowBox[{
           RowBox[{
            RowBox[{"nearFoodI", ">=", "1"}], " ", "&&", " ", 
            RowBox[{"nearFoodDist", " ", "<", " ", 
             RowBox[{"params", "[", "\"\<proximityRadius\>\"", "]"}]}]}], ",",
            " ", "\n", "\t\t\t", 
           RowBox[{
            RowBox[{"foods", " ", "=", " ", 
             RowBox[{"Delete", "[", 
              RowBox[{"foods", ",", " ", "nearFoodI"}], "]"}]}], ";", " ", 
            RowBox[{"agentEat", "[", 
             RowBox[{"agent", ",", " ", "params"}], "]"}]}], ",", " ", "\n", 
           "\t\t\t", 
           RowBox[{"randomActionWalk", "[", 
            RowBox[{"agent", ",", " ", "params"}], "]"}]}], "\n", "        ", 
          "]"}]}], ",", "\n", "\t    ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", 
          RowBox[{"Length", "@", "agents"}]}], "}"}]}], "\n", "    ", "]"}]}],
      ";", "\n", "\t", 
     RowBox[{
      RowBox[{"model2", "[", "\"\<foods\>\"", "]"}], " ", "=", " ", "foods"}],
      ";", "\n", "\t", 
     RowBox[{
      RowBox[{"model2", "[", "\"\<agents\>\"", "]"}], " ", "=", " ", 
      "agents"}], ";", "\n", "\t", "model2"}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{
  3.9866608388680496`*^9},ExpressionUUID->"eca38961-40b7-7d4a-aa1b-\
b6045f3bcca4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Reproduction", "Section",
 CellChangeTimes->{{3.98286926438072*^9, 3.982869269632347*^9}, {
  3.9828693236442394`*^9, 3.9828693436310635`*^9}, {3.9829495713867683`*^9, 
  3.982949574711521*^9}, {3.9861296033929863`*^9, 3.9861296035975056`*^9}, {
  3.986132698468153*^9, 3.9861326988221054`*^9}, {3.988397631574587*^9, 
  3.9883976334960117`*^9}},ExpressionUUID->"a671984d-8b17-ce47-8fa1-\
7e377fdc9c60"],

Cell["\<\
Introducing reproduction is crucial to simulate real animal behaviors. When \
two agents meet, they produce an offspring that inherits a  position between \
them and a fresh slice of energy. Our functionality has four main parts \
working together: a way to give every agent an identity, rules for deciding \
who is allowed to mate with whom, and the reproduction step itself.

Every agent has a unique integer id, assigned when the agent is created. \
Every agent also has the ids of both their parents. The founding agents, the \
first agents in the simulation, have no parents and are simply marked with \
{-1, -1}. These are all part of the agent association: \
\>", "Text",
 CellChangeTimes->{{3.9883976511296215`*^9, 3.988397857062086*^9}, {
   3.988398234161289*^9, 3.9883983446725693`*^9}, 
   3.988398430092184*^9},ExpressionUUID->"a76bb6ba-63bf-8740-8d77-\
9d4fff87b139"],

Cell[BoxData[
 RowBox[{
  RowBox[{"createAgent", "[", 
   RowBox[{
   "pos_", ",", "energy_", ",", "age_", ",", "id_", ",", "currentDirection_", 
    ",", 
    RowBox[{"parents_", ":", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "1"}]}], "}"}]}], ",", "reproductionCooldown_"}], "]"}], ":=", 
  RowBox[{"<|", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\"\<pos\>\"", "->", "pos"}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<energy\>\"", "->", "energy"}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<age\>\"", "->", "age"}], ",", 
    RowBox[{"\"\<id\>\"", "->", "id"}], ",", "\[IndentingNewLine]", 
    RowBox[{"\"\<currentDirection\>\"", "->", "currentDirection"}], ",", 
    RowBox[{"(*", 
     RowBox[{"unit", " ", "vector"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{"\"\<parents\>\"", "->", "parents"}], ",", "\n", "       ", 
    RowBox[{"\"\<reproductionCooldown\>\"", "->", "reproductionCooldown"}]}], 
   "|>"}]}]], "Code",
 CellChangeTimes->{{3.988398349275343*^9, 
  3.9883984242821445`*^9}},ExpressionUUID->"87cbae5e-9c6b-d149-8ee5-\
81098b605b27"],

Cell[TextData[{
 "The nextAgentId is created in ",
 StyleBox["inizializeModel ",
  FontSlant->"Italic"],
 "to one more than the founding population, so the first agent created is \
given the next unused id: "
}], "Text",
 CellChangeTimes->{{3.9883984467839756`*^9, 3.988398451537857*^9}, {
  3.9883985271502514`*^9, 
  3.988398625122864*^9}},ExpressionUUID->"3a23ba0e-a338-b442-b9e3-\
c9cd56684109"],

Cell[BoxData[
 RowBox[{"\"\<nextAgentID\>\"", " ", "->", " ", 
  RowBox[{"nStartingAgents", " ", "+", " ", "1"}]}]], "Code",
 CellChangeTimes->{{3.9883986239542103`*^9, 
  3.9883986268458805`*^9}},ExpressionUUID->"fc70c56b-8d7f-444e-8541-\
4cca8f4d7b83"],

Cell["[explain the areRelated function]", "Text",
 CellChangeTimes->{{3.988398655142166*^9, 3.988398693609253*^9}, {
   3.988398743677696*^9, 3.9883987521511765`*^9}, {3.988398861894823*^9, 
   3.988398883193489*^9}, 
   3.988398927915348*^9},ExpressionUUID->"cd00c39f-0df4-8845-9702-\
937d48132af5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"areRelated", "[", 
   RowBox[{"ai_", ",", " ", "aj_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Or", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"MemberQ", "[", 
     RowBox[{
      RowBox[{"ai", "[", "\"\<parents\>\"", "]"}], ",", " ", 
      RowBox[{"aj", "[", "\"\<id\>\"", "]"}]}], "]"}], ",", "   ", "\n", 
    "    ", 
    RowBox[{"MemberQ", "[", 
     RowBox[{
      RowBox[{"aj", "[", "\"\<parents\>\"", "]"}], ",", " ", 
      RowBox[{"ai", "[", "\"\<id\>\"", "]"}]}], "]"}], ",", " ", "\n", "    ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"ai", "[", "\"\<parents\>\"", "]"}], " ", "=!=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{"-", "1"}]}], "}"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Sort", "[", 
        RowBox[{"ai", "[", "\"\<parents\>\"", "]"}], "]"}], " ", "===", " ", 
       RowBox[{"Sort", "[", 
        RowBox[{"aj", "[", "\"\<parents\>\"", "]"}], "]"}]}]}], ")"}]}], "\n",
    "]"}]}]], "Code",
 CellChangeTimes->{{3.9883989163592567`*^9, 3.9883989256292973`*^9}, 
   3.988398967118494*^9},ExpressionUUID->"40dc52cd-4883-5e4f-9544-\
55a6fabd2d28"],

Cell["[explain the canMate function]", "Text",
 CellChangeTimes->{{3.9883995514778633`*^9, 
  3.9883995625065193`*^9}},ExpressionUUID->"5d31d128-9762-b847-b0c0-\
224b7f2ea230"],

Cell[BoxData[
 RowBox[{
  RowBox[{"canMate", "[", 
   RowBox[{"ai_", ",", " ", "aj_", ",", " ", "params_"}], "]"}], " ", ":=", 
  "\n", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"EuclideanDistance", "[", 
     RowBox[{
      RowBox[{"ai", "[", "\"\<pos\>\"", "]"}], ",", " ", 
      RowBox[{"aj", "[", "\"\<pos\>\"", "]"}]}], "]"}], " ", "<=", " ", 
    RowBox[{"params", "[", "\"\<reproductionRadius\>\"", "]"}]}], " ", "&&", 
   "\n", "  ", 
   RowBox[{
    RowBox[{"ai", "[", "\"\<energy\>\"", "]"}], " ", ">=", " ", 
    RowBox[{"params", "[", "\"\<minReproductionEnergy\>\"", "]"}]}], " ", "&&",
    "\n", "  ", 
   RowBox[{
    RowBox[{"aj", "[", "\"\<energy\>\"", "]"}], " ", ">=", " ", 
    RowBox[{"params", "[", "\"\<minReproductionEnergy\>\"", "]"}]}], " ", "&&",
    "\n", "  ", 
   RowBox[{
    RowBox[{"ai", "[", "\"\<age\>\"", "]"}], "    ", ">=", " ", 
    RowBox[{"params", "[", "\"\<minReproductionAge\>\"", "]"}]}], " ", "&&", 
   "\n", "  ", 
   RowBox[{
    RowBox[{"aj", "[", "\"\<age\>\"", "]"}], "    ", ">=", " ", 
    RowBox[{"params", "[", "\"\<minReproductionAge\>\"", "]"}]}], " ", "&&", 
   "\n", "  ", 
   RowBox[{
    RowBox[{"ai", "[", "\"\<reproductionCooldown\>\"", "]"}], " ", "<=", " ", 
    "0"}], " ", "&&", "\n", "  ", 
   RowBox[{
    RowBox[{"aj", "[", "\"\<reproductionCooldown\>\"", "]"}], " ", "<=", " ", 
    "0"}], " ", "&&", "\n", "  ", 
   RowBox[{"!", 
    RowBox[{"areRelated", "[", 
     RowBox[{"ai", ",", " ", "aj"}], "]"}]}]}]}]], "Code",
 CellChangeTimes->{
  3.9883995673397465`*^9},ExpressionUUID->"899266bf-42a5-e94b-a242-\
a282d48e22f0"],

Cell["[Explain findClosestMateI]", "Text",
 CellChangeTimes->{{3.988399124833193*^9, 3.988399164394335*^9}, {
  3.988399250900614*^9, 
  3.9883992530708733`*^9}},ExpressionUUID->"1ad9b752-de08-bc40-ac7a-\
767170a02d50"],

Cell[BoxData[
 RowBox[{
  RowBox[{"findClosestMateI", "[", 
   RowBox[{"agentI_Integer", ",", " ", "agents_List"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pos", ",", " ", "dists", ",", " ", "agent"}], "}"}], ",", "\n", 
    "    ", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "agents", "]"}], " ", "<", " ", "2"}], ",", 
       " ", 
       RowBox[{"Return", "[", 
        RowBox[{"-", "1"}], "]"}]}], "]"}], ";", "\n", "    ", 
     RowBox[{"pos", " ", "=", " ", 
      RowBox[{
       RowBox[{"agents", "[", 
        RowBox[{"[", "agentI", "]"}], "]"}], "[", "\"\<pos\>\"", "]"}]}], ";",
      "\n", "    ", 
     RowBox[{"agent", " ", "=", " ", 
      RowBox[{"agents", "[", 
       RowBox[{"[", "agentI", "]"}], "]"}]}], ";", "\n", "    ", 
     RowBox[{"dists", " ", "=", " ", 
      RowBox[{"Table", "[", "\n", "        ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"i", " ", "==", " ", "agentI"}], " ", "||", " ", 
           RowBox[{"areRelated", "[", 
            RowBox[{"agent", ",", " ", 
             RowBox[{"agents", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ",", " ", "Infinity",
           ",", " ", 
          RowBox[{"EuclideanDistance", "[", 
           RowBox[{"pos", ",", " ", 
            RowBox[{
             RowBox[{"agents", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "[", "\"\<pos\>\"", "]"}]}], 
           "]"}]}], "]"}], ",", "\n", "        ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", 
          RowBox[{"Length", "[", "agents", "]"}]}], "}"}]}], "\n", "    ", 
       "]"}]}], ";", "\n", "    ", 
     RowBox[{"First", "@", 
      RowBox[{"Ordering", "[", 
       RowBox[{"dists", ",", " ", "1"}], "]"}]}]}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{3.9883991620377445`*^9, 
  3.988399263780882*^9},ExpressionUUID->"44b81637-acb7-dd47-8c48-\
f697cadc73f1"],

Cell["[Explain the reproduceAgents function]", "Text",
 CellChangeTimes->{{3.9883989342304344`*^9, 3.988398937529335*^9}, {
  3.988398984830765*^9, 
  3.9883989931095657`*^9}},ExpressionUUID->"37eb5dca-46f1-4242-b531-\
1362e4992343"],

Cell[BoxData[
 RowBox[{
  RowBox[{"reproduceAgents", "[", 
   RowBox[{"model_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", "\n", "        ", 
     RowBox[{
      RowBox[{"agents", " ", "=", " ", 
       RowBox[{"model", "[", "\"\<agents\>\"", "]"}]}], ",", " ", 
      RowBox[{"model2", " ", "=", " ", "model"}], ",", " ", 
      RowBox[{"newAgents", " ", "=", " ", 
       RowBox[{"{", "}"}]}], ",", "\n", "        ", "reproduced", ",", " ", 
      "nextID", ",", " ", "j", ",", " ", "ai", ",", " ", "aj", ",", " ", 
      "dist", ",", " ", "midPos", ",", " ", "newAgent", ",", " ", "newDir"}], 
     "\n", "    ", "}"}], ",", "\n", "\n", "  ", 
    RowBox[{
     RowBox[{"nextID", " ", "=", " ", 
      RowBox[{"model", "[", "\"\<nextAgentID\>\"", "]"}]}], ";", "\n", "  ", 
     RowBox[{"reproduced", " ", "=", " ", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"False", ",", " ", 
        RowBox[{"Length", "[", "agents", "]"}]}], "]"}]}], ";", "\n", "\n", 
     "  ", 
     RowBox[{"Do", "[", "\n", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"reproduced", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
          RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "    ", 
        RowBox[{"j", " ", "=", " ", 
         RowBox[{"findClosestAgentI", "[", 
          RowBox[{"i", ",", " ", "agents"}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"j", " ", "==", " ", 
            RowBox[{"-", "1"}]}], " ", "||", " ", 
           RowBox[{"reproduced", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], ",", " ", 
          RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "\n", "    ", 
        RowBox[{"ai", " ", "=", " ", 
         RowBox[{"agents", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"aj", " ", "=", " ", 
         RowBox[{"agents", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"dist", " ", "=", " ", 
         RowBox[{"EuclideanDistance", "[", 
          RowBox[{
           RowBox[{"ai", "[", "\"\<pos\>\"", "]"}], ",", " ", 
           RowBox[{"aj", "[", "\"\<pos\>\"", "]"}]}], "]"}]}], ";", "\n", 
        "\n", "    ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"dist", " ", "<=", " ", 
            RowBox[{"params", "[", "\"\<reproductionRadius\>\"", "]"}]}], " ",
            "&&", "\n", "       ", 
           RowBox[{
            RowBox[{"ai", "[", "\"\<energy\>\"", "]"}], " ", ">=", " ", 
            RowBox[{"params", "[", "\"\<minReproductionEnergy\>\"", "]"}]}], 
           " ", "&&", "\n", "       ", 
           RowBox[{
            RowBox[{"aj", "[", "\"\<energy\>\"", "]"}], " ", ">=", " ", 
            RowBox[{"params", "[", "\"\<minReproductionEnergy\>\"", "]"}]}], 
           " ", "&&", "\n", "       ", 
           RowBox[{
            RowBox[{"ai", "[", "\"\<age\>\"", "]"}], " ", ">=", " ", 
            RowBox[{"params", "[", "\"\<minReproductionAge\>\"", "]"}]}], " ",
            "&&", "\n", "       ", 
           RowBox[{
            RowBox[{"aj", "[", "\"\<age\>\"", "]"}], " ", ">=", " ", 
            RowBox[{"params", "[", "\"\<minReproductionAge\>\"", "]"}]}], " ",
            "&&", "\n", "        ", 
           RowBox[{
            RowBox[{"ai", "[", "\"\<reproductionCooldown\>\"", "]"}], " ", "<=",
             " ", "0"}], " ", "&&", "\n", "        ", 
           RowBox[{
            RowBox[{"aj", "[", "\"\<reproductionCooldown\>\"", "]"}], " ", "<=",
             " ", "0"}], " ", "&&", "\n", "       ", 
           RowBox[{"!", 
            RowBox[{"areRelated", "[", 
             RowBox[{"ai", ",", " ", "aj"}], "]"}]}]}], ",", "\n", "\n", 
          "      ", 
          RowBox[{"(*", " ", 
           RowBox[{
           "both", " ", "parents", " ", "pay", " ", "energy", " ", "cost"}], 
           " ", "*)"}], "\n", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"agents", "[", 
             RowBox[{"[", "i", "]"}], "]"}], " ", "=", " ", 
            RowBox[{"ReplacePart", "[", 
             RowBox[{
              RowBox[{"agents", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", " ", "\n", "        ", 
              RowBox[{"\"\<energy\>\"", " ", "->", " ", 
               RowBox[{
                RowBox[{"ai", "[", "\"\<energy\>\"", "]"}], " ", "-", " ", 
                RowBox[{
                "params", "[", "\"\<reproductionEnergyCost\>\"", "]"}]}]}], ",",
               " ", 
              RowBox[{"\"\<reproductionCooldown\>\"", " ", "->", " ", 
               RowBox[{
               "params", "[", "\"\<reproductionCooldown\>\"", "]"}]}]}], 
             "]"}]}], ";", "\n", "      ", 
           RowBox[{
            RowBox[{"agents", "[", 
             RowBox[{"[", "j", "]"}], "]"}], " ", "=", " ", 
            RowBox[{"ReplacePart", "[", 
             RowBox[{
              RowBox[{"agents", "[", 
               RowBox[{"[", "j", "]"}], "]"}], ",", " ", "\n", "        ", 
              RowBox[{"\"\<energy\>\"", " ", "->", " ", 
               RowBox[{
                RowBox[{"aj", "[", "\"\<energy\>\"", "]"}], " ", "-", " ", 
                RowBox[{
                "params", "[", "\"\<reproductionEnergyCost\>\"", "]"}]}]}], ",",
               " ", 
              RowBox[{"\"\<reproductionCooldown\>\"", " ", "->", " ", 
               RowBox[{
               "params", "[", "\"\<reproductionCooldown\>\"", "]"}]}]}], 
             "]"}]}], ";", "\n", "\n", "      ", 
           RowBox[{"midPos", " ", "=", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"ai", "[", "\"\<pos\>\"", "]"}], " ", "+", " ", 
               RowBox[{"aj", "[", "\"\<pos\>\"", "]"}]}], ")"}], " ", "/", 
             " ", "2"}]}], ";", "\n", "      ", 
           RowBox[{"newDir", " ", "=", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Cos", "[", "#", "]"}], ",", " ", 
                RowBox[{"Sin", "[", "#", "]"}]}], "}"}], " ", "&"}], "[", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"{", 
               RowBox[{"0", ",", " ", 
                RowBox[{"2", " ", "Pi"}]}], "}"}], "]"}], "]"}]}], ";", "\n", 
           "      ", 
           RowBox[{"newAgent", " ", "=", " ", 
            RowBox[{"createAgent", "[", 
             RowBox[{"midPos", ",", " ", 
              RowBox[{
               RowBox[{"params", "[", "\"\<startingEnergy\>\"", "]"}], "/", 
               "2"}], ",", " ", "0.0", ",", " ", "nextID", ",", " ", "newDir",
               ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"ai", "[", "\"\<id\>\"", "]"}], ",", " ", 
                RowBox[{"aj", "[", "\"\<id\>\"", "]"}]}], "}"}], ",", " ", 
              RowBox[{"params", "[", "\"\<reproductionCooldown\>\"", "]"}]}], 
             "]"}]}], ";", "\n", "      ", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"newAgents", ",", " ", "newAgent"}], "]"}], ";", "\n", 
           "      ", 
           RowBox[{"nextID", "++"}], ";", "\n", "\n", "      ", 
           RowBox[{
            RowBox[{"reproduced", "[", 
             RowBox[{"[", "i", "]"}], "]"}], " ", "=", " ", "True"}], ";", 
           "\n", "      ", 
           RowBox[{
            RowBox[{"reproduced", "[", 
             RowBox[{"[", "j", "]"}], "]"}], " ", "=", " ", "True"}], ";"}]}],
          "\n", "\n", "    ", "]"}], ";"}], "\n", "  ", ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"Length", "[", "agents", "]"}]}], "}"}]}], "]"}], ";", "\n", 
     "\n", "  ", 
     RowBox[{
      RowBox[{"model2", "[", "\"\<agents\>\"", "]"}], " ", "=", " ", 
      RowBox[{"Join", "[", 
       RowBox[{"agents", ",", " ", "newAgents"}], "]"}]}], ";", "\n", "  ", 
     RowBox[{
      RowBox[{"model2", "[", "\"\<nextAgentID\>\"", "]"}], " ", "=", " ", 
      "nextID"}], ";", "\n", "  ", "model2"}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{
  3.9883990220499783`*^9},ExpressionUUID->"c5bc7139-8733-1d42-9c85-\
8c3392218ac2"],

Cell["\<\
[Explain the need for a reproduction cooldown and the \
decrementReproductionCooldowns function]\
\>", "Text",
 CellChangeTimes->{{3.9883993182968407`*^9, 
  3.988399338286682*^9}},ExpressionUUID->"db61ed85-ca5d-b94b-9668-\
b3fb70037642"],

Cell[BoxData[
 RowBox[{
  RowBox[{"decrementReproductionCooldowns", "[", 
   RowBox[{"model_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"agents", " ", "=", " ", 
       RowBox[{"model", "[", "\"\<agents\>\"", "]"}]}], ",", " ", 
      RowBox[{"model2", " ", "=", " ", "model"}]}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"agents", " ", "=", " ", 
      RowBox[{"MapAt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{"#", " ", "-", " ", 
            RowBox[{"params", "[", "\"\<dt\>\"", "]"}]}], ",", " ", "0"}], 
          "]"}], "&"}], ",", " ", "agents", ",", " ", 
        RowBox[{"{", 
         RowBox[{"All", ",", " ", "\"\<reproductionCooldown\>\""}], "}"}]}], 
       "]"}]}], ";", "\n", "\t", 
     RowBox[{
      RowBox[{"model2", "[", "\"\<agents\>\"", "]"}], " ", "=", " ", 
      "agents"}], ";", "\n", "\t", "model2"}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{
  3.988399349140848*^9},ExpressionUUID->"1ba42178-8402-b24b-a63d-\
b6302a5ca667"]
}, Open  ]],

Cell["Reproductive Strategies", "Section",
 CellChangeTimes->{{3.9828693388389606`*^9, 3.9828693496746387`*^9}, {
  3.9829495759864902`*^9, 3.9829495790467243`*^9}, {3.9861326995591106`*^9, 
  3.9861326999080105`*^9}},ExpressionUUID->"92e704e2-29b3-4b4f-8558-\
394ea02f37f2"],

Cell["Parenting Strategies", "Section",
 CellChangeTimes->{{3.982869340814558*^9, 3.982869341385681*^9}, {
  3.98294958119709*^9, 3.982949583683815*^9}, {3.986132700271326*^9, 
  3.986132700624958*^9}, {3.986652936286829*^9, 3.986652938297497*^9}, {
  3.988398853099413*^9, 
  3.988398853455618*^9}},ExpressionUUID->"7ba12f3f-19c4-9545-ab9e-\
4d5a7f97520b"],

Cell[CellGroupData[{

Cell["Model Initialization", "Section",
 CellChangeTimes->{{3.9866594107534523`*^9, 
  3.986659413274023*^9}},ExpressionUUID->"b82d0072-7288-764d-9bc5-\
0e4a2ba20d41"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  RowBox[{"initializeModel", "[", "]"}]], "InlineCode",ExpressionUUID->
  "a9b064bf-4763-0645-a46e-9ee53e66e8e7"],
 " function returns an initialized model initialized according to the model \
parameters. It is set equal to a global variable to represent the model when \
doing operations on the model at the top level, like running the simulation."
}], "Text",
 CellChangeTimes->{{3.986661089799444*^9, 3.9866611365671673`*^9}, {
  3.986661257236969*^9, 
  3.986661291288233*^9}},ExpressionUUID->"9b006328-d5c7-7443-8349-\
8e06d4e74ae8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"initializeModel", "[", "params_", "]"}], " ", ":=", "\n", "\n", 
  "  ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "agents", ",", " ", "foods", ",", " ", "nStartingAgents", ",", " ", 
      "nStartingFood", ",", " ", "startingEnergy", ",", " ", "min", ",", " ", 
      "max"}], "}"}], ",", "  ", "\n", "\n", "    ", 
    RowBox[{
     RowBox[{"nStartingAgents", " ", "=", " ", 
      RowBox[{"params", "[", "\"\<nStartingAgents\>\"", "]"}]}], ";", " ", 
     RowBox[{"(*", 
      RowBox[{
      "parameter", " ", "for", " ", "number", " ", "of", " ", "agents"}], 
      "*)"}], "\n", "    ", 
     RowBox[{"nStartingFood", " ", "=", " ", 
      RowBox[{"params", "[", "\"\<nStartingFood\>\"", "]"}]}], ";", " ", 
     RowBox[{"(*", 
      RowBox[{
      "parameter", " ", "for", " ", "number", " ", "of", " ", "food", " ", 
       "items"}], "*)"}], "\n", "    ", 
     RowBox[{"startingEnergy", " ", "=", " ", 
      RowBox[{"params", "[", "\"\<startingEnergy\>\"", "]"}]}], ";", "\n", 
     "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"min", ",", " ", "max"}], "}"}], " ", "=", " ", 
      RowBox[{"params", "[", "\"\<squareBounds\>\"", "]"}]}], ";", "\n", "\n",
      "    ", 
     RowBox[{"agents", " ", "=", "\n", "    ", 
      RowBox[{"Table", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"createAgent", "[", 
         RowBox[{
          RowBox[{"RandomReal", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"min", ",", " ", "max"}], "}"}], ",", " ", "2"}], "]"}], 
          ",", " ", "startingEnergy", ",", " ", "0.0", ",", " ", "i", ",", 
          " ", 
          RowBox[{"RandomReal", "[", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", 
             RowBox[{"2", " ", "Pi"}]}], "}"}], "]"}]}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "nStartingAgents"}], "}"}]}], "\n", "    ", 
       "]"}]}], ";", "\n", "\n", "    ", 
     RowBox[{"foods", " ", "=", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"min", ",", " ", "max"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"nStartingFood", ",", " ", "2"}], "}"}]}], "]"}]}], ";", 
     "\n", "\t", "\n", "    ", 
     RowBox[{"<|", " ", "\n", "      ", 
      RowBox[{
       RowBox[{"\"\<agents\>\"", " ", "->", " ", "agents"}], ",", " ", 
       RowBox[{"(*", 
        RowBox[{"list", " ", "of", " ", "agent", " ", "associations"}], 
        "*)"}], "\n", "      ", 
       RowBox[{"\"\<foods\>\"", " ", "->", " ", "foods"}], ",", " ", 
       RowBox[{"(*", 
        RowBox[{"list", " ", "of", " ", "food", " ", "coordinates"}], "*)"}], 
       "\n", "      ", 
       RowBox[{"\"\<bounds\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"min", ",", " ", "max"}], "}"}]}], ",", "\n", "      ", 
       RowBox[{"\"\<time\>\"", " ", "->", " ", "0"}], ",", "\n", "      ", 
       RowBox[{"\"\<nextAgentID\>\"", " ", "->", " ", 
        RowBox[{"nStartingAgents", " ", "+", " ", "1"}]}]}], "\n", "    ", 
      "|>"}]}]}], "\n", " ", "]"}]}]], "Code",
 CellChangeTimes->{
  3.9866613044917526`*^9},ExpressionUUID->"a619ae0a-10c1-f34d-8a31-\
d34f470115a2"],

Cell[TextData[{
 "The association returned is the model with the association data structure \
as defined earlier in ",
 StyleBox["Core Model",
  FontColor->RGBColor[
   0.792156862745098, 0.3176470588235294, 0.09803921568627451]],
 " \[RightArrow] ",
 StyleBox["Data Structures",
  FontColor->RGBColor[
   0.7803921568627451, 0.4235294117647059, 0.1607843137254902]],
 "."
}], "CodeText",
 CellChangeTimes->{{3.986661316472624*^9, 
  3.9866614107791843`*^9}},ExpressionUUID->"e6de19c0-d810-bd4c-a628-\
cd7dcf3cb3fa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Model Propagation", "Section",
 CellChangeTimes->{{3.9821922407373047`*^9, 3.9821922594191017`*^9}, 
   3.982869223867647*^9, 3.982947604009659*^9, {3.9861326932163754`*^9, 
   3.9861326935201855`*^9}},ExpressionUUID->"da42a107-5a94-c44b-88f7-\
cc5b76916bdb"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  RowBox[{"propagateModelStep", "[", "]"}]], "InlineCode",ExpressionUUID->
  "87ba9a72-d34e-4b48-b731-598e1a3c9278"],
 " function propagates the model by one timestep, doing the operations that \
occur during a timestep sequentially: spawning food if it\[CloseCurlyQuote]s \
the appropriate time,  removing agents that are dead and randomizing, doing \
the main agent action decision logic, [doing the separate reproduction \
actions (should not be separate?)], metabolizing the agents, aging the \
agents, and advancing time in the simulation."
}], "Text",
 CellChangeTimes->{{3.9866615011262493`*^9, 3.9866616696780376`*^9}, {
  3.986661714886631*^9, 3.9866617192814503`*^9}, {3.986662215385935*^9, 
  3.986662218980051*^9}},ExpressionUUID->"4e7e6690-c989-5f45-b5d6-\
389356334b1a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"propagateModelStep", "[", 
    RowBox[{"params_", ",", " ", "model_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"model2", "=", "model"}], ",", " ", 
       RowBox[{"params2", "=", "params"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"params2", "[", "\"\<nextAgentID\>\"", "]"}], " ", "=", " ", 
       RowBox[{"model2", "[", "\"\<nextAgentID\>\"", "]"}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{"huh", "?"}], "*)"}], "\n", "  ", 
      RowBox[{"model2", " ", "=", " ", 
       RowBox[{"spawnFoodCheck", "[", 
        RowBox[{"model2", ",", " ", "params"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"model2", " ", "=", " ", 
       RowBox[{"randomizeAndKill", "[", 
        RowBox[{"model2", ",", " ", "params"}], "]"}]}], ";", " ", 
      RowBox[{"(*", "randomization", "*)"}], "\n", "  ", 
      RowBox[{"model2", " ", "=", " ", 
       RowBox[{"agentActions", "[", 
        RowBox[{"model2", ",", " ", "params"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"model2", " ", "=", " ", 
       RowBox[{"reproduceAgents", "[", 
        RowBox[{"model2", ",", " ", "params2"}], "]"}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{"why", " ", "do", " ", "we", " ", "have", " ", 
        RowBox[{"params2", "?"}]}], "*)"}], "\n", "  ", 
      RowBox[{"model2", " ", "=", " ", 
       RowBox[{"metabolizeAgents", "[", 
        RowBox[{"model2", ",", " ", "params"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"model2", " ", "=", " ", 
       RowBox[{"ageAgents", "[", 
        RowBox[{"model2", ",", " ", "params"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{
       RowBox[{"model2", "[", "\"\<time\>\"", "]"}], " ", "=", " ", 
       RowBox[{
        RowBox[{"model2", "[", "\"\<time\>\"", "]"}], " ", "+", " ", 
        RowBox[{"params", "[", "\"\<dt\>\"", "]"}]}]}], ";", "\n", "  ", 
      "model2"}]}], "\n", "]"}]}], ";"}]], "Code",
 CellChangeTimes->{{3.98666169419738*^9, 
  3.9866617043452415`*^9}},ExpressionUUID->"a3547cd4-b0d8-4743-8d84-\
3a1332c06cbe"],

Cell[TextData[{
 Cell[BoxData[
 "genSimulationStates"], "InlineCode",ExpressionUUID->
  "3b93a624-4bea-c548-946b-0601aad955a5"],
 " is used to generate the entire simulation, which becomes a list of model \
states, with each index in the list being being a model object representing \
the state of the simulation after an amount of time steps that is that index."
}], "Text",
 CellChangeTimes->{{3.9866621870938053`*^9, 3.9866621969749737`*^9}, {
  3.986662247370226*^9, 
  3.986662332443018*^9}},ExpressionUUID->"93a67f07-9618-2348-b20e-\
5fb56b717616"],

Cell[BoxData[
 RowBox[{
  RowBox[{"genSimulationStates", "[", 
   RowBox[{"params_", ",", " ", "model_", ",", " ", "timesteps_"}], "]"}], 
  " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"model2", " ", "=", " ", "model"}], "}"}], ",", " ", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", "model", "}"}], ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"model2", " ", "=", " ", 
          RowBox[{"propagateModelStep", "[", 
           RowBox[{"params", ",", " ", "model2"}], "]"}]}], ";", "model2"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", " ", "timesteps"}], "}"}]}], "]"}]}], "]"}]}], 
   "]"}]}]], "Code",
 CellChangeTimes->{
  3.9866623448382454`*^9},ExpressionUUID->"0682c969-ad9b-6d4c-baf3-\
ecbb16dba00c"],

Cell["\<\
These are then rendered frame by frame, for visualization purposes, or this \
simulation data is exported for data analysis.\
\>", "Text",
 CellChangeTimes->{{3.9866623512721634`*^9, 
  3.9866623786389427`*^9}},ExpressionUUID->"40108999-01c4-bb42-8eec-\
be348df6bb88"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Visualization", "Section",
 CellChangeTimes->{{3.9828692436483173`*^9, 3.9828692508295784`*^9}, {
  3.9861326943131332`*^9, 3.986132694674059*^9}, {3.9861334294481373`*^9, 
  3.9861334447826405`*^9}},ExpressionUUID->"adf5e6db-afa9-bd4e-9bfa-\
226c9171a445"],

Cell["[add scaling funcs for agent image size]", "Text",
 CellChangeTimes->{{3.9866608898196545`*^9, 
  3.986660898595459*^9}},ExpressionUUID->"0c769ac5-fd39-954a-af93-\
3ce8e73e5e3b"],

Cell[TextData[{
 "To simulate how agents interact with one another in an environment, we \
created a square visualization window bounded by the parameter ",
 StyleBox["squareBounds",
  FontWeight->"Bold"],
 " to render agents, food/resources, energy levels, ages, and other \
characteristics for each timestep. The function first extracts all agent \
information from the main association. In particular, an important variable \
is ",
 StyleBox["span",
  FontWeight->"Bold"],
 ", which we use to scale the visualization with the size of the modeled \
world, so the display remains consistent even when the environment changes.\n\
\n[btw the closing square bracket for this module below is in another cell]."
}], "Text",
 CellChangeTimes->{{3.9858872836735134`*^9, 3.985887333646532*^9}, {
  3.985887375511841*^9, 3.9858874105025845`*^9}, {3.9858874642860413`*^9, 
  3.985887600183935*^9}, {3.986133446189781*^9, 3.9861334572457447`*^9}, {
  3.986134081567087*^9, 3.9861340825917263`*^9}, {3.98613522389324*^9, 
  3.986135226836588*^9}},ExpressionUUID->"06ce39a2-5a12-e24b-9dcc-\
9a94c95b3922"],

Cell[BoxData[
 RowBox[{
  RowBox[{"displayGrid", "[", 
   RowBox[{"model_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", "\n", "    ", 
     RowBox[{
     "agents", ",", " ", "foods", ",", " ", "min", ",", " ", "max", ",", " ", 
      "span", ",", " ", "nAgents", ",", "\n", "    ", "hudPad", ",", " ", 
      "agentR", ",", " ", "foodR", ",", " ", "barW", ",", " ", "barH", ",", 
      " ", "barGap", ",", "\n", "    ", "showEnergyBars", ",", " ", "legendX",
       ",", " ", "legendY", ",", " ", "infoX", ",", " ", "infoY", ",", "\n", 
      "    ", "ageColor", ",", " ", "ageTextColor", ",", " ", "energyColor", ",",
       "\n", "    ", "chooseBarCenter", ",", " ", "otherAgentPositions", ",", 
      "\n", "    ", "agentGraphics", ",", " ", "foodGraphics", ",", " ", 
      "legend", ",", " ", "infoText"}], "\n", "  ", "}"}], ",", "\n", "\n", 
    "  ", 
    RowBox[{
     RowBox[{"agents", " ", "=", " ", 
      RowBox[{"model", "[", "\"\<agents\>\"", "]"}]}], ";", "\n", "  ", 
     RowBox[{"foods", " ", "=", " ", 
      RowBox[{"model", "[", "\"\<foods\>\"", "]"}]}], ";", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"min", ",", " ", "max"}], "}"}], " ", "=", " ", 
      RowBox[{"params", "[", "\"\<squareBounds\>\"", "]"}]}], ";", "\n", "  ", 
     RowBox[{"span", " ", "=", " ", 
      RowBox[{"max", " ", "-", " ", "min"}]}], ";", "\n", "  ", 
     RowBox[{"nAgents", " ", "=", " ", 
      RowBox[{"Length", "[", "agents", "]"}]}], ";"}], "\n", 
    "  "}]}]}]], "Code",
 CellChangeTimes->{
  3.9858876177569065`*^9, {3.9861334030906696`*^9, 
   3.9861334141985397`*^9}},ExpressionUUID->"e2f15b16-b3ab-b241-bf99-\
6c91cc225e71"],

Cell["\<\
Since the bounds of the environment can change, we scaled the graphics to the \
bound of the world. Specifically, if the environment is small, agents and \
food appear larger, whereas if the environment is large, the agents appear \
smaller. Additionally to keep the visualization clean and prevent the grid \
from looking \[OpenCurlyQuote]crowded\[CloseCurlyQuote] as the population \
increases, we used the current population size to control how much detail to \
display. As a result, energy bars are only shown when there are less than 6 \
agents.\
\>", "Text",
 CellChangeTimes->{{3.9858877154274807`*^9, 
  3.985887935015753*^9}},ExpressionUUID->"b3e0cf58-9734-ac4c-aa60-\
c97948927014"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{"agentR", " ", "=", " ", 
     RowBox[{
      RowBox[{"params", "[", "\"\<agentSize\>\"", "]"}], "*", "span"}]}], 
    ";"}], "\n", "  ", 
   RowBox[{
    RowBox[{"foodR", "  ", "=", " ", 
     RowBox[{
      RowBox[{"params", "[", "\"\<foodSize\>\"", "]"}], "*", "span"}]}], 
    ";"}], "\n", "\n", "  ", 
   RowBox[{
    RowBox[{"barW", " ", "=", " ", 
     RowBox[{"0.10", " ", "span"}]}], ";"}], "\n", "  ", 
   RowBox[{
    RowBox[{"barH", " ", "=", " ", 
     RowBox[{"0.015", " ", "span"}]}], ";"}], "\n", "  ", 
   RowBox[{
    RowBox[{"barGap", " ", "=", " ", 
     RowBox[{"0.040", " ", "span"}]}], ";"}], "\n", "\n", "  ", 
   RowBox[{
    RowBox[{"hudPad", " ", "=", " ", 
     RowBox[{"0.001", " ", "span"}]}], ";"}], "\n", "\n", "  ", 
   RowBox[{
    RowBox[{"showEnergyBars", " ", "=", " ", 
     RowBox[{"nAgents", " ", "<", " ", "6"}]}], ";"}]}]}]], "Code",
 CellChangeTimes->{3.985887974792244*^9},
 CellLabel->"In[53]:=",ExpressionUUID->"a2b937c3-51a3-c245-aca8-e92c994e10e0"],

Cell["\<\
The agents\[CloseCurlyQuote] properties, such as age and energy level, are \
represented by color gradients. Specifically, age is shown by a green (young \
agent) to red (old agent) gradient. It is important to note that the agents\
\[CloseCurlyQuote] ages are relative to their total lifespan. This allows us \
to display the age visually, without crowding the grid with other legends. We \
also switch the text color between black and white, depending on each agent\
\[CloseCurlyQuote]s age, to keep the age readable against different gradient \
colors. The energy of each agent is represented by a red-to-green bar, in \
which red represents low energy, while green represents a high energy. These \
energy levels are relative to the max energy defined in the associations.\
\>", "Text",
 CellChangeTimes->{{3.9858880474203854`*^9, 3.9858880675585365`*^9}, {
  3.985888127464985*^9, 
  3.985888463658968*^9}},ExpressionUUID->"99fffb7e-9639-014b-8229-\
f5362dcb763d"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ageColor", "[", "age_", "]"}], " ", ":=", " ", 
     RowBox[{"Blend", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Green", ",", " ", "Yellow", ",", " ", "Orange", ",", " ", "Red"}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"Clip", "[", 
        RowBox[{
         RowBox[{"age", "/", 
          RowBox[{"(", 
           RowBox[{"0.3", " ", 
            RowBox[{"params", "[", "\"\<lifespan\>\"", "]"}]}], ")"}]}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}]}], "\n", "  ", "]"}]}],
     ";"}], "\n", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"ageTextColor", "[", "age_", "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"age", " ", "<", " ", 
        RowBox[{"0.6", " ", 
         RowBox[{"params", "[", "\"\<lifespan\>\"", "]"}]}]}], ",", " ", 
       "Black", ",", " ", "White"}], "]"}]}], ";"}], "\n", "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"energyColor", "[", "frac_", "]"}], " ", ":=", " ", 
     RowBox[{"Blend", "[", "\n", "    ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Red", ",", " ", "Yellow", ",", " ", "Green"}], "}"}], ",", 
       "\n", "    ", 
       RowBox[{"Clip", "[", 
        RowBox[{"frac", ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}]}], "\n", "  ", "]"}]}],
     ";"}]}]}]], "Code",
 CellChangeTimes->{3.9858884851850777`*^9},
 CellLabel->"In[60]:=",ExpressionUUID->"cbd9fdd0-b10d-6848-8e8e-2619affb1637"],

Cell["\<\
Initially, we found it difficult to avoid overlap between text/agent \
information when agents are close together in the grid. So, to fix this, we \
wrote a helper rule to check agent positions and test multiple possible \
locations for the energy bar. Now, the function takes into account the \
positions above, below, left, and right, clips them to stay inside the grid, \
and, by using a scoring method, finds what position maximizes distance from \
nearby agents. Overall, this makes the visualization more readable.\
\>", "Text",
 CellChangeTimes->{{3.9858886105794716`*^9, 3.9858888149097366`*^9}, {
  3.9858890013927574`*^9, 
  3.9858890153372498`*^9}},ExpressionUUID->"4dd04c5b-987e-b344-bb2e-\
c57ecff71511"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"otherAgentPositions", "[", "pos_", "]"}], " ", ":=", " ", 
     RowBox[{"DeleteCases", "[", 
      RowBox[{
       RowBox[{"Lookup", "[", 
        RowBox[{"agents", ",", " ", "\"\<pos\>\""}], "]"}], ",", " ", "pos"}],
       "]"}]}], ";"}], "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"chooseBarCenter", "[", 
      RowBox[{"pos_", ",", " ", "others_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"candidates", ",", " ", "scores"}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{"candidates", " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"pos", " ", "+", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "barGap"}], "}"}]}], ",", " ", 
           RowBox[{"pos", " ", "+", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", 
              RowBox[{"-", "barGap"}]}], "}"}]}], ",", " ", 
           RowBox[{"pos", " ", "+", " ", 
            RowBox[{"{", 
             RowBox[{"barGap", ",", " ", "0"}], "}"}]}], ",", " ", 
           RowBox[{"pos", " ", "+", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "barGap"}], ",", " ", "0"}], "}"}]}]}], "}"}]}], ";",
         "\n", "    ", "\n", "    ", 
        RowBox[{"candidates", " ", "=", " ", 
         RowBox[{"{", "\n", "      ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"candidates", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"min", " ", "+", " ", 
                  RowBox[{"barW", "/", "2"}]}], ",", " ", 
                 RowBox[{"max", " ", "-", " ", 
                  RowBox[{"barW", "/", "2"}]}]}], "}"}]}], "]"}], ",", "\n", 
             "       ", 
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"candidates", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"min", " ", "+", " ", 
                  RowBox[{"barH", "/", "2"}]}], ",", " ", 
                 RowBox[{"max", " ", "-", " ", 
                  RowBox[{"barH", "/", "2"}]}]}], "}"}]}], "]"}]}], "}"}], ",",
            "\n", "      ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"candidates", "[", 
                RowBox[{"[", 
                 RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"min", " ", "+", " ", 
                  RowBox[{"barW", "/", "2"}]}], ",", " ", 
                 RowBox[{"max", " ", "-", " ", 
                  RowBox[{"barW", "/", "2"}]}]}], "}"}]}], "]"}], ",", "\n", 
             "       ", 
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"candidates", "[", 
                RowBox[{"[", 
                 RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"min", " ", "+", " ", 
                  RowBox[{"barH", "/", "2"}]}], ",", " ", 
                 RowBox[{"max", " ", "-", " ", 
                  RowBox[{"barH", "/", "2"}]}]}], "}"}]}], "]"}]}], "}"}], ",",
            "\n", "      ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"candidates", "[", 
                RowBox[{"[", 
                 RowBox[{"3", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"min", " ", "+", " ", 
                  RowBox[{"barW", "/", "2"}]}], ",", " ", 
                 RowBox[{"max", " ", "-", " ", 
                  RowBox[{"barW", "/", "2"}]}]}], "}"}]}], "]"}], ",", "\n", 
             "       ", 
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"candidates", "[", 
                RowBox[{"[", 
                 RowBox[{"3", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"min", " ", "+", " ", 
                  RowBox[{"barH", "/", "2"}]}], ",", " ", 
                 RowBox[{"max", " ", "-", " ", 
                  RowBox[{"barH", "/", "2"}]}]}], "}"}]}], "]"}]}], "}"}], ",",
            "\n", "      ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"candidates", "[", 
                RowBox[{"[", 
                 RowBox[{"4", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"min", " ", "+", " ", 
                  RowBox[{"barW", "/", "2"}]}], ",", " ", 
                 RowBox[{"max", " ", "-", " ", 
                  RowBox[{"barW", "/", "2"}]}]}], "}"}]}], "]"}], ",", "\n", 
             "       ", 
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"candidates", "[", 
                RowBox[{"[", 
                 RowBox[{"4", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"min", " ", "+", " ", 
                  RowBox[{"barH", "/", "2"}]}], ",", " ", 
                 RowBox[{"max", " ", "-", " ", 
                  RowBox[{"barH", "/", "2"}]}]}], "}"}]}], "]"}]}], "}"}]}], 
          "}"}]}], ";", "\n", "       ", "\n", "    ", 
        RowBox[{"scores", " ", "=", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "others", "]"}], " ", "==", " ", "0"}], ",", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"1", ",", " ", 
             RowBox[{"Length", "[", "candidates", "]"}]}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Min", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Norm", "[", 
                 RowBox[{"#", " ", "-", " ", "#2"}], "]"}], " ", "&"}], " ", "@@@",
                " ", 
               RowBox[{"Tuples", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", "#", "}"}], ",", " ", "others"}], "}"}], 
                "]"}]}], "]"}], " ", "&"}], " ", "/@", " ", "candidates"}]}], 
          "]"}]}], ";", "\n", "    ", 
        RowBox[{"candidates", "[", 
         RowBox[{"[", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Ordering", "[", 
            RowBox[{"scores", ",", " ", 
             RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}]}]}], "]"}]}], 
    ";"}]}]}]], "Code",
 CellChangeTimes->{
  3.985888827314373*^9, {3.985888859901697*^9, 3.9858889196764812`*^9}},
 CellLabel->"In[63]:=",ExpressionUUID->"78041323-e436-724f-8446-c536bd7f942e"],

Cell[TextData[{
 "In the grid, agents are represented by circles whose radii scales with ",
 StyleBox["squareBounds",
  FontWeight->"Bold"],
 ", and their ages are shown inside the circle to make it easier to identify \
both the approximate lifecycle stage and the exact age together. When energy \
bars are enabled, they are displayed next to the agent and filled to the \
current energy level, with a number inside the bar for the exact energy \
level.  Additionally, food is shown as smaller circles that are also scaled \
with the grid."
}], "Text",
 CellChangeTimes->{{3.9858890363716373`*^9, 
  3.9858892126759624`*^9}},ExpressionUUID->"91206454-e921-0e4c-a94b-\
c8b9bc38c9a3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"agentGraphics", " ", "=", " ", 
    RowBox[{"Table", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "pos", ",", " ", "age", ",", " ", "e", ",", " ", "frac", ",", " ", 
          "percent", ",", " ", "fillColor", ",", " ", "txtColor", ",", 
          "barCenter", ",", " ", "barLeft", ",", " ", "barBottom"}], "}"}], ",",
         "\n", "\n", "      ", 
        RowBox[{
         RowBox[{"pos", " ", "=", " ", 
          RowBox[{"agent", "[", "\"\<pos\>\"", "]"}]}], ";", "\n", "      ", 
         RowBox[{"age", " ", "=", " ", 
          RowBox[{"agent", "[", "\"\<age\>\"", "]"}]}], ";", "\n", "      ", 
         RowBox[{"e", " ", "=", " ", 
          RowBox[{"agent", "[", "\"\<energy\>\"", "]"}]}], ";", "\n", "\n", 
         "      ", 
         RowBox[{"frac", " ", "=", " ", 
          RowBox[{"Clip", "[", 
           RowBox[{
            RowBox[{"e", "/", 
             RowBox[{"params", "[", "\"\<maxEnergy\>\"", "]"}]}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}]}], ";", "\n", 
         "      ", 
         RowBox[{"percent", " ", "=", " ", 
          RowBox[{"Round", "[", 
           RowBox[{"100", " ", "frac"}], "]"}]}], ";", "\n", "\n", "      ", 
         RowBox[{"fillColor", " ", "=", " ", 
          RowBox[{"ageColor", "[", "age", "]"}]}], ";", "\n", "      ", 
         RowBox[{"txtColor", " ", "=", " ", 
          RowBox[{"ageTextColor", "[", "age", "]"}]}], ";", "\n", "\n", 
         "      ", 
         RowBox[{"barCenter", " ", "=", " ", 
          RowBox[{"chooseBarCenter", "[", 
           RowBox[{"pos", ",", " ", 
            RowBox[{"otherAgentPositions", "[", "pos", "]"}]}], "]"}]}], ";", 
         "\n", "      ", 
         RowBox[{"barLeft", " ", "=", " ", 
          RowBox[{
           RowBox[{"barCenter", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
           RowBox[{"barW", "/", "2"}]}]}], ";", "\n", "      ", 
         RowBox[{"barBottom", " ", "=", " ", 
          RowBox[{
           RowBox[{"barCenter", "[", 
            RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
           RowBox[{"barH", "/", "2"}]}]}], ";", "\n", "\n", "      ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"EdgeForm", "[", 
            RowBox[{"Directive", "[", 
             RowBox[{"White", ",", " ", 
              RowBox[{"Thickness", "[", "0.0015", "]"}]}], "]"}], "]"}], ",", 
           "fillColor", ",", 
           RowBox[{"Disk", "[", 
            RowBox[{"pos", ",", " ", "agentR"}], "]"}], ",", 
           RowBox[{"Text", "[", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"ToString", "[", 
                RowBox[{"Round", "[", "age", "]"}], "]"}], ",", 
               RowBox[{"Max", "[", 
                RowBox[{"7", ",", " ", 
                 RowBox[{"Round", "[", 
                  RowBox[{"0.018", " ", 
                   RowBox[{"params", "[", "\"\<imageSize\>\"", "]"}]}], 
                  "]"}]}], "]"}], ",", "txtColor", ",", "Bold"}], "]"}], ",", 
             "pos"}], "]"}], ",", "\n", "        ", 
           RowBox[{"If", "[", 
            RowBox[{"showEnergyBars", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"EdgeForm", "[", 
                RowBox[{"Directive", "[", 
                 RowBox[{"White", ",", " ", 
                  RowBox[{"Thickness", "[", "0.0012", "]"}]}], "]"}], "]"}], ",", 
               RowBox[{"Darker", "[", 
                RowBox[{"Gray", ",", " ", "0.75"}], "]"}], ",", 
               RowBox[{"Rectangle", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"barLeft", ",", " ", "barBottom"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"barLeft", " ", "+", " ", "barW"}], ",", " ", 
                   RowBox[{"barBottom", " ", "+", " ", "barH"}]}], "}"}]}], 
                "]"}], ",", 
               RowBox[{"energyColor", "[", "frac", "]"}], ",", "\n", 
               "        ", 
               RowBox[{"Rectangle", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"barLeft", ",", " ", "barBottom"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"barLeft", " ", "+", " ", 
                    RowBox[{"barW", " ", "frac"}]}], ",", " ", 
                   RowBox[{"barBottom", " ", "+", " ", "barH"}]}], "}"}]}], 
                "]"}], ",", " ", 
               RowBox[{"Text", "[", 
                RowBox[{
                 RowBox[{"Style", "[", 
                  RowBox[{
                   RowBox[{"ToString", "[", "percent", "]"}], ",", 
                   RowBox[{"Max", "[", 
                    RowBox[{"6", ",", " ", 
                    RowBox[{"Round", "[", 
                    RowBox[{"0.014", " ", 
                    RowBox[{"params", "[", "\"\<imageSize\>\"", "]"}]}], 
                    "]"}]}], "]"}], ",", "Magenta"}], "]"}], ",", 
                 "barCenter"}], "]"}]}], "}"}], ",", "Nothing"}], "]"}]}], 
          "}"}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"agent", ",", " ", "agents"}], "}"}]}], "]"}]}], ";"}], "\n", 
  "          "}], "\n", 
 RowBox[{"    ", 
  RowBox[{
   RowBox[{"foodGraphics", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"White", ",", " ", 
        RowBox[{"Disk", "[", 
         RowBox[{"f", ",", " ", "foodR"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"f", ",", " ", "foods"}], "}"}]}], "]"}]}], ";"}]}]}], "Code",
