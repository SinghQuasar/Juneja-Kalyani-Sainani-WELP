Cell[TextData[{
 "Before reproductive and parenting functions/strategies were implemented \
into agents, the core aspects of the model like agents that moved and \
consumed food were built first. For an agent to consume food to gain energy, \
a piece of food needs to be within the model\[CloseCurlyQuote]s ",
 StyleBox["proximity radius ",
  FontWeight->"Bold"],
 "[is there a way to do inline code cells?]. Euclidian distance in the ",
 StyleBox["checkWithinRadius",
  FontWeight->"Bold"],
 " function is used to verify if a piece of food is close enough to an agent."
}], "Text",
 CellChangeTimes->{{3.986133935459646*^9, 3.986134001026058*^9}, {
  3.986134128371048*^9, 3.9861341682006283`*^9}, {3.9861342216344566`*^9, 
  3.986134225347433*^9}, {3.9861354205280743`*^9, 3.986135502323677*^9}, {
  3.9861355479464245`*^9, 
  3.9861355974950294`*^9}},ExpressionUUID->"43f7f145-fa31-224c-a685-\
bceff4b4876e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"checkWithinRadius", "[", 
    RowBox[{"p1_", ",", " ", "p2_", ",", " ", "r_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"EuclideanDistance", "[", 
     RowBox[{"p1", ",", " ", "p2"}], "]"}], " ", "<=", " ", "r"}]}], 
  ";"}]], "Code",
 CellChangeTimes->{3.986135602936306*^9},
 CellLabel->"In[2]:=",ExpressionUUID->"f149d8ae-5cdf-7148-be2a-169ee1c31973"]
}, Open  ]],

