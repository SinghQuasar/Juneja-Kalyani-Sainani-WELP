Cell[CellGroupData[{

Cell["Model Parameters", "Section",
 CellChangeTimes->{{3.9861346944682255`*^9, 3.986134699014679*^9}, {
  3.9861347846181145`*^9, 3.9861347951362133`*^9}, {3.9861366439729843`*^9, 
  3.9861366489353695`*^9}, {3.9866530520267925`*^9, 
  3.9866530526883984`*^9}},ExpressionUUID->"7dc9621c-5827-ef4a-8786-\
41ddeeebf367"],

Cell["\<\
These are model parameters stored as an association that set the rules for a \
simulation, and a user may freely tweak them to model certain environmental \
scenarios or use these as independent variables to run empirical experiments. \
Most functions of the model take in this parameters association to understand \
how they should work and to what extent their functions should affect \
model/agent state. Comments following each parameter outlines its purpose. \
Parameters, and thus the model, is defined in arbitrary units: arbitrary \
distance units, arbitrary time units, and arbitrary energy units.\
\>", "Text",
 CellChangeTimes->{
  3.986134702431364*^9, {3.9861349670242786`*^9, 3.9861350151841335`*^9}, {
   3.9866530586789455`*^9, 3.9866530630536213`*^9}, {3.9866539617015514`*^9, 
   3.9866539901637287`*^9}, {3.9866542471128273`*^9, 3.986654249513815*^9}, {
   3.9866543327970047`*^9, 3.986654545327215*^9}, {3.986654578512396*^9, 
   3.986654579597225*^9}, {3.9866546113092575`*^9, 3.9866546690151215`*^9}, {
   3.9866547079760723`*^9, 3.9866547221788425`*^9}, {3.986654994727091*^9, 
   3.986655051410116*^9}},ExpressionUUID->"8ff26a7a-b98b-fb49-a9f6-\
7615dc0ce169"],

Cell[BoxData[
 RowBox[{
  RowBox[{"parameters", " ", "=", " ", 
   RowBox[{"<|", " ", "\n", "  ", 
    RowBox[{
     RowBox[{"\"\<proximityRadius\>\"", " ", "->", " ", "0.5"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{"How", " ", "close", " ", "two", " ", "things", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"agent", "/", "food"}], ",", " ", 
         RowBox[{"agent", "/", "agent"}], ",", " ", 
         RowBox[{"child", "/", "parent"}], ",", " ", 
         RowBox[{"etc", "."}]}], ")"}], " ", "need", " ", "to", " ", "be", " ",
        "to", " ", "interact", " ", 
       RowBox[{"(", 
        RowBox[{"eat", ",", " ", "reproduce", ",", " ", "feed", ",", " ", 
         RowBox[{"etc", "."}]}], ")"}]}], "*)"}], "\n", "  ", 
     RowBox[{"\"\<sensingDistance\>\"", " ", "->", " ", "2"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "How", " ", "far", " ", "away", " ", "agents", " ", "can", " ", 
        "sense", " ", "in", " ", "arbitrar", " ", "distance", " ", "units"}], 
       ",", " ", 
       RowBox[{
       "and", " ", "by", " ", "consequence", " ", "intentionally", " ", 
        "travel", " ", "to"}], ",", " ", 
       RowBox[{
       "pieces", " ", "of", " ", "food", " ", "or", " ", "other", " ", 
        "agents", " ", "like", " ", "children", " ", "and", " ", "mating", " ",
         "partners"}]}], "*)"}], "\n", "  ", 
     RowBox[{"\"\<dt\>\"", " ", "->", " ", "0.1"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
      "The", " ", "timestep", " ", "in", " ", "arbitrary", " ", "time", " ", 
       "units", " ", "used", " ", "in", " ", "the", " ", "discretization", " ",
        "of", " ", "the", " ", "simulation"}], "*)"}], "\n", "  ", 
     RowBox[{"\"\<metabolism\>\"", " ", "->", " ", "0.2"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
      "How", " ", "much", " ", "energy", " ", "is", " ", "expended", " ", 
       "each", " ", "timestep", " ", "by", " ", "an", " ", "agent"}], "*)"}], 
     "\n", "  ", 
     RowBox[{"\"\<foodEnergy\>\"", " ", "->", " ", "5.0"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
      "How", " ", "much", " ", "energy", " ", "is", " ", "gained", " ", 
       "from", " ", "one", " ", "piece", " ", "of", " ", "food", " ", "for", " ",
        "an", " ", "agent"}], "*)"}], "\n", "  ", 
     RowBox[{"\"\<foodSpawnCooldown\>\"", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
      "The", " ", "cooldown", " ", "in", " ", "arbitrary", " ", "time", " ", 
       "units", " ", "of", " ", "food", " ", "spawning"}], "*)"}], "\n", "  ", 
     RowBox[{"\"\<nFoodSpawn\>\"", " ", "->", " ", "3"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
      "The", " ", "number", " ", "of", " ", "pieces", " ", "of", " ", "food", 
       " ", "spawned", " ", "at", " ", "random", " ", "locations", " ", 
       "every", " ", "time", " ", "foodSpawnCooldown", " ", "passes"}], 
      "*)"}], "\n", "  ", 
     RowBox[{"\"\<nStartingAgents\>\"", " ", "->", " ", "5"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
      "The", " ", "number", " ", "of", " ", "agents", " ", "the", " ", 
       "simulation", " ", "starts", " ", "with"}], "*)"}], "\n", "  ", 
     RowBox[{"\"\<nStartingFood\>\"", " ", "->", " ", "7"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
      "The", " ", "number", " ", "of", " ", "pieces", " ", "of", " ", "food", 
       " ", "that", " ", "the", " ", "simulation", " ", "starts", " ", 
       "with"}], "*)"}], "\n", "  ", 
     RowBox[{"\"\<squareBounds\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "10"}], "}"}]}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"The", " ", "bounds", " ", "of", " ", "the", " ", "model"}], ",",
        " ", 
       RowBox[{
       "with", " ", "both", " ", "dimensions", " ", "of", " ", "the", " ", 
        "model", " ", "taking", " ", "this", " ", "range", " ", "of", " ", 
        RowBox[{"numbers", ".", " ", "The"}], " ", "lower", " ", "bound", " ",
         "must", " ", "be", " ", "zero"}], ",", " ", 
       RowBox[{
       "and", " ", "by", " ", "consequence", " ", "of", " ", "this", " ", 
        "design"}], ",", " ", 
       RowBox[{"the", " ", "model", " ", "is", " ", 
        RowBox[{"square", "."}]}]}], "*)"}], "\n", "  ", 
     RowBox[{"\"\<startingEnergy\>\"", " ", "->", " ", "10"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
      "The", " ", "amount", " ", "of", " ", "energy", " ", "an", " ", "agent",
        " ", "starts", " ", "with"}], "*)"}], "\n", "  ", 
     RowBox[{"\"\<stepLength\>\"", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "How", " ", "far", " ", "an", " ", "agent", " ", "can", " ", "travel", 
        " ", "in", " ", "one", " ", "timestep"}], ",", " ", 
       RowBox[{"if", " ", "they", " ", "choose", " ", "to", " ", "travel"}]}],
       "*)"}], "\n", "  ", 
     RowBox[{"\"\<dirChangeProb\>\"", " ", "->", " ", "0.2"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "If", " ", "an", " ", "agent", " ", "is", " ", "not", " ", 
        "intentionally", " ", "moving", " ", "and", " ", "exploring", " ", 
        "instead"}], ",", " ", 
       RowBox[{
       "this", " ", "is", " ", "the", " ", "probability", " ", "at", " ", 
        "any", " ", "timestep", " ", "that", " ", "they", " ", "will", " ", 
        "change", " ", "their", " ", "exploration", " ", 
        RowBox[{"direction", "."}]}]}], "*)"}], "\n", "  ", 
     RowBox[{"\"\<lifespan\>\"", " ", "->", " ", "20"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
      "How", " ", "long", " ", "in", " ", "arbitrary", " ", "time", " ", 
       "units", " ", "an", " ", "agent", " ", "is", " ", "allowed", " ", "to",
        " ", "live"}], "*)"}], "\n", "  ", 
     RowBox[{"\"\<maxEnergy\>\"", " ", "->", " ", "10"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
      "The", " ", "most", " ", "energy", " ", "an", " ", "agent", " ", "can", 
       " ", "store"}], "*)"}], "\n", "  ", 
     RowBox[{"\"\<imageSize\>\"", " ", "->", " ", "500"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"How", " ", "large"}], ",", " ", 
       RowBox[{"in", " ", "pixels"}], ",", " ", 
       RowBox[{
       "the", " ", "size", " ", "of", " ", "the", " ", "simulation", " ", 
        "is"}]}], "*)"}], "\n", "  ", 
     RowBox[{"\"\<agentSize\>\"", " ", "->", " ", "0.025"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
      "The", " ", "radius", " ", "of", " ", "an", " ", "agent", " ", "blob", " ",
        "in", " ", "the", " ", "visualization", " ", "in", " ", "aribtrary", " ",
        "distance", " ", "units"}], "*)"}], "\n", "  ", 
     RowBox[{"\"\<foodSize\>\"", " ", "->", " ", "0.01"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
      "The", " ", "radius", " ", "of", " ", "a", " ", "piece", " ", "of", " ",
        "food", " ", "in", " ", "the", " ", "visualization", " ", "in", " ", 
       "aribtrary", " ", "distance", " ", "units"}], "*)"}], "\n", "  ", 
     RowBox[{"\"\<reproductionRadius\>\"", " ", "->", " ", "1.5"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{"FIX", " ", "-", " ", 
       RowBox[{
       "this", " ", "should", " ", "be", " ", "superceded", " ", "by", " ", 
        "proximityRadius"}]}], "*)"}], "\n", "  ", 
     RowBox[{"\"\<minReproductionEnergy\>\"", " ", "->", " ", "6.0"}], ",", 
     " ", 
     RowBox[{"(*", 
      RowBox[{"FIX", " ", "-", " ", 
       RowBox[{
       "The", " ", "minimmum", " ", "energy", " ", "an", " ", "agent", " ", 
        "must", " ", "have", " ", "to", " ", "devote", " ", "its", " ", 
        "efforts", " ", "to", " ", "reproduction", " ", "opposed", " ", "to", 
        " ", "mere", " ", "survival", " ", 
        RowBox[{"(", 
         RowBox[{"confirm", " ", "this", " ", "with", " ", "paper"}], 
         ")"}]}]}], "*)"}], "\n", "  ", 
     RowBox[{"\"\<minReproductionAge\>\"", " ", "->", " ", "2.0"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{"FIX", " ", "-", " ", 
       RowBox[{
       "Reproductive", " ", "maturity", " ", "age", " ", "for", " ", "an", " ",
         "agent", " ", 
        RowBox[{"(", 
         RowBox[{
         "is", " ", "this", " ", "also", " ", "the", " ", "definition", " ", 
          "of", " ", "adulthood"}], ")"}]}]}], "*)"}], "\n", "  ", 
     RowBox[{"\"\<reproductionEnergyCost\>\"", " ", "->", " ", "3.0"}], ",", 
     " ", 
     RowBox[{"(*", 
      RowBox[{"FIX", " ", "-", " ", 
       RowBox[{"How", " ", "much", " ", "having", " ", "one", " ", "child", " ", 
