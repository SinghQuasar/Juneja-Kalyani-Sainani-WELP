Cell[CellGroupData[{
Cell["\<\
Simulating the Emergence of Reproductive and Parenting Strategies using \
Agent-Based Modeling with Evolutionary Game Theory\
\>", "Title",
 CellChangeTimes->{{3.9821898656762505`*^9, 3.9821898716910725`*^9}, {
  3.9821909533992023`*^9, 
  3.9821909930457573`*^9}},ExpressionUUID->"fc779f64-94a4-1645-96da-\
b7c48e9320a8"],

Cell[CellGroupData[{

Cell["Abstract", "Section",
 CellChangeTimes->{{3.9821910469212837`*^9, 3.9821910577482967`*^9}, {
  3.982191106682844*^9, 3.982191126018154*^9}, {3.982191398995737*^9, 
  3.9821914059070625`*^9}},ExpressionUUID->"b47a9adc-7996-504b-8c35-\
2c9e4daa3d69"],

Cell["We\[CloseCurlyQuote]ll work on this during the last couple of \
sprints.", "Text",
 CellChangeTimes->{{3.9821914125019894`*^9, 
  3.9821914624889736`*^9}},ExpressionUUID->"badd546a-7765-9842-941a-\
3decf455c43d"]
