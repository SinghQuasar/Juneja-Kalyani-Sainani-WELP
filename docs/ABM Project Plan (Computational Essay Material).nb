Cell["Implementation", "Section",
 CellChangeTimes->{{3.9776635949045715`*^9, 
  3.9776635960305233`*^9}},ExpressionUUID->"8bc61b01-5bb8-274f-8245-\
31fd0f14f4b0"],

Cell[TextData[{
 StyleBox["\tPrimer\[CloseCurlyQuote]s ",
  FontSlant->"Italic"],
 "success comes not only from the power of his simplistic simulations but \
also the visuals that he provides, which honestly dazzled us. We don\
\[CloseCurlyQuote]t hope to completely mimic ",
 StyleBox["Primer",
  FontSlant->"Italic"],
 ", as that would not be original work, but our implementation, on a \
higher-level, takes heavy inspiration from the process with which ",
 StyleBox["Primer ",
  FontSlant->"Italic"],
 "uses to explore evolution and behavior. Note he was not the first to \
implement ecological ABM in this manner."
}], "Text",
 CellChangeTimes->{{3.97766360293058*^9, 3.977663603467249*^9}, {
