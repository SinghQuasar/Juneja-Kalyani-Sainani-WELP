                RowBox[{"barLeft", " ", "+", " ", "barW"}], ",", " ", 
                RowBox[{"barBottom", " ", "+", " ", "barH"}]}], "}"}]}], 
             "]"}], ",", 
            RowBox[{"energyColor", "[", "frac", "]"}], ",", "\n", " ", 
