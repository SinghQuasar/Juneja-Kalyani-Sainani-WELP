              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"ToString", "[", "percent", "]"}], ",", 
                RowBox[{"Max", "[", 
                 RowBox[{"6", ",", " ", 
                  RowBox[{"Round", "[", 
                   RowBox[{"0.014", " ", 
                    RowBox[{"params", "[", "\"\<imageSize\>\"", "]"}]}], 
                   "]"}]}], "]"}], ",", "Magenta"}], "]"}], ",", 
              "barCenter"}], "]"}]}], "}"}], ",", "Nothing"}], "]"}]}], 
       "}"}]}], "]"}], ",", 
