Cell[CellGroupData[{

Cell["Abstract", "Section",
 CellChangeTimes->{{3.9821910469212837`*^9, 3.9821910577482967`*^9}, {
  3.982191106682844*^9, 3.982191126018154*^9}, {3.982191398995737*^9, 
  3.9821914059070625`*^9}},ExpressionUUID->"b8dfcc23-4eaf-6b41-b25a-\
77365584fdb7"],

Cell[TextData[StyleBox["\tIn this work, we present a custom \
bioenergetics-informed ecological Agent-Based Modeling (ABM) toolbox for \
colonies of artificial organisms in the Wolfram Language. We investigated  \
energy and population dynamics with connections to real-world biology using \
this toolbox. Unlike previous Agent-Based Modeling projects done in the \
Wolfram Language, our interactive toolbox provides the user with the ability \
to change and visualize the effects of the parameters used by the artificial \
colonies such as resolution of simulation time-discretization, sensing and \
interaction abilities of organisms, metabolic rates, lifespans, \
exploration/foraging behaviors, reproductive frequencies, and bioenergetics \
like digestion and reproduction energies. Our tests show that ecological \
models produced by the toolbox mimic population dynamics on a macro-level as \
seen in real-world ecology through experimentation on metabolic rates, \
primary production rates, caloric densities and reproductive frequencies with \
a logistic analysis of population growth and collection of other demographic \
data.",
 Background->RGBColor[1., 1., 1.]]], "Text",
 CellChangeTimes->{{3.9821914125019894`*^9, 3.9821914624889736`*^9}, {
  3.9886678201103325`*^9, 3.9886678217355022`*^9}, {3.989440320680421*^9, 
  3.989440393967486*^9}, {3.989440600540518*^9, 3.98944060090436*^9}, {
  3.989440643266303*^9, 3.989440643844903*^9}, {3.9894406750947866`*^9, 
  3.98944071306076*^9}, {3.989440765961154*^9, 3.98944079422965*^9}, {
  3.989960592538004*^9, 3.9899606378792057`*^9}, {3.9900500753101196`*^9, 
  3.990050081001421*^9}},ExpressionUUID->"a1367402-9399-7943-929d-\
4bdc3cea3ffa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Introduction", "Section",
 CellChangeTimes->{{3.98219114556913*^9, 
  3.9821911516783543`*^9}},ExpressionUUID->"360cc6bf-5ab0-1240-8e97-\
c36814b1b790"],

Cell[TextData[{
 "\tWe developed an agent-based modeling toolbox to study how simple \
bioenergetic rules shape population-level dynamics. In the model, individual \
agents move through an environment bounded by a square, sense food, interact \
with other agents, consume energy, reproduce, age, and die. Each agent \
follows relatively simple rules, and the population as a whole can show \
certain emergent behaviors that will be discussed in this study, such as \
logistic growth, carrying capacity, variation in reproduction timing, and \
differences in mortality. The toolbox\[CloseCurlyQuote]s simulation logic \
incorporates movement, organisms dynamically sensing their environment and \
adjusting foraging and mating decisions, energy consumption, reproduction, \
and aging, as well as a visualization that maps each timestep to show how \
agents undergo all of these behaviors, which are informed through \
bioenergetics. Bioenergetics is the study of how organisms acquire, \
transform, store, and expend energy, and how those energy flows determine \
biological outcomes like growth, reproduction, movement, and survival  ",
 ButtonBox["[RN1]",
  BaseStyle->"Hyperlink",
  ButtonData->"ref"],
 ". With this \[OpenCurlyQuote]toolbox,\[CloseCurlyQuote] we test how \
environmental and biological parameters affect population outcomes. \
Specifically, we vary factors such as food availability, metabolism, \
reproduction energy cost, and reproduction age, then record their effects on \
population size, carrying capacity, growth rate, first reproduction age, and \
lifespan. Since our model has limited space that introduces competition \
between agents (if two agents attempt to eat the same food it is determined \
randomly which eats it) and a constrained amount of food that is spawned \
(simulating primary production in an ecosystem), the environment has a \
limited potential for growth, and the populations of colonies were \
accordingly found to naturally trend towards logistic growth. Logistic growth \
is governed by the following differential equation, which embeds the \
constrained nature of the population growth into its structure with the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"1", "-", 
     FractionBox["P", "K"]}], ")"}], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->"e4fcb4bd-9eea-b84d-afb7-d5cb36ed4919"],
 " factor ",
 ButtonBox["[NG1]",
  BaseStyle->"Hyperlink",
  ButtonData->"ref"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9861323120985794`*^9, 3.9861323179159927`*^9}, 
   3.9861323561213703`*^9, {3.9861327597572536`*^9, 3.9861328696856537`*^9}, {
   3.986132940158207*^9, 3.9861329886130104`*^9}, {3.986133114661625*^9, 
   3.986133161320118*^9}, {3.9861334921382465`*^9, 3.9861335766738815`*^9}, {
   3.986133761947159*^9, 3.986133790376301*^9}, {3.988667841027857*^9, 
   3.9886679197390842`*^9}, {3.988667974136898*^9, 3.9886679784752083`*^9}, {
   3.9886680190840263`*^9, 3.9886680195578976`*^9}, {3.9887490806700535`*^9, 
   3.988749088959692*^9}, {3.989961295641487*^9, 3.989961463365324*^9}, {
   3.989961573173828*^9, 3.9899615904358597`*^9}, {3.990050569987694*^9, 
   3.9900506101259956`*^9}, {3.990050654249031*^9, 3.9900506601908894`*^9}, {
   3.990052475085047*^9, 
   3.9900524956331024`*^9}},ExpressionUUID->"502cb621-c630-0c46-9adf-\
9397e118afeb"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     FractionBox["dP", "dt"], "=", " ", 
     RowBox[{"rP", "(", 
      RowBox[{"1", "-", 
       FractionBox["P", "K"]}], ")"}]}],
    FontSize->18], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->"85b1cf30-c700-d14b-bf7d-e62d298bbac7"],
 "\t\t(1)"
}], "Text",
 CellChangeTimes->{{3.988667983903784*^9, 3.9886679854296*^9}, {
  3.9886680432898235`*^9, 3.988668062317316*^9}, {3.988668577821993*^9, 
  3.988668583097761*^9}},
 TextAlignment->Center,ExpressionUUID->"eb0f6cd2-a9bf-2948-b793-4a31ec8307c4"],

Cell["\<\
Separating and integrating this differential equation gives the form that we \
use among other curves to fit to our population data among other data for \
analysis\
\>", "Text",
 CellChangeTimes->{{3.9886680218284607`*^9, 3.9886680339560013`*^9}, {
   3.9886680871550217`*^9, 3.9886684035609074`*^9}, {3.9886684564480705`*^9, 
   3.9886684692912884`*^9}, 3.9886687350280476`*^9, {3.98874911295286*^9, 
   3.988749115919861*^9}, 3.9899617638005257`*^9, 
   3.9899618077258244`*^9},ExpressionUUID->"e778a58a-4526-ee44-b55a-\
99790c8a1050"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"P", "(", "t", ")"}], "=", " ", 
    FractionBox["K", 
     RowBox[{"1", 
      StyleBox[" ",
       FontSlant->"Italic"], "+", 
      StyleBox[" ",
       FontSlant->"Italic"], 
      StyleBox[
       SuperscriptBox["Ae", 
        RowBox[{
         RowBox[{"-", "r"}], " ", "t"}]],
       FontSlant->"Italic"]}]]}], TraditionalForm]],
  FontSize->18,ExpressionUUID->"d9952903-88b0-664f-8358-3b6cf2b6de93"],
 StyleBox["\t\t",
  FontSize->18],
 StyleBox["(2)",
  FontSize->15]
}], "Text",
 CellChangeTimes->{{3.9886685755629025`*^9, 3.988668600000784*^9}, {
  3.988668638795864*^9, 3.9886686964579735`*^9}},
 TextAlignment->Center,ExpressionUUID->"ff36b74c-0421-5e40-8939-d7150466e825"],

Cell["\<\
Where K represents carrying capacity, r represents intrinsic growth rate, and \
A represents the relationship between the initial population and carrying \
capacity. These variables allow us to compare how different parameter values \
affect population-level behavior as a whole.

\tOverall, through these experiments, we show how simple rules can influence \
a population\[CloseCurlyQuote]s dynamics and characteristics, and how our \
Agent-Based Modeling toolbox can be used as a flexible foundation for \
studying further ecological systems and emergent population-level and \
agent-level behaviors not only because it exhibits such behavior like \
logistic growth, but also because of its flexibility from the infinite \
possibilities its large number of customizable parameters provides.\
\>", "Text",
 CellChangeTimes->{{3.988668728888998*^9, 3.9886687455668926`*^9}, {
  3.988668869889372*^9, 3.988668895236967*^9}, {3.988748980369911*^9, 
  3.988749056459652*^9}, {3.9899618187267056`*^9, 
  3.989961884717642*^9}},ExpressionUUID->"714da562-6d9a-eb4f-a128-\
29a2ee5f9461"]
}, Open  ]],

Cell[CellGroupData[{

Cell["High-Level Model Development", "Section",
 CellChangeTimes->{{3.9821913146818466`*^9, 3.9821913242147045`*^9}, {
  3.982192215691025*^9, 3.9821922192738476`*^9}, {3.9861321372110233`*^9, 
  3.9861321384283543`*^9}, {3.9861323673518295`*^9, 3.9861323738913193`*^9}, {
  3.986132689062084*^9, 3.9861326893698616`*^9}, {3.9887637607497063`*^9, 
  3.988763762634386*^9}},ExpressionUUID->"70fc7f0d-3b96-5746-9f8b-\
a221eddd0345"],

Cell["\<\
\tWe designed our Agent-Based model from the ground up to be customizable for \
the user, making it easy to run experiments and test hypotheses. The \
simulation is complete with visuals and animations, showing what\
\[CloseCurlyQuote]s going on behind the raw data. All behavior, except for \
random movement when needed, is deterministic and always based on the \
starting parameters. It is important to note that agents do not \
\[OpenCurlyDoubleQuote]feel\[CloseCurlyDoubleQuote] or are not provided \
\[OpenCurlyDoubleQuote]rewards\[CloseCurlyDoubleQuote] by the simulation. \
Rather, natural selection drives some agents to do better than others, \
causing other agents to die out, showing how certain parameters support life \
better or worse.
\tAgents are organisms with age and energy, must consume resources to \
survive, move, reproduce, and optionally invest energy in offspring. When \
deciding on what action an agent takes every time step, we took inspiration \
from a British Ecological Society paper outlining the general order of \
importance:\
\>", "Text",
 CellChangeTimes->{{3.988763766086323*^9, 
  3.9887637744105415`*^9}},ExpressionUUID->"59fca697-d12d-3346-bfdb-\
adaa9aed9a22"],

Cell[TextData[{
 " \[OpenCurlyDoubleQuote]If there is sufficient energy intake, an animal \
allocates the energy obtained in the order: maintenance, growth, \
reproduction, energy storage, until its energy stores reach an optimal level. \
If there is a shortfall, the priorities for maintenance and \
growth/reproduction remain the same until reserves fall to a critical \
threshold below which all are allocated to maintenance.\
\[CloseCurlyDoubleQuote] - ",
 ButtonBox["[RS1]",
  BaseStyle->"Hyperlink",
  ButtonData->"ref"]
}], "Text",
 CellChangeTimes->{{3.9887637804169273`*^9, 3.988763815032461*^9}, {
  3.9893620398054466`*^9, 3.9893620696853924`*^9}, {3.990052509113123*^9, 
  3.990052509113123*^9}},
 TextAlignment->Center,ExpressionUUID->"cd87bd72-9d72-8c4b-a3b0-3ec262e7e4ab"],

Cell[TextData[{
 "\tIn our model, agents unavoidably lose energy every time step through \
\[OpenCurlyDoubleQuote]metabolism.\[CloseCurlyDoubleQuote] When deciding to \
take an action, in the agentActions function, we first look at if the agent \
meets all the criteria to reproduce. This includes having enough energy, \
having another non-related agent in the sensing radius, not being on a \
reproduction cooldown, and having existed for long enough. Agents need a \
minimum amount of energy before looking to reproduce because \
growth/sustenance is of a higher priority than reproduction ",
 ButtonBox["[RS1]",
  BaseStyle->"Hyperlink",
  ButtonData->"ref"],
 ". If there is no suitable mate, the agent then looks for food in proximity. \
If it is close enough, it eats it. If not, the agent moves towards the food. \
And finally, if the agent doesn\[CloseCurlyQuote]t see anything in its \
radius, it picks a random exploration direction and walks. The agent has a \
random chance to change directions every time step when exploring, so it is \
able to more effectively explore a single direction before looking elsewhere. \
If an agent tries to leave the bounds, its position is clipped to the bounds, \
and if it is half a step away from the bounds, the direction it is moving in \
changes. The environment supplies food containing energy every timestep to \
simulate primary production (usually plants producing organic matter from \
sunlight) in the ecosystem. Because of this, the organisms we simulate are \
primary consumers."
}], "Text",
 CellChangeTimes->{{3.9887637903073177`*^9, 3.988763793208187*^9}, {
  3.9893620541188545`*^9, 3.9893620650929623`*^9}, {3.990052524056196*^9, 
  3.990052524056196*^9}},ExpressionUUID->"b3e7803b-daa2-e64a-914d-\
0b50b842eaa8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Model Parameters", "Section",
 CellChangeTimes->{{3.9861346944682255`*^9, 3.986134699014679*^9}, {
  3.9861347846181145`*^9, 3.9861347951362133`*^9}, {3.9861366439729843`*^9, 
  3.9861366489353695`*^9}, {3.9866530520267925`*^9, 3.9866530526883984`*^9}},
 CellTags->
  "modelParams",ExpressionUUID->"00bd4a50-34f4-524e-9d3f-b8f78576f651"],

Cell[TextData[{
 "These are model parameters stored as an association that set the rules for \
a simulation, and a user may freely tweak them to model certain environmental \
scenarios or use these as independent variables to run empirical experiments. \
Most functions of the model take in this parameters ",
 StyleBox["association",
  FontWeight->"Bold"],
 " to understand how they should work and to what extent their functions \
should affect model/agent state. Comments following each parameter outlines \
its purpose. Parameters, and thus the model, is defined in ",
 StyleBox["nondimensionalized",
  FontWeight->"Bold"],
 " arbitrary units: arbitrary distance units denoted (",
 StyleBox["D",
  FontWeight->"Bold"],
 "), arbitrary time units denoted (",
 StyleBox["T",
  FontWeight->"Bold"],
 "), and arbitrary energy units denoted (",
 StyleBox["E",
  FontWeight->"Bold"],
 ") throughout."
}], "Text",
 CellChangeTimes->{
  3.986134702431364*^9, {3.9861349670242786`*^9, 3.9861350151841335`*^9}, {
   3.9866530586789455`*^9, 3.9866530630536213`*^9}, {3.9866539617015514`*^9, 
   3.9866539901637287`*^9}, {3.9866542471128273`*^9, 3.986654249513815*^9}, {
   3.9866543327970047`*^9, 3.986654545327215*^9}, {3.986654578512396*^9, 
   3.986654579597225*^9}, {3.9866546113092575`*^9, 3.9866546690151215`*^9}, {
   3.9866547079760723`*^9, 3.9866547221788425`*^9}, {3.986654994727091*^9, 
   3.986655051410116*^9}, {3.988668795851225*^9, 3.9886688178396187`*^9}, {
   3.9886690538873158`*^9, 3.988669055448925*^9}, 
   3.988753620866991*^9},ExpressionUUID->"12a703f2-67bb-3a4f-96b1-\
62b17c6944ae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"parameters", " ", "=", " ", 
   RowBox[{"<|", "\n", "   ", 
    RowBox[{
     RowBox[{"\"\<proximityRadius\>\"", " ", "->", " ", "0.5"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{"How", " ", "close", " ", "two", " ", "things", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"agent", "/", "food"}], ",", " ", 
         RowBox[{"agent", "/", "agent"}]}], ")"}], " ", "need", " ", "to", " ",
        "be", " ", "to", " ", "interact", " ", 
       RowBox[{"(", 
        RowBox[{"eat", ",", " ", "reproduce", ",", " ", 
         RowBox[{"etc", "."}]}], ")"}]}], "*)"}], "\n", "   ", 
     RowBox[{"\"\<sensingDistance\>\"", " ", "->", " ", "4"}], ",", " ", 
     RowBox[{"(*", 
      RowBox[{
      "How", " ", "far", " ", "agents", " ", "can", " ", "sense", " ", 
       "items"}], "*)"}], "\n", "   ", 
     RowBox[{"\"\<metabolism\>\"", " ", "->", " ", "0.05"}], ",", "\n", "   ", 
     RowBox[{"\"\<dt\>\"", " ", "->", " ", "0.1"}], ",", " ", 
     RowBox[{"(*", "timestep", "*)"}], "\n", "   ", "\n", "   ", 
     RowBox[{"(*", " ", 
      RowBox[{"Food", "/", "environment"}], " ", "*)"}], "\n", "   ", 
     RowBox[{"\"\<foodEnergy\>\"", " ", "->", " ", "5.0"}], ",", "\n", "   ", 
     RowBox[{"\"\<foodSpawnCooldown\>\"", " ", "->", " ", "1"}], ",", "\n", 
     "   ", 
     RowBox[{"\"\<nFoodSpawn\>\"", " ", "->", " ", "5"}], ",", "\n", "   ", 
     RowBox[{"\"\<nStartingFood\>\"", " ", "->", " ", "4"}], ",", "\n", "   ",
      "\n", "   ", 
     RowBox[{"(*", " ", 
      RowBox[{"Initial", " ", "population", " ", "and", " ", "movement"}], 
      " ", "*)"}], "\n", "   ", 
     RowBox[{"\"\<nStartingAgents\>\"", " ", "->", " ", "4"}], ",", "\n", 
     "   ", 
     RowBox[{"\"\<squareBounds\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "20"}], "}"}]}], ",", "\n", "   ", 
     RowBox[{"\"\<startingEnergy\>\"", " ", "->", " ", "10"}], ",", "\n", 
     "   ", 
     RowBox[{"\"\<stepLength\>\"", " ", "->", " ", "0.4"}], ",", "\n", "   ", 
     RowBox[{"\"\<dirChangeProb\>\"", " ", "->", " ", "0.025"}], ",", "\n", 
     "   ", 
     RowBox[{"\"\<lifespan\>\"", " ", "->", " ", "30"}], ",", "\n", "   ", 
     RowBox[{"\"\<maxEnergy\>\"", " ", "->", " ", "10"}], ",", "\n", "   ", 
     "\n", "   ", 
     RowBox[{"(*", " ", "Visualization", " ", "*)"}], "\n", "   ", 
     RowBox[{"\"\<imageSize\>\"", " ", "->", " ", "500"}], ",", "\n", "   ", 
     RowBox[{"\"\<agentSize\>\"", " ", "->", " ", "0.01"}], ",", "\n", "   ", 
     RowBox[{"\"\<foodSize\>\"", " ", "->", " ", "0.0075"}], ",", "\n", "   ",
      "\n", "   ", 
     RowBox[{"(*", " ", "Reproduction", " ", "*)"}], "\n", "   ", 
     RowBox[{"\"\<reproductionRadius\>\"", " ", "->", " ", "1.0"}], ",", "\n",
      "   ", 
     RowBox[{"\"\<minReproductionEnergy\>\"", " ", "->", " ", "5.0"}], ",", 
     "\n", "   ", 
     RowBox[{"\"\<minReproductionAge\>\"", " ", "->", " ", "4.0"}], ",", "\n",
      "   ", 
     RowBox[{"\"\<reproductionEnergyCost\>\"", " ", "->", " ", "2.0"}], ",", 
     "\n", "   ", 
     RowBox[{"\"\<reproductionCooldown\>\"", " ", "->", " ", "2"}], ",", "\n",
      "   ", "\n", "   ", 
     RowBox[{"(*", " ", 
      RowBox[{"Variables", " ", "for", " ", "numerical", " ", "stability"}], 
      " ", "*)"}], "\n", "   ", 
     RowBox[{"\"\<epsilon\>\"", " ", "->", " ", "0.001"}], ",", "\n", "   ", 
     RowBox[{"\"\<rnd\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{"N", "@", "10"}], "^", 
       RowBox[{"-", "3"}]}]}]}], "\n", "|>"}]}], ";"}]], "Code",
 CellChangeTimes->{{3.988669338505251*^9, 3.98866935028273*^9}, {
  3.9886693832936554`*^9, 3.9886698815775986`*^9}, {3.989960950097336*^9, 
  3.9899610309414425`*^9}, {3.990053485799673*^9, 3.9900534881454372`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"794170e1-751c-f440-bcbf-e0fa92862c68"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Core Model", "Section",
 CellChangeTimes->{{3.982192226940838*^9, 3.9821922324859447`*^9}, 
   3.9861321619595966`*^9, {3.9861326905155754`*^9, 3.9861326908331604`*^9}, {
   3.986133615271534*^9, 3.9861336192688503`*^9}, {3.986133808198393*^9, 
   3.986133808398634*^9}},ExpressionUUID->"c5be0d16-ba53-2546-a6ff-\
79990cc6644d"],

Cell[CellGroupData[{

Cell["Data Structures", "Subsection",
 CellChangeTimes->{{3.9866593264565487`*^9, 3.9866593293098545`*^9}},
 CellTags->
  "dataStructures",ExpressionUUID->"5037cdbf-fa39-404f-a28d-e7ae96a5edb6"],

Cell[TextData[{
 "Before the rest of the toolbox was built, the core aspects of the model \
like agents that moved and consumed food were built first. The food in a \
model at any time is represented by a ",
 StyleBox["list",
  FontWeight->"Bold"],
 " of positions of pieces of food. For the data structure of the model as a \
whole, see ",
 StyleBox[ButtonBox["Model Initialization",
  BaseStyle->"Hyperlink",
  ButtonData->"modelInitialization"],
  FontColor->RGBColor[
   0.792156862745098, 0.3176470588235294, 0.09803921568627451]],
 ".\n\n",
 Cell[BoxData[
  RowBox[{"createAgent", "[", "]"}]], "InlineCode",
  Background->RGBColor[1., 1., 1.],ExpressionUUID->
  "49e734e7-b447-1c42-b950-9a1c0b7d0b7b"],
 StyleBox["is used to initialize agent associations, and their states can be \
accessed through keys. Each agent attribute is commented with a description \
of its nature",
  Background->RGBColor[1., 1., 1.]]
}], "Text",
 CellChangeTimes->{
  3.986656472112711*^9, {3.9866568045186176`*^9, 3.98665681395512*^9}, {
   3.986657530107088*^9, 3.9866575455782146`*^9}, {3.9866590179394264`*^9, 
   3.98665902418865*^9}, {3.9866591163259716`*^9, 3.9866591324223576`*^9}, {
   3.9866593123730545`*^9, 3.9866593166233063`*^9}, {3.986659369824898*^9, 
   3.9866593993556957`*^9}, {3.988669909998169*^9, 3.9886699729959183`*^9}, {
   3.988670009865801*^9, 3.9886700902819977`*^9}, {3.9886701323339214`*^9, 
   3.9886701398959846`*^9}, 3.9887509212400036`*^9, 3.990050881947891*^9},
 CellTags->
  "createAgent[]",ExpressionUUID->"10a084c6-a688-6540-a79c-10fafe41d5fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"createAgent", "[", 
   RowBox[{
   "pos_", ",", " ", "energy_", ",", " ", "age_", ",", " ", "id_", ",", " ", 
    "currentDirection_", ",", " ", 
    RowBox[{"parents_", ":", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", " ", 
       RowBox[{"-", "1"}]}], "}"}]}], ",", " ", "reproductionCooldown_"}], 
   "]"}], " ", ":=", " ", 
  RowBox[{"<|", "\n", "    ", 
   RowBox[{
    RowBox[{"\"\<pos\>\"", " ", "->", " ", "pos"}], ",", " ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
      "The", " ", "current", " ", "position", " ", "of", " ", "an", " ", 
       "agent", " ", "in", " ", "the", " ", "environment"}], ",", " ", 
      RowBox[{"length", " ", "2", " ", "array"}]}], "*)"}], "\n", "    ", 
    RowBox[{"\"\<energy\>\"", " ", "->", " ", "energy"}], ",", " ", 
    RowBox[{"(*", 
     RowBox[{
     "The", " ", "current", " ", "energy", " ", "of", " ", "an", " ", 
      "agent"}], "*)"}], "\n", "    ", 
    RowBox[{"\"\<age\>\"", " ", "->", " ", "age"}], ",", " ", 
    RowBox[{"(*", 
     RowBox[{
     "The", " ", "current", " ", "age", " ", "of", " ", "an", " ", "agent"}], 
     "*)"}], "\n", "\t", 
    RowBox[{"\"\<id\>\"", " ", "->", " ", "id"}], ",", " ", 
    RowBox[{"(*", 
     RowBox[{
     "A", " ", "unique", " ", "identifer", " ", "given", " ", "to", " ", 
      "each", " ", "agent", " ", "created", " ", "throughout", " ", "the", " ",
       "history", " ", "of", " ", "the", " ", "simulation", " ", "instance"}],
      "*)"}], "\n", "\t", 
    RowBox[{"\"\<currentDirection\>\"", " ", "->", " ", "currentDirection"}], 
    ",", " ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{
       "The", " ", "current", " ", "direction", " ", "the", " ", "agent", " ",
         "is", " ", "exploring", " ", "in", " ", "or", " ", "seeking", " ", 
        RowBox[{"food", "/", "mates"}], " ", "in"}], ";", " ", 
       RowBox[{"value", " ", 
        RowBox[{"from", " ", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"2", "pi"}]}]}]}]}], ")"}], "*)"}], "\n", "\t", 
    RowBox[{"\"\<parents\>\"", " ", "->", " ", "parents"}], ",", " ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"The", " ", "ids", " ", "of", " ", "the", " ", 
       RowBox[{"agent", "'"}], "s", " ", "parents", " ", "in", " ", "a", " ", 
       "length", " ", "2", " ", 
       RowBox[{"array", ".", " ", "If"}], " ", "the", " ", "agent", " ", "is",
        " ", "one", " ", "of", " ", "the", " ", "primordial", " ", "starting",
        " ", "agents"}], ",", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], " ", "is", " ", "given", " ", "to", " ",
        "this", " ", 
       RowBox[{"value", ".", "\n", "\t", "used"}], " ", "to", " ", 
       "determine", " ", "familial", " ", "relations", " ", "for", " ", "the",
        " ", "purpose", " ", "of", " ", "incest", " ", 
       RowBox[{"prevention", "--"}], "a", " ", "parent", " ", "will", " ", 
       "naturally", " ", "not", " ", "reproduce", " ", "with", " ", "their", " ",
        "child", " ", "throughout", " ", "almost", " ", "all", " ", 
       "species"}]}], "*)"}], "\n", "    ", 
    RowBox[{"\"\<reproductionCooldown\>\"", " ", "->", " ", 
     "reproductionCooldown"}]}], "\n", "|>"}]}]], "Code",
 CellChangeTimes->{
  3.986656699328575*^9, {3.9866568535934486`*^9, 3.9866569508927803`*^9}, {
   3.9866570394348106`*^9, 3.9866570581597443`*^9}, {3.9886701758241463`*^9, 
   3.9886702754201374`*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"142145c4-95bc-4c4d-b9f0-ab021346b21d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Core Functions", "Subsection",
 CellChangeTimes->{{3.98665934884626*^9, 3.9866593542909927`*^9}},
 CellTags->
  "coreFunctions",ExpressionUUID->"eba76386-d2a1-ca45-b667-e9cf93b946a3"],

Cell["\<\
These functions are the basic operations needed for core model functionality.\
\>", "Text",
 CellChangeTimes->{{3.986659374898609*^9, 
  3.986659389762089*^9}},ExpressionUUID->"668d9dab-c40a-fe4c-af9b-\
84ddd727ec21"],

Cell[TextData[{
 "For any interactions to occur, an object must be within another\
\[CloseCurlyQuote]s ",
 Cell[BoxData[
  StyleBox["proximityRadius",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "4c35badf-89b7-4b40-8235-afce86df8b1f"],
 ".  This goes for an agent and a piece of food, an agent and another agent \
for reproduction."
}], "Text",
 CellChangeTimes->{{3.986133935459646*^9, 3.986134001026058*^9}, {
   3.986134128371048*^9, 3.9861341682006283`*^9}, {3.9861342216344566`*^9, 
   3.986134225347433*^9}, {3.9861354205280743`*^9, 3.986135502323677*^9}, {
   3.9861355479464245`*^9, 3.9861355974950294`*^9}, {3.9866530312050304`*^9, 
   3.9866530321828423`*^9}, {3.986653282381628*^9, 3.9866532827050743`*^9}, {
   3.9866533505385036`*^9, 3.986653351202915*^9}, {3.986654009608753*^9, 
   3.986654026521841*^9}, {3.9866562304426804`*^9, 3.9866562592874737`*^9}, {
   3.9866564609462414`*^9, 3.9866564678113003`*^9}, 3.9866565595560265`*^9, {
   3.988670288114067*^9, 
   3.9886702882436695`*^9}},ExpressionUUID->"43f7f145-fa31-224c-a685-\
bceff4b4876e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"checkWithinRadius", "[", 
    RowBox[{"p1_", ",", " ", "p2_", ",", " ", "r_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"EuclideanDistance", "[", 
     RowBox[{"p1", ",", " ", "p2"}], "]"}], " ", "<=", " ", "r"}]}], 
  ";"}]], "Code",
 CellChangeTimes->{3.986135602936306*^9},
 CellLabel->"In[3]:=",ExpressionUUID->"f149d8ae-5cdf-7148-be2a-169ee1c31973"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"EuclidianDistance", "[", "]"}]], "InlineCode",ExpressionUUID->
  "2e435b62-7914-a948-a308-871259042531"],
 " is used in the ",
 Cell[BoxData[
  RowBox[{"checkWithinRadius", "[", "]"}]], "InlineCode",ExpressionUUID->
  "8ad64ce0-b9c4-7f48-b3fa-a4913eba8e38"],
 " function to verify the interaction condition of ",
 Cell[BoxData[
  StyleBox["proximityRadius",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "41c5c3c1-b01d-6a4f-b9b5-ad4c2bd0b441"],
 " throughout simulation."
}], "CodeText",
 CellChangeTimes->{{3.9866533764217987`*^9, 3.986653378633711*^9}, {
  3.986653458920767*^9, 3.986653458991089*^9}, {3.9866540988145695`*^9, 
  3.986654101054394*^9}, {3.986656200421219*^9, 3.9866562061620903`*^9}, {
  3.9866565670399513`*^9, 3.9866565803603783`*^9}, {3.9866567216833496`*^9, 
  3.9866567386902485`*^9}, {3.9866591896920757`*^9, 3.9866591931780586`*^9}, {
  3.9886702943350105`*^9, 
  3.988670296926489*^9}},ExpressionUUID->"7de17ded-2970-d14b-ba66-\
538e4eceb407"],

Cell[TextData[{
 "A function called ",
 Cell[BoxData[
  RowBox[{"findNearestSensableFoodInfo", "[", "]"}]], "InlineCode",
  ExpressionUUID->"c26d71fb-578d-c343-93fd-7b06faa7d216"],
 " is used to find the nearest sensable (within ",
 Cell[BoxData[
  StyleBox["sensingDistance",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "acb4512a-f37a-f045-8ca7-fed83c9bc9ab"],
 ") food to an agent so agents can seek and eat food. It returns this nearest \
sensable food\[CloseCurlyQuote]s distance, index in the food list, and \
position."
}], "Text",
 CellChangeTimes->{{3.986656981652298*^9, 3.9866569925472775`*^9}, {
  3.9866570832146893`*^9, 3.9866571921746902`*^9}, {3.9866609992974873`*^9, 
  3.986661000226021*^9}, {3.9866660723018055`*^9, 3.9866661001094913`*^9}, {
  3.9886703093240376`*^9, 
  3.988670365683964*^9}},ExpressionUUID->"6c4fc9dc-af10-314e-8f11-\
3220d91f0c2b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"findNearestSensableFoodInfo", "[", 
   RowBox[{"agent_", ",", " ", "foodPositions_List", ",", " ", "params_"}], 
   "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "agentPos", ",", " ", "foodPosAndI", ",", " ", 
      "foodsWithinRadiusPosAndI", ",", " ", "dists"}], "}"}], ",", "\n", 
    "    ", 
    RowBox[{
     RowBox[{"agentPos", " ", "=", " ", 
      RowBox[{"agent", "[", "\"\<pos\>\"", "]"}]}], ";", "\n", "    ", 
     RowBox[{"foodPosAndI", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"foodPositions", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", " ", "i"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", 
          RowBox[{"Length", "[", "foodPositions", "]"}]}], "}"}]}], "]"}]}], ";",
      "\n", "    ", 
     RowBox[{"foodsWithinRadiusPosAndI", " ", "=", " ", 
      RowBox[{"Select", "[", 
       RowBox[{"foodPosAndI", ",", " ", 
        RowBox[{
         RowBox[{"checkWithinRadius", "[", 
          RowBox[{"agentPos", ",", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
           RowBox[{"params", "[", "\"\<sensingDistance\>\"", "]"}]}], "]"}], 
         "&"}]}], "]"}]}], ";", "\n", "    ", 
     RowBox[{"If", "[", "\n", "        ", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "foodsWithinRadiusPosAndI", "]"}], " ", "==", 
        " ", "0"}], ",", "\n", "        ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{"-", "1"}]}], "}"}], ",", " ", 
       RowBox[{"(*", 
        RowBox[{"no", " ", "food"}], "*)"}], "\n", "        ", 
       RowBox[{
        RowBox[{"dists", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"EuclideanDistance", "[", 
              RowBox[{"agentPos", ",", " ", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", " ", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "}"}], "&"}], " ", "/@", " ", 
          "foodsWithinRadiusPosAndI"}]}], ";", "\n", "        ", 
        RowBox[{"First", "@", 
         RowBox[{"MinimalBy", "[", 
          RowBox[{"dists", ",", " ", "First"}], "]"}]}]}]}], "\n", "    ", 
      "]"}]}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{3.9866572058419514`*^9, 3.988670306133047*^9},
 CellTags->"findNearestSensableFoodInfo",
 CellLabel->"In[4]:=",ExpressionUUID->"9b0353ea-2fcd-e94e-ac8f-ae6f1b0f96a2"],

Cell["\<\
The function first compiles the food positions and indexes, and then isolates \
the ones that are within sensing distance of the agent. If no pieces of food \
make it into that isolation, then there are none within sensing distance and \
{-1, -1, -1} is returned. Else, the closest food\[CloseCurlyQuote]s \
{distance, index in the food list, position in the environment} is returned.\
\>", "CodeText",
 CellChangeTimes->{{3.986657227761652*^9, 3.9866573235387726`*^9}, {
   3.986658968132265*^9, 3.986658969049103*^9}, {3.988670374549324*^9, 
   3.9886704044954014`*^9}, 
   3.988749489049614*^9},ExpressionUUID->"59887e7b-4161-cb4b-8ec4-\
ed0b0cc93345"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"spawnFoods", "[", "]"}]], "InlineCode",ExpressionUUID->
  "5b8f6ce0-a803-c64e-8e7f-6a47894e66da"],
 "takes in a food list and adds new foods with the amount corresponding to \
the ",
 Cell[BoxData[
  StyleBox["nFoodSpawn",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "290b8198-2f19-1744-9535-dc8eccfddd6c"],
 " parameter. Rounding is used to prevent excess precision which increases \
the memory needed to save a simulation to a file (17.988838327 takes up more \
space then 17.989 in a .csv file)."
}], "Text",
 CellChangeTimes->{{3.986657355570282*^9, 3.9866573918809643`*^9}, {
   3.986657471074499*^9, 3.986657524449877*^9}, {3.986658977664772*^9, 
   3.986658996021229*^9}, {3.9866591637581673`*^9, 3.9866591714669056`*^9}, 
   3.986660102583685*^9, {3.9886706233143883`*^9, 3.9886706358847504`*^9}, {
   3.9886713478899517`*^9, 
   3.988671348707386*^9}},ExpressionUUID->"89540473-02b0-2a40-a141-\
d55c082daf0c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"spawnFoods", "[", 
   RowBox[{"foods_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Join", "[", 
   RowBox[{"foods", ",", " ", 
    RowBox[{"Round", "[", 
     RowBox[{
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"params", "[", "\"\<squareBounds\>\"", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"params", "[", "\"\<nFoodSpawn\>\"", "]"}], ",", " ", "2"}],
          "}"}]}], "]"}], ",", " ", 
      RowBox[{"params", "[", "\"\<rnd\>\"", "]"}]}], "]"}]}], "]"}]}]], "Code",
 CellChangeTimes->{3.9866592357492294`*^9, 3.9886704170456715`*^9},
 CellLabel->"In[5]:=",ExpressionUUID->"8327f009-68e5-7d40-82c1-d38081b5b327"],

Cell[TextData[{
 "To spawn food at the appropriate time, ",
 Cell[BoxData[
  RowBox[{"spawnFoodCheck", "[", "]"}]], "InlineCode",ExpressionUUID->
  "a2dd5c23-6d7d-ef49-81f6-5b54a14c253f"],
 " updates the model\[CloseCurlyQuote]s food list with a ",
 Cell[BoxData[
  RowBox[{"spawnFoods", "[", "]"}]], "InlineCode",ExpressionUUID->
  "8538a2ff-c2d6-e04c-b20b-1b84159e432b"],
 "operation when appropriate according to the ",
 Cell[BoxData[
  StyleBox["foodSpawnCooldown",
   FontSlant->"Italic"]], "InlineCode",ExpressionUUID->
  "02fd4138-df10-424d-86e7-4e860da4398e"],
 " parameter. "
}], "Text",
 CellChangeTimes->{{3.986659291647358*^9, 3.9866593004645767`*^9}, {
  3.986659464851038*^9, 3.9866594941026287`*^9}, {3.986659527640812*^9, 
  3.9866595341682415`*^9}, {3.986659564969391*^9, 3.986659583143572*^9}, {
  3.9886704355120163`*^9, 3.9886704457369537`*^9}, {3.9886705306597958`*^9, 
  3.988670621603668*^9}},ExpressionUUID->"42b7b78c-0cea-2148-9274-\
24f62c0d8a1f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"spawnFoodCheck", "[", 
   RowBox[{"model_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"model2", " ", "=", " ", "model"}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"model2", "[", "\"\<foods\>\"", "]"}], " ", "=", " ", 
      RowBox[{"If", "[", "\n", "        ", 
       RowBox[{
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"model", "[", "\"\<time\>\"", "]"}], ",", " ", 
           RowBox[{"params", "[", "\"\<foodSpawnCooldown\>\"", "]"}]}], "]"}],
          " ", "<", " ", 
         RowBox[{"10", "^", 
          RowBox[{"(", 
           RowBox[{"-", "1"}], ")"}]}]}], ",", "\n", "        ", 
        RowBox[{"spawnFoods", "[", 
         RowBox[{
          RowBox[{"model", "[", "\"\<foods\>\"", "]"}], ",", " ", "params"}], 
         "]"}], ",", "\n", "        ", 
        RowBox[{"model", "[", "\"\<foods\>\"", "]"}]}], "\n", "    ", "]"}]}],
      ";", "\n", "\t", "model2"}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{3.986659605352833*^9, 3.9886706460345*^9},
 CellLabel->"In[6]:=",ExpressionUUID->"fe82a479-5b2e-cf4e-94dc-56936b503ac1"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"<", " ", 
   RowBox[{"10", "^", 
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}]}]}]], "InlineCode",ExpressionUUID->
  "c1136220-2d9a-db40-a22a-7fed2c53f852"],
 " is used instead of  ",
 Cell[BoxData[
  RowBox[{"==", " ", "0"}]], "InlineCode",ExpressionUUID->
  "12ff24e3-d246-5744-92dc-f6b7251b3c52"],
 " to not have to worry about integer vs. float mismatch issues (see",
 StyleBox[" ",
  FontColor->RGBColor[
   0.792156862745098, 0.3176470588235294, 0.09803921568627451]],
 StyleBox[ButtonBox["Future Direction",
  BaseStyle->"Hyperlink",
  ButtonData->"futureDirection"],
  FontColor->RGBColor[
   0.792156862745098, 0.3176470588235294, 0.09803921568627451]],
 ")."
}], "CodeText",
