Cell[BoxData[{
 RowBox[{
  RowBox[{"lUnitsToPixels", "[", 
   RowBox[{"lUnits_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
  RowBox[{"lUnits", " ", "*", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"params", "[", "\"\<imageSize\>\"", "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"params", "[", "\"\<squareBounds\>\"", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
       RowBox[{
        RowBox[{"params", "[", "\"\<squareBounds\>\"", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], ")"}]}]}], "\n", 
 RowBox[{
  RowBox[{"lPixelsToUnits", "[", 
   RowBox[{"lPixels_", ",", " ", "params_"}], "]"}], ":=", " ", 
  RowBox[{"lPixels", " ", "*", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"params", "[", "\"\<squareBounds\>\"", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
       RowBox[{
        RowBox[{"params", "[", "\"\<squareBounds\>\"", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", 
     RowBox[{"params", "[", "\"\<imageSize\>\"", "]"}]}], ")"}]}]}]}], "Code",
 CellChangeTimes->{3.9887572135223236`*^9},
 CellLabel->"In[33]:=",ExpressionUUID->"13d73f85-3a37-ba4f-9512-042548106f26"],

Cell[TextData[{
 "For our visualization, we created a function called ",
 StyleBox["displayGrid",
  FontWeight->"Bold"],
 " which styles the text, energy bars, etc. and formats the agents with the \
function ",
 StyleBox["drawAgentGraphic",
  FontWeight->"Bold"],
 ". Initially, we combined all these aspects of our code into ",
 StyleBox["displayGrid",
  FontWeight->"Bold"],
 " itself by using the Module function inside of Table, but we found that \
using a separate function, such as drawAgentGraphic, to handle other \
formatting allows us to significantly increase efficiency. First,",
 " we gather the following information"
}], "Text",
 CellChangeTimes->{{3.9883986891810875`*^9, 3.988398709588295*^9}, {
  3.9885677112091904`*^9, 
  3.9885678057151337`*^9}},ExpressionUUID->"c9240b80-893a-4048-841b-\
557bdebd6e22"],

Cell[BoxData[
 RowBox[{"    ", 
  RowBox[{
  "agents", ",", " ", "foods", ",", " ", "min", ",", " ", "max", ",", " ", 
   "span", ",", " ", "nAgents", ",", "\n", "    ", "hudPad", ",", " ", 
   "agentR", ",", " ", "foodR", ",", " ", "barW", ",", " ", "barH", ",", " ", 
   "barGap", ",", "\n", "    ", "showEnergyBars", ",", " ", "legendX", ",", 
   " ", "legendY", ",", " ", "infoX", ",", " ", "infoY", ",", "\n", "    ", 
   "agentGraphics", ",", " ", "foodGraphics", ",", " ", "legend", ",", " ", 
   "infoText"}]}]], "Code",
 CellChangeTimes->{3.9883993006652946`*^9},
 CellLabel->"In[35]:=",ExpressionUUID->"cc7f88a3-9110-f948-809c-40e1dd2e9bb9"],

Cell[TextData[{
 "To simulate how agents interact with one another in an environment, we \
created a square visualization window bounded by the parameter ",
 StyleBox["squareBounds",
  FontWeight->"Bold"],
 " to render agents, food/resources, energy levels, ages, and other \
characteristics for each timestep. The function first extracts all agent \
information from the main association. "
}], "Text",
 CellChangeTimes->{{3.9858872836735134`*^9, 3.985887333646532*^9}, {
  3.985887375511841*^9, 3.9858874105025845`*^9}, {3.9858874642860413`*^9, 
  3.985887600183935*^9}, {3.986133446189781*^9, 3.9861334572457447`*^9}, {
  3.986134081567087*^9, 3.9861340825917263`*^9}, {3.98613522389324*^9, 
  3.986135226836588*^9}, {3.98839935763109*^9, 
  3.9883993698863316`*^9}},ExpressionUUID->"06ce39a2-5a12-e24b-9dcc-\
9a94c95b3922"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{"agents", " ", "=", " ", 
     RowBox[{"model", "[", "\"\<agents\>\"", "]"}]}], ";"}], "\n", "  ", 
   RowBox[{
    RowBox[{"foods", " ", "=", " ", 
     RowBox[{"model", "[", "\"\<foods\>\"", "]"}]}], ";"}], "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"min", ",", " ", "max"}], "}"}], " ", "=", " ", 
     RowBox[{"params", "[", "\"\<squareBounds\>\"", "]"}]}], 
    ";"}]}]}]], "Code",
 CellChangeTimes->{
  3.9858876177569065`*^9, {3.9861334030906696`*^9, 3.9861334141985397`*^9}, {
   3.988290459901697*^9, 3.988290467930231*^9}, 3.988290526578823*^9, {
   3.9883986821214886`*^9, 3.9883986827372627`*^9}, 3.9883993555408154`*^9},
 CellLabel->"In[35]:=",ExpressionUUID->"e2f15b16-b3ab-b241-bf99-6c91cc225e71"],

Cell[BoxData[
 TemplateBox[{
  "Set", "shape", 
   "\"Lists \\!\\(\\*RowBox[{\\\"{\\\", RowBox[{\\\"min\\\", \\\",\\\", \
\\\"max\\\"}], \\\"}\\\"}]\\) and \\!\\(\\*RowBox[{\\\"params\\\", \\\"[\\\", \
\\\"\\\\\\\"squareBounds\\\\\\\"\\\", \\\"]\\\"}]\\) are not the same \
shape.\"", 2, 37, 2, 28024722323124841338, "Local"},
  "MessageTemplate",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{3.9887603718066063`*^9, 3.9887604193328896`*^9, 
  3.9887638653501434`*^9},
 CellLabel->
  "During evaluation of \
In[35]:=",ExpressionUUID->"571628d3-5ed0-814f-9982-a10c1061fa67"]
}, Open  ]],

Cell[TextData[{
 "Additionally, an important variable is ",
 StyleBox["span",
  FontWeight->"Bold"],
 ", which we use to scale the visualization with the size of the modeled \
world, so the display remains consistent even when the environment changes."
}], "Text",
 CellChangeTimes->{{3.98839937552075*^9, 
  3.988399379771803*^9}},ExpressionUUID->"ed6b40f6-bc3e-0d44-83ca-\
cd47ebdf9274"],

Cell[BoxData[
 RowBox[{
  RowBox[{"span", " ", "=", " ", 
   RowBox[{"max", " ", "-", " ", "min"}]}], ";"}]], "Code",
 CellChangeTimes->{{3.988399393105831*^9, 3.9883993934911175`*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"3415eada-f603-2e44-8ac2-466a8f0b778f"],

Cell["\<\
Since the bounds of the environment can change, we scaled the graphics to the \
bound of the world. Specifically, if the environment is small, agents and \
food appear larger, whereas if the environment is large, the agents appear \
smaller.\
\>", "Text",
 CellChangeTimes->{{3.9858877154274807`*^9, 3.985887935015753*^9}, {
  3.9883994428520203`*^9, 
  3.9883994457332935`*^9}},ExpressionUUID->"b3e0cf58-9734-ac4c-aa60-\
c97948927014"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{"agentR", " ", "=", " ", 
     RowBox[{
      RowBox[{"params", "[", "\"\<agentSize\>\"", "]"}], "*", "span"}]}], 
    ";"}], "\n", "  ", 
   RowBox[{
    RowBox[{"foodR", "  ", "=", " ", 
     RowBox[{
      RowBox[{"params", "[", "\"\<foodSize\>\"", "]"}], "*", "span"}]}], 
    ";"}], "\n", "\n", "  ", 
   RowBox[{
    RowBox[{"barW", " ", "=", " ", 
     RowBox[{"0.10", " ", "span"}]}], ";"}], "\n", "  ", 
   RowBox[{
    RowBox[{"barH", " ", "=", " ", 
     RowBox[{"0.015", " ", "span"}]}], ";"}], "\n", "  ", 
   RowBox[{
    RowBox[{"barGap", " ", "=", " ", 
     RowBox[{"0.040", " ", "span"}]}], ";"}], "\n", "\n", "  ", 
   RowBox[{
    RowBox[{"hudPad", " ", "=", " ", 
     RowBox[{"0.001", " ", "span"}]}], ";"}]}]}]], "Code",
 CellChangeTimes->{
  3.985887974792244*^9, {3.9883994683469296`*^9, 3.988399469109352*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"a2b937c3-51a3-c245-aca8-e92c994e10e0"],

Cell["\<\
To keep the visualization clean and prevent the grid from looking \
\[OpenCurlyQuote]crowded\[CloseCurlyQuote] as the population increases, we \
used the current population size to control how much detail to display. As a \
result, energy bars are only shown when there are less than 6 agents\
\>", "Text",
 CellChangeTimes->{{3.988399456138891*^9, 
  3.9883994594694786`*^9}},ExpressionUUID->"17fa9aac-b373-2e4a-88fb-\
3c9557eacc57"],

Cell[BoxData[
 RowBox[{
  RowBox[{"showEnergyBars", " ", "=", " ", 
   RowBox[{"nAgents", " ", "<", " ", "6"}]}], ";"}]], "Code",
 CellChangeTimes->{3.988399470775072*^9},
 CellLabel->"In[45]:=",ExpressionUUID->"86080276-a46c-444e-b37e-a1b363b704d9"],

Cell["\<\
The agents\[CloseCurlyQuote] properties, such as age and energy level, are \
represented by color gradients. Specifically, age is shown by a green (young \
agent) to red (old agent) gradient. It is important to note that the agents\
\[CloseCurlyQuote] ages are relative to their total lifespan. This allows us \
to display the age visually, without crowding the grid with other legends.\
\>", "Text",
 CellChangeTimes->{{3.9858880474203854`*^9, 3.9858880675585365`*^9}, {
  3.985888127464985*^9, 3.985888463658968*^9}, {3.988399564489897*^9, 
  3.9883995789138775`*^9}},ExpressionUUID->"99fffb7e-9639-014b-8229-\
f5362dcb763d"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{"ageColor", "[", "age_", "]"}], " ", ":=", " ", 
    RowBox[{"Blend", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "Green", ",", " ", "Yellow", ",", " ", "Orange", ",", " ", "Red"}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"Clip", "[", 
       RowBox[{
        RowBox[{"age", "/", 
         RowBox[{"(", 
          RowBox[{"0.3", " ", 
           RowBox[{"params", "[", "\"\<lifespan\>\"", "]"}]}], ")"}]}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}]}], "\n", "  ", "]"}]}], 
   ";"}]}]], "Code",
 CellChangeTimes->{
  3.9858884851850777`*^9, {3.988399549678295*^9, 3.988399550810478*^9}, {
   3.988399599394438*^9, 3.988399602698368*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"cbd9fdd0-b10d-6848-8e8e-2619affb1637"],

Cell["\<\
We also switch the text color between black and white, depending on each \
agent\[CloseCurlyQuote]s age, to keep the age readable against different \
gradient colors.\
\>", "Text",
 CellChangeTimes->{
  3.98839954083638*^9},ExpressionUUID->"50143954-f01d-f446-87d0-61ade4003f2e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"ageTextColor", "[", "age_", "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"age", " ", "<", " ", 
      RowBox[{"0.6", " ", 
       RowBox[{"params", "[", "\"\<lifespan\>\"", "]"}]}]}], ",", " ", 
     "Black", ",", " ", "White"}], "]"}]}], ";"}]], "Code",
 CellChangeTimes->{3.9883995529535313`*^9},
 CellLabel->"In[47]:=",ExpressionUUID->"fe3ca620-fc4b-624d-8d09-679ae88514f1"],

Cell["\<\
The energy of each agent is represented by a red-to-green bar, in which red \
represents low energy, while green represents a high energy. These energy \
levels are relative to the max energy defined in the associations.\
\>", "Text",
 CellChangeTimes->{
  3.9883995855647907`*^9},ExpressionUUID->"2d47821d-62e6-b448-8f86-\
3d9f81dd7097"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"energyColor", "[", "frac_", "]"}], " ", ":=", " ", 
   RowBox[{"Blend", "[", "\n", "    ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Red", ",", " ", "Yellow", ",", " ", "Green"}], "}"}], ",", 
     "\n", "    ", 
     RowBox[{"Clip", "[", 
      RowBox[{"frac", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}]}], "\n", "  ", "]"}]}], 
  ";"}]], "Code",
 CellChangeTimes->{{3.988399604323988*^9, 3.988399605452429*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"55bfe0a9-de1b-4e40-a780-3bfd66336338"],

Cell["\<\
Initially, we found it difficult to avoid overlap between text/agent \
information when agents are close together in the grid. So, to fix this, we \
wrote a helper rule to check agent positions and test multiple possible \
locations for the energy bar. Now, the function takes into account the \
positions above, below, left, and right, clips them to stay inside the grid, \
and, by using a scoring method, finds what position maximizes distance from \
nearby agents. Overall, this makes the visualization more readable.\
\>", "Text",
 CellChangeTimes->{{3.9858886105794716`*^9, 3.9858888149097366`*^9}, {
  3.9858890013927574`*^9, 
  3.9858890153372498`*^9}},ExpressionUUID->"4dd04c5b-987e-b344-bb2e-\
c57ecff71511"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"otherAgentPositions", "[", "pos_", "]"}], " ", ":=", " ", 
     RowBox[{"DeleteCases", "[", 
      RowBox[{
       RowBox[{"Lookup", "[", 
        RowBox[{"agents", ",", " ", "\"\<pos\>\""}], "]"}], ",", " ", "pos"}],
       "]"}]}], ";"}], "\n", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"chooseBarCenter", "[", 
      RowBox[{"pos_", ",", " ", "others_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"candidates", ",", " ", "scores"}], "}"}], ",", " ", 
       RowBox[{
        RowBox[{"candidates", " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"pos", " ", "+", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", "barGap"}], "}"}]}], ",", " ", 
           RowBox[{"pos", " ", "+", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", " ", 
              RowBox[{"-", "barGap"}]}], "}"}]}], ",", " ", 
           RowBox[{"pos", " ", "+", " ", 
            RowBox[{"{", 
             RowBox[{"barGap", ",", " ", "0"}], "}"}]}], ",", " ", 
           RowBox[{"pos", " ", "+", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "barGap"}], ",", " ", "0"}], "}"}]}]}], "}"}]}], ";",
         "\n", "    ", "\n", "    ", 
        RowBox[{"candidates", " ", "=", " ", 
         RowBox[{"{", "\n", "      ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"candidates", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"min", " ", "+", " ", 
                  RowBox[{"barW", "/", "2"}]}], ",", " ", 
                 RowBox[{"max", " ", "-", " ", 
                  RowBox[{"barW", "/", "2"}]}]}], "}"}]}], "]"}], ",", "\n", 
             "       ", 
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"candidates", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"min", " ", "+", " ", 
                  RowBox[{"barH", "/", "2"}]}], ",", " ", 
                 RowBox[{"max", " ", "-", " ", 
                  RowBox[{"barH", "/", "2"}]}]}], "}"}]}], "]"}]}], "}"}], ",",
            "\n", "      ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"candidates", "[", 
                RowBox[{"[", 
                 RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"min", " ", "+", " ", 
                  RowBox[{"barW", "/", "2"}]}], ",", " ", 
                 RowBox[{"max", " ", "-", " ", 
                  RowBox[{"barW", "/", "2"}]}]}], "}"}]}], "]"}], ",", "\n", 
             "       ", 
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"candidates", "[", 
                RowBox[{"[", 
                 RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"min", " ", "+", " ", 
                  RowBox[{"barH", "/", "2"}]}], ",", " ", 
                 RowBox[{"max", " ", "-", " ", 
                  RowBox[{"barH", "/", "2"}]}]}], "}"}]}], "]"}]}], "}"}], ",",
            "\n", "      ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"candidates", "[", 
                RowBox[{"[", 
                 RowBox[{"3", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"min", " ", "+", " ", 
                  RowBox[{"barW", "/", "2"}]}], ",", " ", 
                 RowBox[{"max", " ", "-", " ", 
                  RowBox[{"barW", "/", "2"}]}]}], "}"}]}], "]"}], ",", "\n", 
             "       ", 
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"candidates", "[", 
                RowBox[{"[", 
                 RowBox[{"3", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"min", " ", "+", " ", 
                  RowBox[{"barH", "/", "2"}]}], ",", " ", 
                 RowBox[{"max", " ", "-", " ", 
                  RowBox[{"barH", "/", "2"}]}]}], "}"}]}], "]"}]}], "}"}], ",",
            "\n", "      ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"candidates", "[", 
                RowBox[{"[", 
                 RowBox[{"4", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"min", " ", "+", " ", 
                  RowBox[{"barW", "/", "2"}]}], ",", " ", 
                 RowBox[{"max", " ", "-", " ", 
                  RowBox[{"barW", "/", "2"}]}]}], "}"}]}], "]"}], ",", "\n", 
             "       ", 
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"candidates", "[", 
                RowBox[{"[", 
                 RowBox[{"4", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"min", " ", "+", " ", 
                  RowBox[{"barH", "/", "2"}]}], ",", " ", 
                 RowBox[{"max", " ", "-", " ", 
                  RowBox[{"barH", "/", "2"}]}]}], "}"}]}], "]"}]}], "}"}]}], 
          "}"}]}], ";", "\n", "       ", "\n", "    ", 
        RowBox[{"scores", " ", "=", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "others", "]"}], " ", "==", " ", "0"}], ",", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{"1", ",", " ", 
             RowBox[{"Length", "[", "candidates", "]"}]}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Min", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Norm", "[", 
                 RowBox[{"#", " ", "-", " ", "#2"}], "]"}], " ", "&"}], " ", "@@@",
                " ", 
               RowBox[{"Tuples", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", "#", "}"}], ",", " ", "others"}], "}"}], 
                "]"}]}], "]"}], " ", "&"}], " ", "/@", " ", "candidates"}]}], 
          "]"}]}], ";", "\n", "    ", 
        RowBox[{"candidates", "[", 
         RowBox[{"[", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"Ordering", "[", 
            RowBox[{"scores", ",", " ", 
             RowBox[{"-", "1"}]}], "]"}]}], "]"}], "]"}]}]}], "]"}]}], 
    ";"}]}]}]], "Code",
 CellChangeTimes->{
  3.985888827314373*^9, {3.985888859901697*^9, 3.9858889196764812`*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"78041323-e436-724f-8446-c536bd7f942e"],

Cell["\<\
Within drawAgentGraphic, we extract each agent\[CloseCurlyQuote]s information \
and create local variables for the agent\[CloseCurlyQuote]s position, age, \
energy, energy fraction, display colors, and energy-bar placement.\
\>", "Text",
 CellChangeTimes->{{3.9858890363716373`*^9, 3.9858892126759624`*^9}, {
  3.9885681879690895`*^9, 
  3.9885682288117085`*^9}},ExpressionUUID->"91206454-e921-0e4c-a94b-\
c8b9bc38c9a3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pos", " ", "=", " ", 
   RowBox[{"agent", "[", "\"\<pos\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"age", " ", "=", " ", 
   RowBox[{"agent", "[", "\"\<age\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"e", " ", "=", " ", 
   RowBox[{"agent", "[", "\"\<energy\>\"", "]"}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.9858892410847187`*^9, 3.985889267882303*^9}, 
   3.9858899104177036`*^9, {3.985889996097788*^9, 3.9858900195669117`*^9}, {
   3.9858900551017895`*^9, 3.9858900558608418`*^9}, {3.985890123749712*^9, 
   3.985890142678852*^9}, {3.988568237654188*^9, 3.9885682603834667`*^9}, {
   3.988568383836918*^9, 3.988568386161585*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"bfe1b53e-52ed-7441-9033-cd116b559004"],

Cell[TextData[{
 "Then, we convert each agent\[CloseCurlyQuote]s energy into a fraction \
between 0 to 1, which controls both the length and the color of the energy \
bar. The variable ",
 StyleBox["percent",
  FontWeight->"Bold"],
 " creates the number that is displayed in the energy bar.",
 " "
}], "Text",
 CellChangeTimes->{{3.9885682961425133`*^9, 
  3.988568371213106*^9}},ExpressionUUID->"044cf5b0-e917-794b-b8ae-\
10876e038705"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"frac", " ", "=", " ", 
   RowBox[{"Clip", "[", 
    RowBox[{
     RowBox[{"e", "/", 
      RowBox[{"params", "[", "\"\<maxEnergy\>\"", "]"}]}], ",", " ", 
