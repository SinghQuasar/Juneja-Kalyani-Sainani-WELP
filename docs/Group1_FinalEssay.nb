               RowBox[{
                RowBox[{"barLeft", " ", "+", " ", "barW"}], ",", " ", 
                RowBox[{"barBottom", " ", "+", " ", "barH"}]}], "}"}]}], 
             "]"}], ",", 
            RowBox[{"energyColor", "[", "frac", "]"}], ",", "\n", " ", 
            RowBox[{"Rectangle", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"barLeft", ",", " ", "barBottom"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"barLeft", " ", "+", " ", 
                 RowBox[{"barW", " ", "frac"}]}], ",", " ", 
                RowBox[{"barBottom", " ", "+", " ", "barH"}]}], "}"}]}], 
             "]"}], ",", " ", 
            RowBox[{"Text", "[", 
