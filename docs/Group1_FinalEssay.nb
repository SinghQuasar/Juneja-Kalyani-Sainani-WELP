          RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
         RowBox[{"barH", "/", "2"}]}]}], ";"}], "\n", "\n", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"EdgeForm", "[", 
         RowBox[{"Directive", "[", 
          RowBox[{"White", ",", " ", 
           RowBox[{"Thickness", "[", "0.0015", "]"}]}], "]"}], "]"}], ",", 
        "fillColor", ",", 
        RowBox[{"Disk", "[", 
         RowBox[{"pos", ",", " ", "agentR"}], "]"}], ",", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{"ToString", "[", 
             RowBox[{"Round", "[", "age", "]"}], "]"}], ",", 
            RowBox[{"Max", "[", 
             RowBox[{"7", ",", " ", 
              RowBox[{"Round", "[", 
               RowBox[{"0.018", " ", 
                RowBox[{"params", "[", "\"\<imageSize\>\"", "]"}]}], "]"}]}], 
             "]"}], ",", "txtColor", ",", "Bold"}], "]"}], ",", "pos"}], 
         "]"}], ",", "\n", " ", 
        RowBox[{"If", "[", 
         RowBox[{"showEnergyBars", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"EdgeForm", "[", 
