Cell[TextData[{
 "The toolbox includes functions to analyze this carrying capacity and \
logistic growth behavior. The ",
 Cell[BoxData[
  RowBox[{"showLogsitic", "[", "]"}]], "InlineCode",ExpressionUUID->
  "f00ca919-a385-d646-91d8-fa08b2f60b94"],
 " function below shows this population curve fitted to the equation ",
 StyleBox["P(t) = ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   FractionBox["K", 
    RowBox[{"1", " ", 
     StyleBox["+",
      FontSlant->"Plain"], " ", 
     SuperscriptBox["Ae", 
      RowBox[{"-", "rt"}]]}]], TraditionalForm]],
  FormatType->TraditionalForm,
  FontSlant->"Italic",ExpressionUUID->"a2ce8edc-91bb-9b46-b50c-ae9fd104f82a"],
 ", where ",
 StyleBox["K",
  FontSlant->"Italic"],
 " is the carrying capacity, ",
 StyleBox["r",
  FontSlant->"Italic"],
 " is the intrinsic growth rate, and ",
 StyleBox["A",
  FontSlant->"Italic"],
 " is an amplitude constant that contains information about the initial \
population among other things. ",
 Cell[BoxData[
  RowBox[{"showLogistic", "[", "]"}]], "InlineCode",ExpressionUUID->
  "fe046b9f-a0fe-d04d-8684-5e1362326bc9"],
 " employs Wolfram\[CloseCurlyQuote]s ",
 Cell[BoxData[
  RowBox[{"NonlinearModelFit", "[", "]"}]], "InlineCode",ExpressionUUID->
  "173f0d7a-4665-7c4f-b05a-a8d037e87fc0"],
 " for its least-squares regression."
}], "Text",
 CellChangeTimes->{{3.988759269254959*^9, 3.988759296875124*^9}, {
  3.9887593907715797`*^9, 3.9887594877426777`*^9}, {3.9887595228006115`*^9, 
  3.988759555930582*^9}},ExpressionUUID->"e0905d48-8f1b-a045-8468-\
b9693b2fdb01"],

Cell[BoxData[
 RowBox[{
  RowBox[{"showLogistic", "[", "simulation_", "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "agentCounts", ",", " ", "times", ",", " ", "series", ",", " ", "fit"}], 
     "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"agentCounts", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "@", 
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "&"}], " ", "/@", " ", 
       "simulation"}]}], ";", "\n", "\t", 
     RowBox[{"times", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "4", "]"}], "]"}], "&"}], " ", "/@", " ", 
       "simulation"}]}], ";", "\n", "\t", 
     RowBox[{"series", " ", "=", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"times", ",", " ", "agentCounts"}], "}"}], "]"}]}], ";", "\n",
      "\t", "\n", "\t", 
     RowBox[{"fit", " ", "=", " ", 
      RowBox[{"NonlinearModelFit", "[", "\n", "\t    ", 
       RowBox[{"series", ",", "\n", "\t    ", 
        RowBox[{"K", "/", 
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", 
           RowBox[{"A", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "r"}], " ", "t"}], "]"}]}]}], ")"}]}], ",", "\n", 
        "\t    ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"K", ",", " ", "35"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"A", ",", " ", "10"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "1"}], "}"}]}], "}"}], ",", "\n", "\t    ", 
        "t"}], "]"}]}], ";", "\n", "\t   ", "\n", "\t", 
     RowBox[{"Show", "[", "\n", "\t\t", 
      RowBox[{
       RowBox[{"ListLinePlot", "[", "series", "]"}], ",", "\n", "\t\t", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"fit", "[", "x", "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", 
           RowBox[{"times", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
           RowBox[{"times", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}]}], "}"}]}], "]"}]}], "\n", "\t",
       "]"}]}]}], "\n", "]"}]}]], "Code",
 CellChangeTimes->{3.9887594990677834`*^9},
 CellLabel->"In[29]:=",ExpressionUUID->"fdd04210-3656-1a4d-9b74-721a9753323a"],

Cell["\<\
Calling the function on our simulation, we can see the curve fitted...\
\>", "Text",
 CellChangeTimes->{{3.988759505340643*^9, 3.9887595203316746`*^9}, {
  3.9887595631847515`*^9, 
  3.988759564581972*^9}},ExpressionUUID->"3a105c3d-c942-1d4d-9909-\
16316f7cd6df"],

