   RowBox[{"ageColor", "[", "age", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"txtColor", " ", "=", " ", 
   RowBox[{"ageTextColor", "[", "age", "]"}]}], ";"}]}], "Code",
 Evaluatable->False,
 CellChangeTimes->{{3.9885683907016373`*^9, 3.9885684078579807`*^9}, {
