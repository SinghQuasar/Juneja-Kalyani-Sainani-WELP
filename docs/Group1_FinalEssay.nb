Cell["\<\
For the purposes of explaining our visualization process, important functions \
were broken up into separate code cells. Please run the following code cell, \
which is just those in the above section combined properly, to define and \
enable our toolbox\[CloseCurlyQuote]s visualization functionality.\
\>", "Text",
 CellChangeTimes->{{3.988760481254915*^9, 
  3.988760535992628*^9}},ExpressionUUID->"2151ed75-9dda-0e41-98ac-\
bb9b5d3f82b2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ageColor", "[", 
     RowBox[{"age_", ",", " ", "params_"}], "]"}], " ", ":=", " ", "\n", "  ", 
    RowBox[{"Blend", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "Green", ",", " ", "Yellow", ",", " ", "Orange", ",", " ", "Red"}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{"Clip", "[", 
       RowBox[{
        RowBox[{"age", "/", 
         RowBox[{"(", 
          RowBox[{"0.3", " ", 
           RowBox[{"params", "[", "\"\<lifespan\>\"", "]"}]}], ")"}]}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}]}], "\n", "  ", "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ageTextColor", "[", 
     RowBox[{"age_", ",", " ", "params_"}], "]"}], " ", ":=", " ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"age", " ", "<", " ", 
       RowBox[{"0.6", " ", 
        RowBox[{"params", "[", "\"\<lifespan\>\"", "]"}]}]}], ",", " ", 
      "Black", ",", " ", "White"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"energyColor", "[", "frac_", "]"}], " ", ":=", " ", 
    RowBox[{"Blend", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Red", ",", " ", "Yellow", ",", " ", "Green"}], "}"}], ",", 
      " ", 
      RowBox[{"Clip", "[", 
       RowBox[{"frac", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}]}], "]"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"otherAgentPositions", "[", 
     RowBox[{"pos_", ",", " ", "agents_"}], "]"}], " ", ":=", " ", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{
      RowBox[{"Lookup", "[", 
       RowBox[{"agents", ",", " ", "\"\<pos\>\""}], "]"}], ",", " ", "pos"}], 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"chooseBarCenter", "[", 
     RowBox[{
     "pos_", ",", " ", "others_", ",", " ", "min_", ",", " ", "max_", ",", 
      " ", "barW_", ",", " ", "barH_", ",", " ", "barGap_"}], "]"}], " ", ":=",
     " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"candidates", ",", " ", "scores"}], "}"}], ",", "\n", "\n", 
      "  ", 
      RowBox[{
       RowBox[{"candidates", " ", "=", " ", 
        RowBox[{"{", "\n", "    ", 
         RowBox[{
          RowBox[{"pos", " ", "+", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "barGap"}], "}"}]}], ",", "\n", "    ", 
          RowBox[{"pos", " ", "+", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", " ", 
             RowBox[{"-", "barGap"}]}], "}"}]}], ",", "\n", "    ", 
          RowBox[{"pos", " ", "+", " ", 
           RowBox[{"{", 
            RowBox[{"barGap", ",", " ", "0"}], "}"}]}], ",", "\n", "    ", 
          RowBox[{"pos", " ", "+", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "barGap"}], ",", " ", "0"}], "}"}]}]}], "\n", "  ", 
         "}"}]}], ";", "\n", "\n", "  ", 
       RowBox[{"candidates", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"min", " ", "+", " ", 
                  RowBox[{"barW", "/", "2"}]}], ",", " ", 
                 RowBox[{"max", " ", "-", " ", 
                  RowBox[{"barW", "/", "2"}]}]}], "}"}]}], "]"}], ",", " ", 
             "\n", "                 ", 
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"min", " ", "+", " ", 
                  RowBox[{"barH", "/", "2"}]}], ",", " ", 
                 RowBox[{"max", " ", "-", " ", 
                  RowBox[{"barH", "/", "2"}]}]}], "}"}]}], "]"}]}], "}"}], 
           " ", "&"}], ")"}], " ", "/@", " ", "candidates"}]}], ";", "\n", 
