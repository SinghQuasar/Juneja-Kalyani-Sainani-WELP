(* ::Package:: *)

SetDirectory[NotebookDirectory[]];
Needs["jksABM`"]   
                
reproductionEnergyCostIV = Table[i, {i, 1.0, 4.0, 0.5}];

simulations = ImportSim["reproductionEnergyCostIV"];


meanDeathAgeByReproduction[simulation_] := Module[
  {nStates, lastSeen, reproducerSet, deadAges, repAges, nonRepAges},
  nStates = Length[simulation];
  
  lastSeen = <||>;
  Do[
    ((lastSeen[#["id"]] = {s, #["age"]}) &) /@ simulation[[s]]["agents"],
    {s, nStates}
  ];

  reproducerSet = Association[
    (# -> True) & /@ DeleteCases[
      Union @ Flatten @ Table[
        Lookup[simulation[[s]]["agents"], "parents"], {s, nStates}],
      -1
    ]
  ];

  deadAges = Last /@ Select[lastSeen, First[#] < nStates &];

  repAges = Values @ KeySelect[deadAges,   TrueQ @ reproducerSet[#] &];
  nonRepAges = Values @ KeySelect[deadAges, ! TrueQ @ reproducerSet[#] &];

  {
    If[repAges === {}, Missing["NoData"], Mean[repAges]],
    If[nonRepAges === {}, Missing["NoData"], Mean[nonRepAges]]
  }
]

offspringCountVsDeathAge[simulation_] := Module[
  {nStates, lastSeen, idToParents, offspringCount, deadAges},
  nStates = Length[simulation];

  lastSeen = <||>; idToParents = <||>;
  Do[
    Function[a,
      lastSeen[a["id"]]    = {s, a["age"]};
      idToParents[a["id"]] = a["parents"];
    ] /@ simulation[[s]]["agents"],
    {s, nStates}
  ];

  offspringCount = Counts[DeleteCases[Flatten[Values[idToParents]], -1]];

  deadAges = Last /@ Select[lastSeen, First[#] < nStates &];

  KeyValueMap[
    {offspringCount[#1], #2} &,
    KeySelect[deadAges, KeyExistsQ[offspringCount, #] &]
  ]
]


stats = meanDeathAgeByReproduction /@ simulations;

repData = DeleteCases[
  Transpose[{reproductionEnergyCostIV, stats[[All, 1]]}], {_, _Missing}];
nonRepData = DeleteCases[
  Transpose[{reproductionEnergyCostIV, stats[[All, 2]]}], {_, _Missing}];

ListLinePlot[
  {repData, nonRepData},
  PlotLegends -> {"Reproducers", "Non-reproducers"},
  AxesLabel -> {"Reproduction Energy Cost", "Mean Age at Death"},
  PlotLabel -> "Death Age vs. Cost of Reproduction",
  PlotMarkers -> Automatic,
  GridLines -> Automatic
]



